---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import WhatsApp from "../components/WhatsApp.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /* Mensaje precargado del botón flotante. La landing del Método INTEGRA
     lo cambia para que el chat abra diciendo de dónde viene la consulta. */
  waMensaje?: string;
  waEtiqueta?: string;
  /* Páginas que se comparten por enlace directo y no son contenido del
     sitio — las cotizaciones para un cliente concreto, por ejemplo — se
     marcan con `noindex` para que no aparezcan en buscadores. */
  noindex?: boolean;
}

const {
  title = `${site.nombre} — ${site.tagline}`,
  description = site.seoDescription,
  waMensaje,
  waEtiqueta,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <!-- Subí una imagen a /public/images/og/og.jpg para las previsualizaciones -->
    <meta property="og:image" content="/images/og/og.jpg" />

    <!-- Identidad del sitio en pestañas, favoritos y accesos directos.
         El nombre del archivo tiene espacios, así que va codificado (%20).
         El `?v=` es a propósito: los navegadores cachean el favicon con
         mucha insistencia y sin cambiarlo seguirían mostrando el viejo. -->
    <link rel="icon" type="image/png" href="/images/logos/logo%20v3%20-%20transparente.png?v=4" />
    <link rel="apple-touch-icon" href="/images/logos/logo%20v3%20-%20transparente.png?v=4" />

    <!-- Tipografía de marca: Google Sans Flex (variable) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&family=Sora:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <!-- Navegación instantánea entre páginas (sin recarga completa) -->
    <ViewTransitions />
  </head>
  <body>
    <slot />
    <!-- Botón flotante en todas las páginas -->
    <WhatsApp mensaje={waMensaje} etiqueta={waEtiqueta} />
  </body>
</html>
