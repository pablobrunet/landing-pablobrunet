---
/* =====================================================================
   04 · CONDICIONES ECONÓMICAS
   ---------------------------------------------------------------------
   Mismo patrón que ElectricidadEconomicas.astro: concepto a la izquierda,
   importe en banda oscura a la derecha.

   ⚠️ UNA SOLA CONDICIÓN. No hay viáticos —el evento es cerca— ni validez
   —la charla es la semana que viene—, así que la forma de pago va como
   franja al pie del importe y no como grilla de tarjetas: una tarjeta
   sola en una grilla de tres se lee como si faltaran las otras dos.
   ===================================================================== */
import Icon from "../Icon.astro";
import { speedAgro } from "../../data/speedAgro";
const { economicas } = speedAgro;
---

<section class="section i-claro eco" id={economicas.id} aria-label={economicas.titulo}>
  <div class="eco__fondo" aria-hidden="true"></div>

  <div class="container eco__inner">
    <header class="i-head i-reveal">
      <span class="i-eyebrow">{economicas.eyebrow}</span>
      <h2 class="t-h2">{economicas.titulo}</h2>
    </header>

    <article class="carta i-reveal">
      <div class="carta__concepto">
        <span class="carta__et">{economicas.conceptoTitulo}</span>
        <p class="carta__p">{economicas.concepto}</p>
        <ul class="carta__incluye">
          {
            economicas.incluye.map((i) => (
              <li>
                <span class="carta__tick" aria-hidden="true">
                  <Icon name="check" size={13} />
                </span>
                <span>{i}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="carta__importe">
        <span class="carta__importe-t">{economicas.importeTitulo}</span>
        <span class:list={["carta__v", !economicas.importe && "carta__v--pendiente"]}>
          {economicas.importe || economicas.pendiente}
        </span>
        <span class="carta__nota">{economicas.monedaNota}</span>
      </div>
    </article>

    <aside class="pago i-reveal">
      <span class="pago__ico" aria-hidden="true">
        <Icon name={economicas.pago.icono} size={18} />
      </span>
      <div>
        <h3 class="pago__t">{economicas.pago.titulo}</h3>
        <p class="pago__p">{economicas.pago.texto}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .eco {
    position: relative;
    overflow: hidden;
  }
  .eco__fondo {
    position: absolute;
    top: -16rem;
    left: -22rem;
    width: 56rem;
    height: 56rem;
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(circle, transparent 58%, rgba(30, 92, 242, 0.05) 58.4%, transparent 59%),
      radial-gradient(circle, transparent 44%, rgba(30, 92, 242, 0.05) 44.4%, transparent 45%),
      radial-gradient(circle, transparent 30%, rgba(30, 92, 242, 0.05) 30.4%, transparent 31%);
  }
  .eco__inner {
    position: relative;
  }

  .carta {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--borde);
    box-shadow: var(--shadow);
  }
  .carta__concepto {
    padding: clamp(1.5rem, 3.5vw, 2.1rem);
  }
  .carta__et {
    display: block;
    margin-bottom: 0.7rem;
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--azul-pizarra);
  }
  .carta__p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--azul-petroleo);
  }
  .carta__incluye {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.15rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--borde);
  }
  .carta__incluye li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--azul-pizarra);
  }
  .carta__tick {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 0.15rem;
    border-radius: 50%;
    background: rgba(30, 92, 242, 0.1);
    color: var(--verde-resalte);
  }

  .carta__importe {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 3.5vw, 2.1rem);
    background: var(--i-noche);
    color: #fff;
  }
  .carta__importe-t {
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--i-celeste);
  }
  .carta__v {
    margin-top: 0.5rem;
    font-family: var(--font-title);
    font-weight: var(--w-display);
    font-size: clamp(1.85rem, 1.4rem + 1.9vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .carta__v--pendiente {
    font-size: 1.15rem;
    color: var(--i-celeste);
  }
  .carta__nota {
    margin-top: 0.6rem;
    font-size: 0.8125rem;
    color: rgba(220, 230, 246, 0.6);
  }

  /* ---- Forma de pago ----
     Franja al costado, no tarjeta: es la única condición del importe y
     se lee en el mismo movimiento que el número de arriba. */
  .pago {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: 1.15rem;
    padding: 1.15rem 1.35rem;
    border-radius: var(--radius);
    border-left: 4px solid var(--i-azul-600);
    background: rgba(30, 92, 242, 0.06);
  }
  .pago__ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: #fff;
    border: 1px solid var(--borde);
    color: var(--i-azul-600);
  }
  .pago__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--azul-petroleo);
    margin-bottom: 0.25rem;
  }
  .pago__p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--azul-pizarra);
  }

  @media (min-width: 940px) {
    .carta {
      grid-template-columns: 1.35fr 0.65fr;
    }
  }
</style>
