---
import Page from "../layouts/Page.astro";
import Icon from "../components/Icon.astro";
import Agenda from "../components/Agenda.astro";
import Redes from "../components/Redes.astro";
import RedLogo from "../components/RedLogo.astro";
import { site } from "../data/site";

/* Sin formulario: el contacto pasa por el calendario o por WhatsApp.
   Un formulario más agrega una vía que hay que revisar y responder a mano,
   y compite con la reserva directa, que es la acción que sí querés. */
const whatsapp = `https://wa.me/${site.whatsapp.numero}?text=${encodeURIComponent(
  site.whatsapp.mensaje
)}`;
---

<Page title={`Contacto — ${site.nombre}`} cta={false}>
  <!-- La agenda encabeza la página: sin cabecera intermedia, el visitante
       cae directo sobre el calendario. `principal` hace que su título sea
       el H1 de la página, que si no quedaría sin ninguno. -->
  <section class="section section--tint">
    <div class="container">
      <Agenda principal />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <header class="otras__head">
        <span class="eyebrow">Otra vía</span>
        <h2 class="t-h2">¿Preferís escribirme?</h2>
        <p class="t-subhead text-muted otras__sub">
          Si todavía no querés reservar una hora, mandame un mensaje y lo
          seguimos por ahí.
        </p>
      </header>

      <div class="otras">
        <a class="via via--wa" href={whatsapp} target="_blank" rel="noopener">
          <span class="via__i"><RedLogo name="whatsapp" size={24} /></span>
          <span class="via__txt">
            <strong>WhatsApp</strong>
            <span>Respuesta rápida, en el mismo día</span>
          </span>
          <Icon name="arrowUpRight" size={17} class="via__flecha" />
        </a>

        <a class="via" href={`mailto:${site.email}`}>
          <span class="via__i"><Icon name="mail" size={24} /></span>
          <span class="via__txt">
            <strong>{site.email}</strong>
            <span>Para propuestas más largas o material adjunto</span>
          </span>
          <Icon name="arrowUpRight" size={17} class="via__flecha" />
        </a>
      </div>

      <p class="otras__ubi">
        <Icon name="location" size={17} />
        {site.ubicacion}
      </p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <Redes />
    </div>
  </section>
</Page>

<style>
  .otras__head {
    max-width: 620px;
    margin-bottom: 2rem;
  }
  .otras__sub {
    margin-top: 0.75rem;
  }
  .otras {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .via {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.6rem;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    color: var(--azul-petroleo);
    transition: transform var(--transition), box-shadow var(--transition),
      border-color var(--transition);
  }
  .via:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--verde-acento);
  }
  .via__i {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 14px;
    background: rgba(0, 191, 114, 0.1);
    color: var(--verde-resalte);
  }
  /* WhatsApp con su verde propio: se reconoce al instante. */
  .via--wa .via__i {
    background: rgba(37, 211, 102, 0.14);
    color: #128c4a;
  }
  .via__txt {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
    flex-grow: 1;
  }
  .via__txt strong {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.02rem;
    overflow-wrap: anywhere;
  }
  .via__txt span {
    font-size: 0.88rem;
    color: var(--texto-suave);
  }
  .via__flecha {
    color: var(--borde-punteado);
    flex-shrink: 0;
    transition: color var(--transition), transform var(--transition);
  }
  .via:hover .via__flecha {
    color: var(--verde-resalte);
    transform: translate(2px, -2px);
  }
  .otras__ubi {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.5rem;
    font-size: var(--fs-caption);
    color: var(--texto-suave);
  }

  @media (min-width: 720px) {
    .otras {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
