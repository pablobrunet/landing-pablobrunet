---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import Frame from "../components/Frame.astro";
import Retrato from "../components/Retrato.astro";
import Icon from "../components/Icon.astro";
import CarruselFotos from "../components/CarruselFotos.astro";
import Prensa from "../components/Prensa.astro";
import Videos from "../components/Videos.astro";
import { site } from "../data/site";
import { sobreMi } from "../data/sobreMi";
import { televisionMeta, television, reformaVideos } from "../data/videos";
import { enriquecer, sinMarcas } from "../lib/texto";
const p = sobreMi.pagina;
---

<Page title={`Sobre mí — ${site.nombre}`}>
  <PageHero
    eyebrow="Sobre mí"
    title={site.nombre}
    subtitle={p.hero}
    crumbs={[{ label: "Sobre mí" }]}
  />

  <section class="section">
    <div class="container intro">
      <div class="intro__media">
        <Retrato src={sobreMi.img} alt={`Foto de ${site.nombre}`} hover={false} llenarAlto />
      </div>
      <div class="intro__copy">
        <h2 class="t-h2 intro__t">{p.bioTitulo}</h2>
        {
          /* set:html porque los párrafos llevan **negrita**. */
          p.bio.map((par) => <p class="text-muted intro__p" set:html={enriquecer(par)} />)
        }
      </div>
    </div>
  </section>

  <!-- OpenAI Partner Network: la insignia en grande y qué significa. -->
  <section class="section section--tint">
    <div class="container oai" id="openai">
      <div class="oai__insignia">
        <img src={p.openai.badge} alt={p.openai.badgeAlt} loading="lazy" />
      </div>
      <div class="oai__copy">
        <span class="eyebrow">{p.openai.eyebrow}</span>
        <h2 class="t-h2">{sinMarcas(p.openai.titulo)}</h2>
        {p.openai.significa.map((par) => <p class="text-muted oai__p">{par}</p>)}
      </div>
    </div>
  </section>

  <!-- Formación: el posgrado con foto, el resto al costado. -->
  <section class="section">
    <div class="container">
      <header class="bloque__head">
        <span class="eyebrow">{p.formacionMeta.eyebrow}</span>
        <h2 class="t-h2">{sinMarcas(p.formacionMeta.titulo)}</h2>
        <p class="t-subhead text-muted bloque__sub">{p.formacionMeta.subtitulo}</p>
      </header>

      <div class="form__grid">
        <figure class="form__destacada">
          <Frame
            src={p.formacionDestacada.img}
            label={p.formacionDestacada.imgLabel}
            alt={p.formacionDestacada.titulo}
            ratio={p.formacionDestacada.ratio}
          />
          <figcaption class="form__pie">
            <span class="form__inst">{p.formacionDestacada.institucion}</span>
            <strong class="form__t">{p.formacionDestacada.titulo}</strong>
            <span class="t-caption text-muted">{p.formacionDestacada.detalle}</span>
          </figcaption>
        </figure>

        <div class="form__lista">
          {
            p.formacionGrupos.map((g) => (
              <div class="form__grupo">
                <h3 class="form__sub">{g.subtitulo}</h3>
                <ul class="form__otras">
                  {g.items.map((f) => (
                    <li>
                      <Icon name="check" size={17} class="form__check" />
                      <span>
                        <strong>{f.titulo}</strong>
                        <span class="text-muted">{f.institucion}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Speaker: reemplazó la línea de tiempo vacía. -->
  <section class="section section--tint">
    <div class="container">
      <header class="bloque__head">
        <span class="eyebrow">{p.speaker.eyebrow}</span>
        <h2 class="t-h2">{sinMarcas(p.speaker.titulo)}</h2>
        {p.speaker.texto.map((par) => <p class="t-subhead text-muted bloque__sub">{par}</p>)}
      </header>
      <CarruselFotos fotos={p.speaker.fotos} etiqueta="Fotos de charlas y eventos" />
    </div>
  </section>

  <!-- Reforma constitucional de Santa Fe -->
  <section class="section">
    <div class="container">
      <header class="bloque__head">
        <span class="eyebrow">{p.reforma.eyebrow}</span>
        <h2 class="t-h2">{sinMarcas(p.reforma.titulo)}</h2>
      </header>
      <div class="reforma__copy">
        {p.reforma.texto.map((par) => <p class="text-muted">{par}</p>)}
      </div>
      <div class="reforma__fotos">
        {
          p.reforma.fotos.map((f) => (
            <Frame src={f.img} label={f.imgLabel} alt={f.alt} ratio={p.reforma.fotosRatio} />
          ))
        }
      </div>

      <div class="reforma__videos">
        <h3 class="t-h3 reforma__vt">Sesiones Constitucionales</h3>
        <Videos items={reformaVideos} />
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <Videos
        eyebrow={televisionMeta.eyebrow}
        titulo={televisionMeta.titulo}
        subtitulo={televisionMeta.subtitulo}
        items={television}
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Prensa />
    </div>
  </section>

</Page>

<style>
  .intro {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  .intro__media {
    max-width: 510px;
    width: 100%;
  }
  @media (min-width: 900px) {
    /* `stretch` hace que la columna de la foto tome el alto de la fila, que
       lo define el texto. Con `llenarAlto`, el retrato lo ocupa entero. */
    .intro {
      align-items: stretch;
    }
    .intro__media {
      max-width: none;
    }
  }
  .intro__t {
    margin-bottom: 1.25rem;
  }
  .intro__p + .intro__p {
    margin-top: 1rem;
  }
  /* La negrita de los párrafos pasa a color de texto principal: sobre el
     gris del cuerpo, el contraste es lo que la hace destacar. */
  .intro__copy :global(strong) {
    font-weight: var(--w-headline);
    color: var(--azul-petroleo);
  }

  /* ---- OpenAI: la insignia en grande ---- */
  .oai {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }
  .oai__insignia {
    display: grid;
    place-items: center;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .oai__insignia img {
    width: 100%;
    max-width: 420px;
    height: auto;
    object-fit: contain;
  }
  .oai__p {
    margin-top: 1rem;
  }

  /* ---- Encabezado compartido de los bloques ---- */
  .bloque__head {
    max-width: 660px;
    margin-bottom: 2rem;
  }
  .bloque__sub {
    margin-top: 0.75rem;
  }

  /* ---- Formación ---- */
  .form__grid {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: start;
  }
  .form__destacada {
    max-width: 400px;
  }
  .form__pie {
    display: grid;
    gap: 0.3rem;
    margin-top: 1rem;
  }
  .form__inst {
    font-family: var(--font-title);
    font-size: 0.78rem;
    font-weight: var(--w-headline);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--verde-resalte);
  }
  .form__t {
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: var(--w-headline);
    line-height: 1.35;
    color: var(--azul-petroleo);
  }
  .form__lista {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  .form__grupo {
    display: grid;
    gap: 1rem;
  }
  /* Rótulo del grupo: chico y en versalitas, no compite con los títulos. */
  .form__sub {
    font-family: var(--font-title);
    font-size: 0.78rem;
    font-weight: var(--w-headline);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--texto-suave);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--borde);
  }
  .form__otras {
    display: grid;
    gap: 1rem;
  }
  .form__otras li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .form__otras strong {
    display: block;
    font-weight: var(--w-headline);
    color: var(--azul-petroleo);
  }
  .form__otras span span {
    font-size: 0.9rem;
  }
  .form__check {
    color: var(--verde-resalte);
    flex-shrink: 0;
    margin-top: 4px;
  }
  /* ---- Reforma constitucional ---- */
  .reforma__copy {
    max-width: 68ch;
  }
  .reforma__copy p + p {
    margin-top: 1rem;
  }
  .reforma__fotos {
    display: grid;
    gap: 1rem;
    margin-top: 2.25rem;
    grid-template-columns: 1fr;
  }
  .reforma__videos {
    margin-top: 2.75rem;
  }
  .reforma__vt {
    margin-bottom: 1.1rem;
  }

  @media (min-width: 720px) {
    .reforma__fotos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 880px) {
    .oai {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .form__grid {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
  @media (min-width: 900px) {
    /* Más proporción para la foto: el max-width solo no la agranda. */
    .intro {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }
</style>
