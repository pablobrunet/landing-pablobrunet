# =====================================================================
# Formularios (newsletter, recursos y chequeo INTEGRA)
# ---------------------------------------------------------------------
# Copiá este archivo como `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.
#
# En Vercel: Settings -> Environment Variables, para Production y Preview.
#
# Cómo viaja un formulario:
#   navegador -> /api/lead o /api/chequeo (servidor de Vercel)
#             -> verifica el captcha con Cloudflare
#             -> llama a la función de Supabase con la clave secreta
# El navegador nunca habla con Supabase ni ve ninguna clave de la base.
# =====================================================================

# ---------------------------------------------------------------------
# Cloudflare Turnstile (captcha)
# Cloudflare -> Turnstile -> Add widget -> dominio pablobrunet.com
# (sumá también el dominio de los Preview de Vercel si querés probar ahí).
#
# Para `astro dev` usá las claves de prueba de Cloudflare, que siempre
# aprueban sin mostrar nada:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# ---------------------------------------------------------------------

# Clave del sitio. Es pública: va al navegador (por eso lleva PUBLIC_).
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# Clave secreta del widget. Sólo servidor.
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---------------------------------------------------------------------
# Supabase — SÓLO SERVIDOR (sin PUBLIC_, nunca llegan al navegador)
# ---------------------------------------------------------------------

# Supabase -> Project Settings -> Data API -> Project URL
# Sirve con o sin el /rest/v1 al final: el código lo normaliza.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API Keys -> Secret keys (sb_secret_…)
#
# ⚠️ Esta clave abre TODA la base, que es compartida con la plataforma
# INTEGRA. Sólo va en las variables de Vercel y en tu .env local. Nunca
# con el prefijo PUBLIC_, nunca en el código, nunca en n8n ni en un chat.
# Si se filtra: Supabase -> API Keys -> crear otra y borrar la vieja.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx


# =====================================================================
# Variables viejas que ya NO se usan
# ---------------------------------------------------------------------
# PUBLIC_SUPABASE_URL, PUBLIC_SUPABASE_PUBLISHABLE_KEY y
# PUBLIC_SUPABASE_ANON_KEY: hasta octubre de 2026 el navegador llamaba a
# Supabase directo con la clave pública. Una vez aplicada
# supabase/migracion-05-cerrar-anon.sql, borrarlas de Vercel.
# =====================================================================
