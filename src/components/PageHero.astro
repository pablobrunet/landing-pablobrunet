---
import Breadcrumbs from "./Breadcrumbs.astro";
import { resaltar, sinMarcas } from "../lib/texto";
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string; // admite *fragmento resaltado*
  subtitle?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, subtitle, crumbs = [] } = Astro.props;
const migas = crumbs.map((c) => ({ ...c, label: sinMarcas(c.label) }));
---

<section class="pagehero">
  <span class="pagehero__trama trama" aria-hidden="true"></span>
  <svg class="pagehero__lines" viewBox="0 0 800 260" fill="none" aria-hidden="true">
    <path d="M-20 205 C 220 205 265 105 490 105 S 780 60 860 60" />
    <circle cx="490" cy="105" r="4" />
  </svg>
  <div class="container pagehero__inner">
    {migas.length > 0 && <Breadcrumbs items={migas} />}
    {eyebrow && <span class="eyebrow pagehero__eyebrow">{eyebrow}</span>}
    <h1 class="t-h1" set:html={resaltar(title)} />
    {subtitle && <p class="t-subhead text-muted pagehero__sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .pagehero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(59, 163, 154, 0.08), transparent 55%),
      var(--gris-claro);
    border-bottom: 1px solid var(--borde);
  }
  .pagehero__trama {
    position: absolute;
    top: 0;
    right: 0;
    width: min(34%, 380px);
    height: 100%;
    opacity: 0.45;
    -webkit-mask-image: linear-gradient(215deg, #000, transparent 62%);
    mask-image: linear-gradient(215deg, #000, transparent 62%);
  }
  .pagehero__lines {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(65%, 760px);
    height: 100%;
    stroke: var(--verde-azulado);
    stroke-width: 1;
    opacity: 0.3;
    pointer-events: none;
  }
  .pagehero__lines circle {
    fill: var(--verde-acento);
  }
  .pagehero__inner {
    position: relative;
    max-width: 780px;
  }
  .pagehero__eyebrow {
    margin-top: 1rem;
  }
  .pagehero__sub {
    margin-top: 0.85rem;
  }
</style>
