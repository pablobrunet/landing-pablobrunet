---
import { site } from "../data/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
---

<header class="nav" id="inicio">
  <div class="container nav__inner">
    <Logo />

    <nav class="nav__links" aria-label="Principal">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="nav__actions">
      <ul class="nav__social">
        {
          site.redes.map((r) => (
            <li>
              <a href={r.href} aria-label={r.label} target="_blank" rel="noopener">
                <Icon name={r.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <a href={site.cta.href} class="btn btn--primary nav__cta">{site.cta.label}</a>
      <button class="nav__burger" aria-label="Abrir menú" aria-expanded="false" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menú mobile -->
  <div class="nav__mobile" data-mobile-menu hidden>
    <nav aria-label="Móvil">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={site.cta.href} class="btn btn--primary">{site.cta.label}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--borde);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 72px;
  }
  .nav__links {
    display: none;
    gap: 1.6rem;
  }
  .nav__links a {
    font-size: 0.95rem;
    font-weight: var(--w-subheadline);
    color: var(--azul-pizarra);
    transition: color var(--transition);
  }
  .nav__links a:hover {
    color: var(--verde-acento);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav__social {
    display: none;
    gap: 0.75rem;
  }
  .nav__social a {
    color: var(--azul-pizarra);
    transition: color var(--transition);
  }
  .nav__social a:hover {
    color: var(--verde-acento);
  }
  .nav__cta {
    display: none;
  }
  .nav__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--borde);
    border-radius: 10px;
    cursor: pointer;
  }
  .nav__burger span {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--azul-petroleo);
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }
  .nav__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav__mobile {
    border-top: 1px solid var(--borde);
    background: var(--blanco);
    padding: 1rem var(--gutter) 1.5rem;
  }
  .nav__mobile nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: var(--maxw);
    margin-inline: auto;
  }
  .nav__mobile a:not(.btn) {
    padding: 0.75rem 0.5rem;
    font-weight: var(--w-subheadline);
    color: var(--azul-pizarra);
    border-bottom: 1px solid var(--borde);
  }
  .nav__mobile .btn {
    margin-top: 0.75rem;
  }

  @media (min-width: 900px) {
    .nav__links,
    .nav__social {
      display: flex;
    }
    .nav__cta {
      display: inline-flex;
    }
    .nav__burger {
      display: none;
    }
    .nav__mobile {
      display: none !important;
    }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  burger?.addEventListener("click", () => {
    const open = burger.getAttribute("aria-expanded") === "true";
    burger.setAttribute("aria-expanded", String(!open));
    if (menu) menu.hidden = open;
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      burger?.setAttribute("aria-expanded", "false");
      if (menu) menu.hidden = true;
    })
  );
</script>
