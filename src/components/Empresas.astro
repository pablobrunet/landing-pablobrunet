---
/* =====================================================================
   EMPRESAS QUE CONFÍAN — bloque de la portada, debajo del hero.
   Mismo recorrido que el carrusel del perfil en /programa-ejecutivos
   (components/ejecutivos/EjePerfil.astro): etiqueta, título y tira.
   La pista se duplica y se desplaza -50%, así el loop no tiene costura.
   ===================================================================== */
import { empresasMeta, empresas } from "../data/empresas";
import { sinMarcas } from "../lib/texto";

/* color: logos con su color original, sin el gris por defecto.
   continuo: la tira nunca se frena ni responde al mouse (ni hover, ni clic, ni arrastre). */
interface Props {
  color?: boolean;
  continuo?: boolean;
}
const { color = false, continuo = false } = Astro.props;

const secuencia = [...empresas, ...empresas];
---

{
  empresas.length > 0 && (
<section class:list={["emp", { "emp--color": color, "emp--continuo": continuo }]} aria-label={empresasMeta.eyebrow}>
  <div class="container">
    <header class="emp__head">
      <span class="eyebrow">{empresasMeta.eyebrow}</span>
      <h2 class="t-h3">{sinMarcas(empresasMeta.titulo)}</h2>
    </header>
  </div>

  <div class="emp__marquee">
    <ul class="emp__track">
      {
        secuencia.map((e, i) => (
          <li class="emp__item" aria-hidden={i >= empresas.length ? "true" : undefined}>
            {e.img ? (
              <img src={e.img} alt={e.nombre} title={e.nombre} loading="lazy" decoding="async" />
            ) : (
              <span class="emp__nombre">{e.nombre}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
  )
}

<style>
  .emp {
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
    background: var(--gris-claro);
    border-block: 1px solid var(--borde);
  }
  .emp__head {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 2rem;
  }
  .emp__head .eyebrow {
    margin-bottom: 0.6rem;
  }

  .emp__marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .emp__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    width: max-content;
    animation: emp-scroll 60s linear infinite;
  }
  .emp__marquee:hover .emp__track {
    animation-play-state: paused;
  }
  .emp--continuo .emp__marquee {
    pointer-events: none;
    user-select: none;
  }
  .emp--continuo .emp__marquee:hover .emp__track {
    animation-play-state: running;
  }
  @keyframes emp-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .emp__item {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    height: 76px;
  }
  /* Gris por defecto, color al pasar el mouse: unifica logos de estilos
     muy distintos y evita que la franja se vuelva un arcoíris.
     Alto fijo (no max-height): varios SVG traen solo viewBox, sin tamaño
     propio, y con max-height colapsan a 0 de ancho. */
  .emp__item img {
    height: 52px;
    max-width: 240px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter var(--transition), opacity var(--transition);
  }
  .emp__item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  .emp--color .emp__item img {
    filter: none;
    opacity: 1;
  }
  /* Sin logo todavía: el nombre en texto, con el mismo gris y hover. */
  .emp__nombre {
    font-family: var(--font-title);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--azul-pizarra);
    opacity: 0.7;
    transition: opacity var(--transition);
  }
  .emp__item:hover .emp__nombre {
    opacity: 1;
  }

  @media (max-width: 640px) {
    .emp__item {
      height: 60px;
    }
    .emp__item img {
      height: 40px;
      max-width: 180px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .emp__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      padding-inline: var(--gutter);
    }
    .emp__item[aria-hidden="true"] {
      display: none;
    }
    .emp__marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
