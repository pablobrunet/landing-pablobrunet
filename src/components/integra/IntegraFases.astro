---
/* =====================================================================
   EL MÉTODO — las siete fases INTEGRA
   ---------------------------------------------------------------------
   Selector de fases: las siete iniciales forman I·N·T·E·G·R·A y debajo
   hay UN solo panel que cambia de contenido según la letra elegida.

   POR QUÉ ASÍ. Antes eran siete acordeones apilados y las letras eran
   atajos que hacían scroll hasta el que correspondía. Eso obligaba a
   bajar para leer y volver a subir para elegir otra fase: en mobile la
   página saltaba y se perdía el hilo. Con un panel único no hay salto —
   la letra y la explicación quedan siempre juntas en pantalla.

   SIN JAVASCRIPT. Son radios + labels: el estado vive en el :checked y
   el CSS muestra el panel que corresponde. Funciona apenas se pinta el
   HTML (misma lección que el menú hamburguesa), anda con teclado por las
   flechas —comportamiento nativo de un grupo de radios— y no depende de
   ningún bundle.

   ALTURA FIJA. Los siete paneles se apilan en la misma celda de grid, así
   que el bloque mide siempre lo mismo que el panel más largo y no cambia
   de alto al pasar de una letra a otra. Los que no están activos van con
   `visibility: hidden`, que además los saca del árbol de accesibilidad.
   ===================================================================== */
import { integra } from "../../data/integra";
const { metodo, anclas } = integra;

/* La posición de la letra activa mueve la flechita del panel. Se calcula
   acá para no repetir el número siete en el CSS. */
const cols = metodo.fases.length;
---

<section class="section i-hielo i-claro" id={anclas.metodo} aria-label="El método INTEGRA">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{metodo.eyebrow}</span>
      <h2 class="t-h2">{metodo.titulo}</h2>
      <p class="text-muted">{metodo.subtitulo}</p>
    </header>

    <div class="ft i-reveal" style={`--cols:${cols}`}>
      {/* Los radios van sueltos y antes de todo: el CSS necesita que sean
          hermanos de las letras y del panel para poder alcanzarlos con ~. */}
      {
        metodo.fases.map((f, i) => (
          <input
            class="ft__radio"
            type="radio"
            name="fase-integra"
            id={`fase-${f.letra}`}
            value={f.letra}
            checked={i === 0}
          />
        ))
      }

      <p class="ft__pista">{metodo.pista}</p>

      <div class="ft__letras" role="radiogroup" aria-label="Las siete fases del Método INTEGRA">
        {
          metodo.fases.map((f) => (
            <label class="letra" for={`fase-${f.letra}`}>
              <span class="letra__l">{f.letra}</span>
              <span class="letra__n">{f.nombre}</span>
            </label>
          ))
        }
      </div>

      <div class="ft__paneles">
        <span class="ft__flecha" aria-hidden="true"></span>
        {
          metodo.fases.map((f) => (
            <article class="panel" id={`panel-${f.letra}`}>
              <p class="panel__nombre">
                <span class="panel__inicial" aria-hidden="true">
                  {f.letra}
                </span>
                {f.nombre}
                {f.etiqueta && <em class="panel__tag">{f.etiqueta}</em>}
              </p>
              <p class="panel__pregunta">{f.pregunta}</p>
              <p class="panel__texto">{f.texto}</p>
              {f.regla && <p class="panel__regla">{f.regla}</p>}
              {f.destacado && <p class="panel__destacado">{f.destacado}</p>}
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ft {
    position: relative;
  }

  /* Los radios no se ven pero SÍ se enfocan: por eso no van con
     `display:none`, que los sacaría del orden de tabulación. */
  .ft__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .ft__pista {
    margin-bottom: 0.85rem;
    font-size: var(--fs-caption);
    color: var(--texto-suave);
    text-align: center;
  }

  /* ---------------------------- Las letras --------------------------- */
  .ft__letras {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: clamp(0.3rem, 1vw, 0.75rem);
  }
  .letra {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: clamp(0.55rem, 1.6vw, 1rem) 0.25rem;
    background: #fff;
    border: 1.5px solid var(--borde);
    border-radius: var(--radius);
    cursor: pointer;
    transition: transform var(--transition), border-color var(--transition),
      box-shadow var(--transition), background var(--transition);
  }
  .letra:hover {
    transform: translateY(-3px);
    border-color: var(--i-azul-500);
    box-shadow: var(--shadow-sm);
  }
  .letra__l {
    font-family: var(--font-title);
    font-weight: var(--w-display);
    font-size: clamp(1.5rem, 1rem + 2.2vw, 2.6rem);
    line-height: 1;
    background: var(--i-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .letra__n {
    font-size: 0.7rem;
    font-weight: var(--w-subheadline);
    color: var(--texto-suave);
    text-align: center;
    line-height: 1.2;
    /* En pantallas chicas el nombre completo no entra: manda la inicial,
       que además es lo que arma el acrónimo. */
    display: none;
  }

  /* ------------------------- El panel único -------------------------- */
  .ft__paneles {
    position: relative;
    display: grid;
    margin-top: 1.5rem;
    padding: clamp(1.35rem, 3.5vw, 2.25rem);
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  /* Los siete en la misma celda: el alto lo fija el más largo y ya no
     cambia al elegir otra letra. */
  .panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 240ms ease, transform 240ms ease, visibility 240ms;
  }
  .panel__nombre {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.5rem);
    color: var(--azul-petroleo);
  }
  .panel__inicial {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--i-grad);
    color: #fff;
    font-size: 1.3rem;
    font-weight: var(--w-display);
  }
  .panel__tag {
    font-family: var(--font-base);
    font-style: normal;
    font-size: 0.7rem;
    font-weight: var(--w-subheadline);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    background: rgba(30, 92, 242, 0.1);
    color: var(--verde-resalte);
  }
  .panel__pregunta {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.5;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
  }
  .panel__texto {
    margin-top: 0.7rem;
    font-size: 0.975rem;
    line-height: 1.7;
    color: var(--azul-pizarra);
  }
  .panel__regla {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
  }
  .panel__destacado {
    margin-top: 1rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--i-azul-500);
    background: rgba(76, 134, 245, 0.08);
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--azul-petroleo);
  }

  /* La flechita que conecta el panel con la letra elegida: es lo que da
     la sensación de que la explicación sale de esa letra. */
  .ft__flecha {
    position: absolute;
    top: -9px;
    width: 16px;
    height: 16px;
    margin-left: -8px;
    background: #fff;
    border-left: 1px solid var(--borde);
    border-top: 1px solid var(--borde);
    transform: rotate(45deg);
    border-radius: 3px 0 0 0;
    /* --col la fija el radio activo; la mitad de columna la centra. */
    left: calc((var(--col, 0) + 0.5) * (100% / var(--cols)));
    transition: left 260ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* --------------------- Qué prende cada radio ----------------------- */
  /* Letra activa */
  #fase-I:checked ~ .ft__letras .letra:nth-child(1),
  #fase-N:checked ~ .ft__letras .letra:nth-child(2),
  #fase-T:checked ~ .ft__letras .letra:nth-child(3),
  #fase-E:checked ~ .ft__letras .letra:nth-child(4),
  #fase-G:checked ~ .ft__letras .letra:nth-child(5),
  #fase-R:checked ~ .ft__letras .letra:nth-child(6),
  #fase-A:checked ~ .ft__letras .letra:nth-child(7) {
    border-color: var(--i-azul-600);
    background: linear-gradient(180deg, #fff, rgba(76, 134, 245, 0.12));
    box-shadow: var(--shadow-sm);
  }

  /* Foco visible por teclado: el radio está oculto, así que el anillo lo
     tiene que dibujar la letra. */
  #fase-I:focus-visible ~ .ft__letras .letra:nth-child(1),
  #fase-N:focus-visible ~ .ft__letras .letra:nth-child(2),
  #fase-T:focus-visible ~ .ft__letras .letra:nth-child(3),
  #fase-E:focus-visible ~ .ft__letras .letra:nth-child(4),
  #fase-G:focus-visible ~ .ft__letras .letra:nth-child(5),
  #fase-R:focus-visible ~ .ft__letras .letra:nth-child(6),
  #fase-A:focus-visible ~ .ft__letras .letra:nth-child(7) {
    outline: 3px solid var(--i-azul-600);
    outline-offset: 2px;
  }

  /* Panel activo */
  #fase-I:checked ~ .ft__paneles #panel-I,
  #fase-N:checked ~ .ft__paneles #panel-N,
  #fase-T:checked ~ .ft__paneles #panel-T,
  #fase-E:checked ~ .ft__paneles #panel-E,
  #fase-G:checked ~ .ft__paneles #panel-G,
  #fase-R:checked ~ .ft__paneles #panel-R,
  #fase-A:checked ~ .ft__paneles #panel-A {
    visibility: visible;
    opacity: 1;
    transform: none;
  }

  /* Posición de la flecha, una columna por letra */
  #fase-I:checked ~ .ft__paneles { --col: 0; }
  #fase-N:checked ~ .ft__paneles { --col: 1; }
  #fase-T:checked ~ .ft__paneles { --col: 2; }
  #fase-E:checked ~ .ft__paneles { --col: 3; }
  #fase-G:checked ~ .ft__paneles { --col: 4; }
  #fase-R:checked ~ .ft__paneles { --col: 5; }
  #fase-A:checked ~ .ft__paneles { --col: 6; }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .ft__flecha {
      transition: none;
    }
  }

  @media (min-width: 760px) {
    .letra__n {
      display: block;
    }
  }
</style>
