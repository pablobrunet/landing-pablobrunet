---
import { site } from "../data/site";
import Retrato from "./Retrato.astro";
import Icon from "./Icon.astro";
import { resaltar } from "../lib/texto";
const { hero } = site;
---

<section class="hero" aria-label="Presentación">
  <!-- Trama abajo a la izquierda, del lado del texto: nada de decoración
       cruzando por detrás del retrato. -->
  <span class="hero__trama trama" aria-hidden="true"></span>

  <div class="container hero__inner">
    <div class="hero__copy">
      <!-- Insignia + etiqueta: la imagen aporta el sello, el texto explica
           qué es. Enlaza a la sección donde está desarrollado. -->
      <a class="hero__cred" href={hero.badgeHref}>
        <img
          class="hero__cred-img"
          src={hero.badgeImg}
          alt={hero.badgeAlt}
          width="226"
          height="106"
        />
        <span class="hero__cred-txt">
          <strong>{hero.badgeTitulo}</strong>
          <span>{hero.badgeDetalle}</span>
        </span>
      </a>

      <h1 class="t-display hero__title" set:html={resaltar(hero.titulo)} />

      <div class="hero__sub">
        {hero.subtitulo.map((par) => <p class="t-subhead text-muted">{par}</p>)}
      </div>

      <div class="hero__disciplinas">
        {site.disciplinas.map((d) => <span class="chip">{d}</span>)}
      </div>

      <div class="hero__ctas">
        {
          hero.ctas.map((c) => (
            <a href={c.href} class:list={["btn", c.primary ? "btn--primary" : "btn--outline"]}>
              {c.label}
              {c.primary && <Icon name="arrow" size={18} />}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__media">
      <!-- Retrato recortado; es la única imagen del sitio sin hover. -->
      <Retrato src={hero.img} alt={`Retrato de ${site.nombre}`} hover={false} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(59, 163, 154, 0.08), transparent 55%),
      var(--blanco);
  }
  .hero__trama {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(30%, 340px);
    height: 46%;
    opacity: 0.45;
    -webkit-mask-image: linear-gradient(25deg, #000, transparent 62%);
    mask-image: linear-gradient(25deg, #000, transparent 62%);
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__copy {
    max-width: 620px;
  }
  /* ---- Insignia + etiqueta ----
     Se lee como una unidad: sello a la izquierda, qué significa a la derecha,
     separados por una regla fina. Tipografía chica y en gris: es una marca de
     credibilidad, no un titular, y no debe competir con el H1. */
  .hero__cred {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.5rem 0.9rem 0.5rem 0.5rem;
    border: 1px solid var(--borde);
    border-radius: var(--radius);
    background: var(--blanco);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .hero__cred:hover {
    border-color: var(--verde-acento);
    box-shadow: var(--shadow-sm);
  }
  /* Alto fijo y ancho automático: la insignia nunca se recorta ni se deforma. */
  .hero__cred-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }
  .hero__cred-txt {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-left: 0.85rem;
    border-left: 1px solid var(--borde);
    line-height: 1.3;
  }
  .hero__cred-txt strong {
    font-size: 0.82rem;
    font-weight: var(--w-headline);
    color: var(--azul-petroleo);
  }
  .hero__cred-txt span {
    font-size: 0.78rem;
    color: var(--texto-suave);
  }

  /* En pantallas chicas la etiqueta pasa debajo para no comprimir la insignia. */
  @media (max-width: 420px) {
    .hero__cred {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
      padding: 0.65rem 0.9rem;
    }
    .hero__cred-txt {
      padding-left: 0;
      border-left: 0;
    }
  }
  .hero__title {
    margin: 1.25rem 0 1rem;
    color: var(--azul-petroleo);
  }
  .hero__sub {
    max-width: 52ch;
  }
  /* El primer párrafo abre y va un punto más grande; el segundo desarrolla.
     Misma familia y color: la jerarquía la da solo el cuerpo. */
  .hero__sub p:first-child {
    font-size: 1.0625rem;
    color: var(--azul-pizarra);
  }
  .hero__sub p + p {
    margin-top: 0.85rem;
  }
  .hero__disciplinas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .chip {
    font-size: var(--fs-caption);
    font-weight: var(--w-subheadline);
    color: var(--azul-pizarra);
    background: var(--gris-claro);
    border: 1px solid var(--borde);
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }
  .hero__media {
    max-width: 570px;
    width: 100%;
    justify-self: center;
  }

  @media (min-width: 900px) {
    /* La columna manda sobre el max-width: para agrandar el retrato hay que
       darle más proporción de la grilla, no sólo subir el max-width. */
    .hero__inner {
      grid-template-columns: 0.92fr 1.08fr;
    }
    .hero__media {
      justify-self: end;
    }
  }
</style>
