---
/* =====================================================================
   ENFOQUE METODOLÓGICO — las cuatro dimensiones
   ---------------------------------------------------------------------
   Es el reencuadre central de la propuesta: adopción, no capacitación.
   Por eso va sobre fondo oscuro, que en este sistema marca los momentos
   donde se afirma algo, y las cuatro dimensiones van con el mismo peso
   visual — ninguna es "la principal".
   ===================================================================== */
import Icon from "../Icon.astro";
import { royjo } from "../../data/royjo";
const { enfoque } = royjo;
---

<section class="section i-oscuro enf" aria-label="Enfoque metodológico">
  <div class="enf__fondo" aria-hidden="true"><span class="trama"></span></div>

  <div class="container enf__inner">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{enfoque.eyebrow}</span>
      <h2 class="t-h2">
        {enfoque.titulo} <span class="enf__resalte">{enfoque.tituloResalte}</span>
      </h2>
      <p class="text-muted">{enfoque.subtitulo}</p>
    </header>

    <div class="enf__grid">
      {
        enfoque.dimensiones.map((d) => (
          <article class="enf__card i-reveal">
            <span class="enf__num" aria-hidden="true">{d.numero}</span>
            <span class="enf__icono" aria-hidden="true">
              <Icon name={d.icono} size={24} />
            </span>
            <h3 class="t-h3">{d.titulo}</h3>
            <p>{d.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .enf {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #0a1430 0%, #0d1b3d 55%, #0a1430 100%);
  }
  .enf__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .enf__fondo span {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    -webkit-mask-image: radial-gradient(70% 70% at 80% 15%, #000, transparent 70%);
    mask-image: radial-gradient(70% 70% at 80% 15%, #000, transparent 70%);
  }
  .enf__inner {
    position: relative;
  }
  /* Color plano y no el degradé de `.i-hl`: sobre el azul profundo el
     resalte tiene que leerse de un tono parejo (Celeste Suave, 9,9:1). */
  .enf__resalte {
    display: inline;
    color: var(--i-celeste);
  }

  .enf__grid {
    display: grid;
    gap: 1.15rem;
  }
  .enf__card {
    position: relative;
    padding: clamp(1.4rem, 3vw, 1.85rem);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }
  .enf__card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(169, 200, 245, 0.4);
    transform: translateY(-4px);
  }
  /* El número queda en la esquina, grande y muy bajo de opacidad: ordena
     la lectura sin pelearle al título. */
  .enf__num {
    position: absolute;
    top: clamp(0.9rem, 2vw, 1.25rem);
    right: clamp(1rem, 2.5vw, 1.5rem);
    font-family: var(--font-title);
    font-weight: var(--w-display);
    font-size: 2.4rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgba(169, 200, 245, 0.16);
  }
  .enf__icono {
    display: grid;
    place-items: center;
    width: 50px;
    height: 50px;
    margin-bottom: 1.1rem;
    border-radius: 14px;
    background: rgba(169, 200, 245, 0.13);
    border: 1px solid rgba(169, 200, 245, 0.24);
    color: var(--i-celeste);
  }
  .enf__card h3 {
    margin-bottom: 0.55rem;
  }
  .enf__card p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(220, 230, 246, 0.75);
  }

  @media (min-width: 640px) {
    .enf__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .enf__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
