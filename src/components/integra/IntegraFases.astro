---
/* =====================================================================
   EL MÉTODO — las siete fases INTEGRA
   ---------------------------------------------------------------------
   Selector de siete tarjetas (una por inicial) y, debajo, un panel único
   que cambia de contenido según la que esté elegida.

   El panel tiene cuatro zonas:
     · lado    — bloque azul con el nombre de la fase, su lema y el tramo
                 de días. Es lo que ancla visualmente el conjunto.
     · medio   — la pregunta que ordena la fase y su desarrollo.
     · claves  — las tres cosas concretas que deja la fase.
     · remate  — la línea de cierre, cruzando medio + claves.

   SIN JAVASCRIPT. Son radios + labels: el estado vive en el :checked y el
   CSS lo lee con `:has()`. Funciona apenas se pinta el HTML, anda con las
   flechas del teclado —comportamiento nativo de un grupo de radios— y no
   depende de ningún bundle.

   CADA RADIO VA ADENTRO DE SU TARJETA. No es un detalle: al hacer clic el
   navegador enfoca el input y, si está fuera de pantalla, lo trae a la
   vista. Con los siete apilados arriba del bloque, cada clic pegaba un
   salto hacia arriba y había que volver a bajar para ver el panel.

   ALTURA FIJA. Los siete paneles se apilan en la misma celda de grid, así
   que el bloque mide siempre lo que el más largo y no salta al cambiar de
   letra. Los inactivos van con `visibility: hidden`, que además los saca
   del árbol de accesibilidad. Adentro, las filas van `1fr auto` para que
   el bloque azul llegue hasta abajo en todas y ninguna se vea recortada.
   Los textos de las siete fases están emparejados en largo a propósito
   (data/integra.ts): si uno crece de más, estira el bloque para todas.
   ===================================================================== */
import Icon from "../Icon.astro";
import { integra } from "../../data/integra";
import { resaltar } from "../../lib/texto";
const { metodo, anclas } = integra;

const fases = metodo.fases;
const cols = fases.length;
const dosDigitos = (n: number) => String(n).padStart(2, "0");
---

<section class="section i-hielo i-claro fs" id={anclas.metodo} aria-label="El método INTEGRA">
  <div class="fs__fondo" aria-hidden="true"></div>

  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{metodo.eyebrow}</span>
      <h2 class="t-h2">
        {metodo.titulo} <span class="i-hl">{metodo.tituloResalte}</span>
      </h2>
      <p class="text-muted">{metodo.subtitulo}</p>
    </header>

    <div class="ft i-reveal" style={`--cols:${cols}`}>
      <div class="ft__riel" role="radiogroup" aria-label="Las siete fases del Método INTEGRA">
        {
          fases.map((f, i) => (
            <label class="paso">
              {/* El radio va DENTRO de su tarjeta, no suelto arriba de
                  todo. Al hacer clic el navegador enfoca el input, y si
                  ese input está fuera de pantalla lo trae a la vista: con
                  los siete apilados al principio del bloque, cada clic
                  pegaba un salto hacia arriba y había que volver a bajar
                  para ver el panel. Adentro de la tarjeta el foco ya está
                  donde el dedo tocó, así que no hay nada que desplazar. */}
              <input
                class="ft__radio"
                type="radio"
                name="fase-integra"
                id={`fase-${f.letra}`}
                value={f.letra}
                checked={i === 0}
              />
              <span class="paso__num" aria-hidden="true">
                {dosDigitos(i + 1)}
              </span>
              <span class="paso__letra" aria-hidden="true">
                {f.letra}
              </span>
              <span class="paso__icono" aria-hidden="true">
                <Icon name={f.icono} size={18} />
              </span>
              <span class="paso__nombre">{f.nombre}</span>
              <span class="paso__pico" aria-hidden="true" />
            </label>
          ))
        }
      </div>

      <div class="ft__paneles">
        {
          fases.map((f, i) => (
            <article class="ficha" id={`panel-${f.letra}`}>
              <div class="ficha__lado">
                <span class="ficha__orden">Fase {dosDigitos(i + 1)}</span>
                <p class="ficha__nombre">{f.nombre}</p>
                <p class="ficha__lema" set:html={resaltar(f.lema)} />
                <span class="ficha__dias">
                  <Icon name="calendario" size={17} />
                  {f.dias}
                </span>
              </div>

              <div class="ficha__medio">
                <h3 class="ficha__pregunta">{f.pregunta}</h3>
                <p class="ficha__texto">{f.texto}</p>
              </div>

              <ul class="ficha__claves">
                {f.claves.map((c) => (
                  <li>
                    <span class="clave__icono" aria-hidden="true">
                      <Icon name={c.icono} size={19} />
                    </span>
                    <span class="clave__t">{c.titulo}</span>
                  </li>
                ))}
              </ul>

              <p class="ficha__remate">
                <span class="ficha__remate-ico" aria-hidden="true">
                  <Icon name="estrella" size={16} />
                </span>
                {f.remate}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* La sección tiene que entrar de una en una pantalla de escritorio: si
     hay que bajar para leer el panel y volver a subir para cambiar de
     letra, se pierde el hilo. De ahí el aire recortado acá y en el
     encabezado, sumado a las claves sin bajada. */
  .fs {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
  }
  .fs .i-head {
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }
  .fs .i-head p {
    margin-top: 0.6rem;
    max-width: 46rem;
    margin-inline: auto;
  }
  /* Círculos concéntricos muy tenues sobre el margen derecho: dan
     profundidad sin competir con nada. */
  .fs__fondo {
    position: absolute;
    top: -14rem;
    right: -22rem;
    width: 58rem;
    height: 58rem;
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(circle, transparent 58%, rgba(30, 92, 242, 0.05) 58.4%, transparent 59%),
      radial-gradient(circle, transparent 44%, rgba(30, 92, 242, 0.05) 44.4%, transparent 45%),
      radial-gradient(circle, transparent 30%, rgba(30, 92, 242, 0.05) 30.4%, transparent 31%);
  }
  .fs > .container {
    position: relative;
  }

  .ft {
    position: relative;
  }
  /* Los radios no se ven pero SÍ se enfocan: por eso no van con
     `display:none`, que los sacaría del orden de tabulación. */
  .ft__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* =========================== EL SELECTOR ========================== */
  .ft__riel {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: clamp(0.3rem, 0.8vw, 0.75rem);
    align-items: stretch;
  }
  .paso {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: clamp(0.75rem, 1.6vw, 1.15rem) 0.3rem clamp(0.85rem, 1.8vw, 1.25rem);
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: 16px;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition),
      background var(--transition), border-color var(--transition);
  }
  .paso:hover {
    transform: translateY(-3px);
    border-color: var(--i-azul-500);
  }
  .paso__num {
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    color: var(--i-azul-500);
    transition: color var(--transition);
  }
  .paso__letra {
    font-family: var(--font-title);
    font-weight: var(--w-display);
    font-size: clamp(1.5rem, 0.9rem + 2.6vw, 3.1rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--i-azul-600);
    transition: color var(--transition);
  }
  .paso__icono {
    display: grid;
    place-items: center;
    width: clamp(1.9rem, 3.4vw, 2.5rem);
    height: clamp(1.9rem, 3.4vw, 2.5rem);
    border-radius: 50%;
    background: var(--i-hielo);
    color: var(--i-azul-600);
    transition: background var(--transition), color var(--transition);
  }
  .paso__nombre {
    max-width: 100%;
    font-size: 0.8rem;
    font-weight: var(--w-headline);
    line-height: 1.25;
    text-align: center;
    color: var(--azul-petroleo);
    text-wrap: balance;
    overflow-wrap: break-word;
    /* En pantallas chicas no entra: manda la inicial, que además es la
       que arma el acrónimo. */
    display: none;
  }
  /* Pico que baja de la tarjeta elegida hacia el panel. */
  .paso__pico {
    position: absolute;
    bottom: -9px;
    left: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 3px;
    background: var(--i-azul-700);
    transform: rotate(45deg) scale(0);
    transition: transform var(--transition);
  }

  .ft__pista {
    margin-top: 0.9rem;
    font-size: var(--fs-caption);
    color: var(--texto-suave);
    text-align: center;
  }

  /* ============================= EL PANEL =========================== */
  .ft__paneles {
    display: grid;
    margin-top: 1.15rem;
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  /* Las siete en la misma celda: el alto lo fija la más larga y ya no
     cambia al elegir otra letra. */
  .ficha {
    grid-area: 1 / 1;
    display: grid;
    visibility: hidden;
    opacity: 0;
    transition: opacity 220ms ease, visibility 220ms;
  }

  /* ---- Bloque azul ---- */
  .ficha__lado {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 3.2vw, 2.1rem);
    background: linear-gradient(155deg, var(--i-azul-700) 0%, var(--i-navy) 70%);
    color: #fff;
  }
  /* Arcos finos en la esquina inferior, como en el resto del sistema. */
  .ficha__lado::after {
    content: "";
    position: absolute;
    right: -9rem;
    bottom: -12rem;
    width: 26rem;
    height: 26rem;
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(circle, transparent 62%, rgba(169, 200, 245, 0.16) 62.5%, transparent 63.5%),
      radial-gradient(circle, transparent 48%, rgba(169, 200, 245, 0.14) 48.5%, transparent 49.5%),
      radial-gradient(circle, transparent 34%, rgba(169, 200, 245, 0.12) 34.5%, transparent 35.5%);
  }
  .ficha__lado > * {
    position: relative;
  }
  .ficha__orden {
    display: block;
    font-size: 0.72rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--i-celeste);
  }
  /* "Negociar prioridades" es la más larga: a 2,9rem no entraba en la
     columna y el `overflow: hidden` del bloque —que existe para recortar
     los arcos decorativos— se comía el final de la palabra. Con un tope
     más bajo y corte de palabra habilitado, ya no se puede cortar. */
  .ficha__nombre {
    margin-top: 0.5rem;
    font-family: var(--font-title);
    font-weight: var(--w-display);
    font-size: clamp(1.6rem, 1.05rem + 1.5vw, 2.35rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .ficha__lema {
    margin-top: 0.9rem;
    font-size: clamp(1rem, 0.94rem + 0.35vw, 1.15rem);
    line-height: 1.45;
    color: rgba(220, 230, 246, 0.9);
    max-width: 22rem;
  }
  /* Sobre el azul profundo, el resalte va en Celeste Suave (9,9:1). */
  .ficha__lema :global(.hl) {
    color: var(--i-celeste);
  }
  .ficha__dias {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(169, 200, 245, 0.3);
    font-size: 0.9rem;
    font-weight: var(--w-subheadline);
  }

  /* ---- Columna del medio ---- */
  .ficha__medio {
    padding: clamp(1.25rem, 3vw, 1.85rem);
  }
  .ficha__pregunta {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.25rem);
    line-height: 1.4;
    color: var(--azul-petroleo);
    text-wrap: balance;
  }
  /* Subrayado corto debajo de la pregunta, a modo de separador. */
  .ficha__pregunta::after {
    content: "";
    display: block;
    width: 42px;
    height: 3px;
    margin: 1.1rem 0 1.25rem;
    border-radius: 2px;
    background: var(--i-azul-600);
  }
  .ficha__texto {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--azul-pizarra);
  }

  /* ---- Las tres claves ----
     Sólo el título, sin bajada: son un resumen de un vistazo de lo que
     deja la fase. Con tres párrafos más, la sección no entraba en una
     pantalla y obligaba a bajar y volver a subir para cambiar de letra. */
  .ficha__claves {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 3vw, 1.85rem);
    padding-top: 0;
  }
  .ficha__claves li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--i-hielo);
  }
  .clave__icono {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: #fff;
    color: var(--i-azul-600);
  }
  .clave__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--azul-petroleo);
    text-wrap: balance;
  }

  /* ---- Remate ---- */
  .ficha__remate {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 clamp(1.25rem, 3vw, 1.85rem) clamp(1.25rem, 3vw, 1.85rem);
    padding: 0.9rem 1.15rem;
    border-radius: var(--radius);
    background: rgba(30, 92, 242, 0.06);
    font-size: 0.95rem;
    line-height: 1.5;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
  }
  .ficha__remate-ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--i-azul-600);
    color: #fff;
  }

  /* ==================== QUÉ PRENDE CADA RADIO =======================
     Con el radio adentro de la tarjeta ya no sirven los combinadores de
     hermano: se usa `:has()`. De paso queda mucho más corto — el estado
     de la tarjeta se lee de su propio input en lugar de repetir siete
     cadenas por cada propiedad. */
  .paso:has(.ft__radio:checked) {
    background: linear-gradient(165deg, var(--i-azul-600) 0%, var(--i-azul-800) 100%);
    border-color: transparent;
    box-shadow: 0 16px 34px rgba(23, 64, 143, 0.32);
  }
  .paso:has(.ft__radio:checked) .paso__num,
  .paso:has(.ft__radio:checked) .paso__letra,
  .paso:has(.ft__radio:checked) .paso__nombre {
    color: #fff;
  }
  .paso:has(.ft__radio:checked) .paso__icono {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }
  .paso:has(.ft__radio:checked) .paso__pico {
    transform: rotate(45deg) scale(1);
  }

  /* Foco por teclado: el radio no se ve, así que el anillo lo dibuja la
     tarjeta que lo contiene. */
  .paso:has(.ft__radio:focus-visible) {
    outline: 3px solid var(--i-azul-600);
    outline-offset: 3px;
  }

  /* Ficha activa: acá sí hace falta nombrar cada letra, porque la
     relación es entre un radio y el panel que le corresponde. */
  .ft:has(#fase-I:checked) #panel-I,
  .ft:has(#fase-N:checked) #panel-N,
  .ft:has(#fase-T:checked) #panel-T,
  .ft:has(#fase-E:checked) #panel-E,
  .ft:has(#fase-G:checked) #panel-G,
  .ft:has(#fase-R:checked) #panel-R,
  .ft:has(#fase-A:checked) #panel-A {
    visibility: visible;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .ficha,
    .paso,
    .paso__pico {
      transition: none;
    }
  }

  @media (min-width: 780px) {
    .paso__nombre {
      display: block;
    }
  }

  /* El panel pasa a tres columnas, con el bloque azul cruzando las dos
     filas y el remate cruzando medio + claves. */
  @media (min-width: 960px) {
    /* `1fr auto` en las filas es lo que hace que las siete fichas midan
       igual: la primera fila se come todo el alto sobrante —el del panel
       más largo, que es el que fija la altura del bloque— y el remate se
       queda en su alto natural, pegado abajo. Con `align-content: start`,
       las fichas más cortas dejaban el bloque azul a media altura y un
       hueco blanco debajo, que es lo que se veía como recortado. */
    .ficha {
      grid-template-columns: minmax(16.5rem, 0.95fr) 1.25fr 0.95fr;
      grid-template-rows: 1fr auto;
      grid-template-areas:
        "lado medio claves"
        "lado remate remate";
    }
    .ficha__lado {
      grid-area: lado;
    }
    .ficha__medio {
      grid-area: medio;
      border-right: 1px solid var(--borde);
    }
    .ficha__claves {
      grid-area: claves;
      padding-top: clamp(1.25rem, 3vw, 1.85rem);
    }
    .ficha__remate {
      grid-area: remate;
      margin-top: 0;
    }
  }
</style>
