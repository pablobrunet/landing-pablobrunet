---
/* =====================================================================
   EL PORTAL DE FORMACIÓN DEL PROGRAMA
   ---------------------------------------------------------------------
   Va después de "qué queda instalado": ahí se termina de prometer lo que
   la PyME se lleva al día 60, y acá se muestra lo único de toda la
   landing que YA existe y se puede ver funcionando.

   SIN TARJETAS. La versión anterior metía la captura y cuatro tarjetitas
   dentro de una tarjeta azul, y Pablo sentía que eran bloques adentro de
   bloques. Ahora la captura va suelta sobre el fondo hielo, con borde y
   sombra para despegarla (la interfaz es casi toda blanca). Debajo, las
   cuatro claves en columnas con un filete arriba, sin caja ni ícono.
   Tampoco llevan número: antes cada una tenía el suyo repetido sobre la
   captura, y Pablo lo sacó.

   LA CAPTURA VA A TODO EL ANCHO. En media columna la interfaz queda en
   45% de escala, o sea ilegible; a ancho completo se leen los títulos de
   los cursos y la barra de avance, que es exactamente lo que hay que
   ver.

   Sin CTA propio: la sección de arriba ya tiene su botón y el cierre
   también. Sumar un tercer botón en el mismo scroll diluía los dos que
   importan.
   ===================================================================== */
import { integra } from "../../data/integra";
const { portal } = integra;
/* La landing pasa sus propias claves (data/integra2.ts, que no nombra
   roles internos). Sin prop, las de data/integra.ts. */
interface Props {
  claves?: { titulo: string; texto: string }[];
}
const { claves = portal.claves } = Astro.props;
---

<section class="section i-hielo i-claro" id="portal" aria-label="El portal de formación del programa">
  <div class="container">
    <header class="pt-head i-reveal">
      <h2 class="t-h2">
        {portal.titulo}
        <span class="i-hl">{portal.tituloResalte}</span>
      </h2>
      <p class="text-muted">{portal.subtitulo}</p>
    </header>

    <figure class="pt-captura i-reveal">
      <div class="pt-captura__img">
        <img
          src={portal.captura}
          alt={portal.capturaAlt}
          width="1358"
          height="594"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <ul class="pt-claves i-reveal">
      {
        claves.map((c) => (
          <li>
            <h3>{c.titulo}</h3>
            <p>{c.texto}</p>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  /* ---- Encabezado: título a la izquierda, texto a la derecha ---- */
  .pt-head {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .pt-head h2 {
    font-size: clamp(1.6rem, 1.05rem + 2.1vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }
  .pt-head .i-hl {
    display: block;
  }
  .pt-head p {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 38rem;
  }

  /* ---- La captura, suelta sobre el fondo ---- */
  .pt-captura {
    margin: 0;
  }
  .pt-captura__img {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid var(--borde);
    background: #fff;
    box-shadow: 0 24px 60px rgba(13, 27, 61, 0.14), 0 2px 6px rgba(13, 27, 61, 0.06);
    transition: scale 420ms cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 420ms cubic-bezier(0.2, 0.7, 0.3, 1),
      border-color 420ms ease;
  }
  /* Al pasar el mouse la captura se agranda apenas (1,5%), con sombra
     más honda y borde en el azul de la página. Pablo no la quería subir. */
  .pt-captura__img:hover {
    scale: 1.015;
    border-color: rgba(30, 92, 242, 0.35);
    box-shadow: 0 36px 80px rgba(13, 27, 61, 0.2), 0 4px 10px rgba(13, 27, 61, 0.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .pt-captura__img {
      transition: box-shadow 200ms ease, border-color 200ms ease;
    }
    .pt-captura__img:hover {
      scale: none;
    }
  }
  .pt-captura__img img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: inherit;
  }

  /* ---- Las cuatro claves: columnas con filete, sin caja ---- */
  .pt-claves {
    display: grid;
    gap: 1.5rem 2rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
    list-style: none;
    padding: 0;
  }
  .pt-claves li {
    padding-top: 1rem;
    border-top: 2px solid var(--borde);
  }
  .pt-claves h3 {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1rem;
    line-height: 1.3;
    text-wrap: balance;
  }
  .pt-claves p {
    margin-top: 0.4rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--texto-suave);
  }

  @media (min-width: 620px) {
    .pt-claves {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .pt-head {
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
      align-items: end;
    }
  }
  @media (min-width: 1100px) {
    .pt-claves {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
