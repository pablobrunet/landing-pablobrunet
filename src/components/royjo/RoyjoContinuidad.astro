---
/* =====================================================================
   LO QUE PASA ENTRE UNA JORNADA Y LA OTRA
   ---------------------------------------------------------------------
   Esta sección prepara la decisión de la siguiente. Van dos bloques y el
   orden importa:

     · el ciclo entre jornadas — está en las DOS opciones
     · el portal con los videos — está en UNA sola

   Por eso el ciclo va primero y sin adorno, y el portal después, con su
   captura, su etiqueta "Sólo en la Opción 2" y una nota que aclara el
   punto: cuando alguien lee esto todavía no sabe qué es la Opción 2,
   porque las alternativas vienen en la sección siguiente.

   Acá vivía además un tercer bloque, "buenas prácticas internas", con la
   lista de lo que se identifica durante el programa. Se sacó a pedido de
   Pablo: enumerar lo que iba a aparecer competía con lo único que ya se
   puede mostrar, que es el portal.

   El ciclo se dibuja como una cadena de cinco pasos con flechas: es
   "Aprender → aplicar → compartir → mejorar → incorporar", y en lista
   vertical se perdía justamente el encadenamiento.

   LA CAPTURA DEL PORTAL VA A TODO EL ANCHO. Es el único elemento de
   prueba de la propuesta entera —el resto es lo que va a pasar, esto ya
   existe— y en media columna la interfaz quedaba en 45% de escala, o
   sea ilegible. A ancho completo se leen los títulos de los cursos y la
   barra de avance, que es exactamente lo que hay que ver.

   Va en marco de navegador (la barrita con tres puntos) para que se lea
   como una captura de producto y no como una imagen decorativa.
   ===================================================================== */
import Icon from "../Icon.astro";
import { royjo } from "../../data/royjo";
const { continuidad, anclas } = royjo;
const { ciclo, plataforma } = continuidad;
---

<section class="section i-claro cont" aria-label="Continuidad del aprendizaje">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{continuidad.eyebrow}</span>
      <h2 class="t-h2">
        {continuidad.titulo} <span class="i-hl">{continuidad.tituloResalte}</span>
      </h2>
      <p class="text-muted">{continuidad.subtitulo}</p>
    </header>

    {/* ---- El ciclo entre encuentros ---- */}
    <div class="ciclo i-reveal">
      <div class="ciclo__copy">
        <span class="ciclo__et">{ciclo.etiqueta}</span>
        <h3 class="ciclo__t">{ciclo.titulo}</h3>
        <p class="ciclo__p">{ciclo.texto}</p>
        <ul class="ciclo__detalle">
          {
            ciclo.detalle.map((d, i) => (
              <li>
                <span class="ciclo__n" aria-hidden="true">{i + 1}</span>
                <span>{d}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="ciclo__pasos">
        <span class="ciclo__pasos-t">{ciclo.pasosTitulo}</span>
        <ol class="ciclo__cadena">
          {
            ciclo.pasos.map((p) => (
              <li>
                <span class="ciclo__paso">{p}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    {/* ---- El portal, a todo el ancho ---- */}
    <article class="portal i-reveal">
      <header class="portal__head">
        <span class="portal__icono" aria-hidden="true">
          <Icon name={plataforma.icono} size={22} />
        </span>
        <span class="portal__et">{plataforma.etiqueta}</span>
        <h3 class="portal__t">{plataforma.titulo}</h3>
        <p class="portal__p">{plataforma.texto}</p>
        {/* La etiqueta "Sólo en la Opción 2" aparece antes de que las
            opciones existan en la página: esto la explica y da el salto. */}
        <p class="portal__nota">
          <span>{plataforma.nota}</span>
          <a href={`#${anclas.alternativas}`}>
            {plataforma.notaCta}
            <Icon name="arrow" size={15} />
          </a>
        </p>
      </header>

      <figure class="portal__captura">
        <div class="portal__marco">
          {/* Barrita de navegador: tres puntos y nada más. Con una barra
              de direcciones falsa habría que inventar una URL. */}
          <span class="portal__barra" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
          <img
            src={plataforma.captura}
            alt={plataforma.capturaAlt}
            width="1358"
            height="594"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>{plataforma.capturaPie}</figcaption>
      </figure>

      <ul class="portal__claves">
        {
          plataforma.claves.map((c) => (
            <li>
              <span class="portal__clave-ico" aria-hidden="true">
                <Icon name={c.icono} size={19} />
              </span>
              <p class="portal__clave-t">{c.titulo}</p>
              <p class="portal__clave-p">{c.texto}</p>
            </li>
          ))
        }
      </ul>

      <p class="portal__acceso">
        <Icon name="clock" size={16} />
        {plataforma.acceso}
      </p>

      <p class="portal__remate">{plataforma.remate}</p>
    </article>
  </div>
</section>

<style>
  /* ---- El ciclo ---- */
  .ciclo {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.25rem);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(140deg, var(--i-hielo-2), #fff 55%);
    border: 1px solid var(--borde);
    box-shadow: var(--shadow-sm);
  }
  .ciclo__et {
    display: inline-block;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--verde-resalte);
  }
  .ciclo__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.35rem);
    color: var(--azul-petroleo);
  }
  .ciclo__p {
    margin-top: 0.7rem;
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--azul-pizarra);
  }
  .ciclo__detalle {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.25rem;
  }
  .ciclo__detalle li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--azul-pizarra);
  }
  .ciclo__n {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(30, 92, 242, 0.1);
    color: var(--verde-resalte);
    font-size: 0.72rem;
    font-weight: var(--w-headline);
  }

  .ciclo__pasos {
    align-self: center;
  }
  .ciclo__pasos-t {
    display: block;
    margin-bottom: 0.9rem;
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--verde-resalte);
  }
  /* Cadena con flechas entre pasos. La flecha la dibuja el ::after del
     paso anterior, así que el último queda sin flecha sin necesidad de
     una clase aparte. */
  .ciclo__cadena {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    list-style: none;
  }
  .ciclo__cadena li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .ciclo__cadena li:not(:last-child)::after {
    content: "";
    width: 14px;
    height: 8px;
    background: var(--i-azul-500);
    /* Punta de flecha: un triángulo recortado sobre el bloque de color. */
    clip-path: polygon(0 40%, 60% 40%, 60% 0, 100% 50%, 60% 100%, 60% 60%, 0 60%);
  }
  .ciclo__paso {
    display: inline-block;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--i-grad);
    color: #fff;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 0.9rem;
    box-shadow: 0 8px 20px rgba(23, 64, 143, 0.22);
  }

  /* ======================= EL PORTAL ============================== */
  .portal {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    padding: clamp(1.4rem, 3vw, 2.1rem);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--borde);
    box-shadow: var(--shadow-sm);
  }
  .portal__head {
    max-width: 46rem;
    margin-bottom: clamp(1.35rem, 3vw, 1.85rem);
  }
  .portal__et {
    display: inline-block;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--verde-resalte);
  }
  .portal__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.45rem);
    line-height: 1.25;
    color: var(--azul-petroleo);
  }
  .portal__p {
    margin-top: 0.7rem;
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--azul-pizarra);
  }
  .portal__nota {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 1.1rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--i-azul-600);
    background: rgba(30, 92, 242, 0.06);
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--azul-petroleo);
  }
  .portal__nota a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
    white-space: nowrap;
  }
  .portal__nota a:hover {
    gap: 0.65rem;
  }
  .portal__nota a :global(svg) {
    transition: transform var(--transition);
  }

  /* ---- La captura, en marco de navegador ---- */
  .portal__captura {
    margin: 0;
  }
  .portal__marco {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--borde);
    background: var(--i-hielo);
    box-shadow: var(--shadow);
  }
  .portal__barra {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(180deg, #fff, var(--i-hielo));
    border-bottom: 1px solid var(--borde);
  }
  .portal__barra i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--borde-punteado);
  }
  .portal__marco img {
    display: block;
    width: 100%;
    height: auto;
  }
  .portal__captura figcaption {
    margin-top: 0.75rem;
    font-size: var(--fs-caption);
    color: var(--texto-suave);
    text-align: center;
  }

  /* ---- Las cuatro claves ---- */
  .portal__claves {
    display: grid;
    gap: 1rem;
    margin-top: clamp(1.35rem, 3vw, 1.85rem);
  }
  .portal__claves li {
    padding: 1.1rem 1.15rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(120deg, var(--i-hielo-2), #fff 55%);
    border: 1px solid var(--borde);
  }
  .portal__clave-ico {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 0.7rem;
    border-radius: 11px;
    background: rgba(30, 92, 242, 0.09);
    color: var(--i-azul-600);
  }
  .portal__clave-t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--azul-petroleo);
    text-wrap: balance;
  }
  .portal__clave-p {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--texto-suave);
  }

  .portal__icono {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 1rem;
    border-radius: 13px;
    background: var(--i-hielo);
    border: 1px solid var(--borde);
    color: var(--i-azul-600);
  }
  .portal__acceso {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(1.35rem, 3vw, 1.85rem);
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(30, 92, 242, 0.08);
    border: 1px solid rgba(30, 92, 242, 0.18);
    font-size: 0.875rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
  }
  .portal__remate {
    padding-top: 1.25rem;
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--verde-resalte);
  }
  .portal__remate::before {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    margin-bottom: 1.1rem;
    background: var(--borde);
  }

  @media (min-width: 620px) {
    .portal__claves {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .ciclo {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
  @media (min-width: 1100px) {
    .portal__claves {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
