---
import { serviciosMeta, servicios } from "../data/servicios";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section class="services section section--tint" aria-label="Servicios">
  <div class="container">
    <SectionHeading
      eyebrow={serviciosMeta.eyebrow}
      title={serviciosMeta.titulo}
      subtitle={serviciosMeta.subtitulo}
      center
    />

    <div class="services__grid">
      {
        servicios.map((s) => (
          <a href={`/servicios/${s.slug}`} class="card service">
            <span class="service__icon">
              <Icon name={s.icon} size={26} />
            </span>
            <h3 class="t-h3">{s.titulo}</h3>
            <p class="text-muted service__text">{s.resumen}</p>
            <span class="service__cta">
              Ver servicio
              <Icon name="arrowUpRight" size={16} />
            </span>
          </a>
        ))
      }
    </div>

    <div class="services__more">
      <a href="/servicios" class="btn btn--outline">Ver todos los servicios</a>
    </div>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .service {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .service__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: var(--azul-petroleo);
    color: var(--verde-acento);
    margin-bottom: 1.25rem;
  }
  .service__text {
    margin: 0.5rem 0 1.5rem;
    flex-grow: 1;
  }
  .service__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-acento-oscuro);
    transition: gap var(--transition);
  }
  .service:hover .service__cta {
    gap: 0.7rem;
  }
  .services__more {
    margin-top: 2rem;
    text-align: center;
  }

  @media (min-width: 720px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .services__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
