---
/* =====================================================================
   FOOTER PROPIO DEL ANEXO /programa-ejecutivos
   ---------------------------------------------------------------------
   Mismo motivo que <EjeNavbar />: el <Footer /> del sitio trae columnas
   que enlazan a Servicios (Método INTEGRA, EcomCloser) y a Explorar
   (Sobre mí, Blog), que son las otras verticales de negocio. Acá se
   mantiene el contacto y lo legal —necesario en cualquier página— pero
   sin esas columnas.

   Arriba va el logo de Programas AI First en su versión blanca, que es
   la que se lee sobre el azul petróleo del pie. Va chico a propósito: es
   una firma, no un titular. Sin íconos de redes: en el anexo no se
   manda a nadie afuera.
   ===================================================================== */
import { site } from "../../data/site";
import Icon from "../Icon.astro";
import { ejecutivos } from "../../data/ejecutivos";
const { footer } = site;
const { marca } = ejecutivos;
const year = 2026; // actualizá si corresponde
---

<footer class="ejf" aria-label="Pie de página">
  <div class="ej-wrap ejf__top">
    <div class="ejf__marca">
      <a class="ejf__logo" href={ejecutivos.rutas.inicio} aria-label={`${marca.nombre} — inicio`}>
        <img src={marca.logoBlanco} alt={marca.nombre} width="720" height="472" loading="lazy" />
      </a>
      <p class="ejf__mision">
        Estrategia, formación y adopción práctica de inteligencia artificial para equipos directivos.
      </p>
    </div>
    <ul class="ejf__contacto">
      <li>
        <Icon name="mail" size={16} />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <Icon name="location" size={16} />
        <span>{site.ubicacion}</span>
      </li>
    </ul>
  </div>

  <div class="ej-wrap ejf__bottom">
    <p class="t-caption">© {year} {marca.nombre}. Todos los derechos reservados.</p>
    <ul class="ejf__legal">
      {footer.legales.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .ejf {
    background: var(--azul-petroleo);
    color: rgba(255, 255, 255, 0.85);
    padding-top: clamp(2.5rem, 4vw, 3.25rem);
    font-size: 0.9375rem;
  }
  .ejf__top {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-bottom: 2rem;
  }
  .ejf__marca {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .ejf__logo {
    flex: none;
  }
  .ejf__logo img {
    display: block;
    width: 4.25rem;
    height: auto;
  }
  .ejf__mision {
    max-width: 34ch;
    padding-left: 1.25rem;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }
  .ejf__contacto {
    display: grid;
    gap: 0.6rem;
  }
  .ejf__contacto li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.75);
  }
  .ejf__contacto a:hover {
    color: var(--verde-acento);
  }
  .ejf__bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.6);
  }
  .ejf__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .ejf__legal a:hover {
    color: var(--verde-acento);
  }

  @media (min-width: 720px) {
    .ejf__top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .ejf__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
