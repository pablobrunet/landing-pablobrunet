---
import { site } from "../data/site";
import Icon from "./Icon.astro";
interface Props {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title = site.finalCta.titulo,
  subtitle = site.finalCta.subtitulo,
  ctaLabel = site.finalCta.cta.label,
  ctaHref = site.finalCta.cta.href,
} = Astro.props;
---

<section class="cta section section--dark">
  <svg class="cta__lines" viewBox="0 0 800 300" fill="none" aria-hidden="true">
    <path d="M-20 200 C 200 200 240 90 460 90 S 760 40 840 40" />
    <circle cx="460" cy="90" r="5" />
  </svg>
  <div class="container cta__inner">
    <h2 class="t-h2 cta__title">{title}</h2>
    <p class="t-subhead cta__sub">{subtitle}</p>
    <div class="cta__actions">
      <a href={ctaHref} class="btn btn--primary">
        {ctaLabel}
        <Icon name="arrow" size={18} />
      </a>
      <span class="cta__note">
        <Icon name="clock" size={16} />
        {site.finalCta.nota}
      </span>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .cta__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    stroke: var(--verde-azulado);
    stroke-width: 1.5;
    opacity: 0.25;
    pointer-events: none;
  }
  .cta__lines circle {
    fill: var(--verde-acento);
  }
  .cta__inner {
    position: relative;
    max-width: 760px;
    margin-inline: auto;
  }
  .cta__title {
    color: var(--blanco);
  }
  .cta__sub {
    margin: 1rem auto 2rem;
    color: rgba(255, 255, 255, 0.75);
    max-width: 56ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
  .cta__note {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--fs-caption);
    color: rgba(255, 255, 255, 0.7);
  }
</style>
