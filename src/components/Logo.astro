---
import { site } from "../data/site";
/* Logo de marca.
   Si `site.logo.claro` / `site.logo.oscuro` tienen ruta, se usa la imagen.
   Si están vacíos, cae al monograma "PB" dibujado en SVG. */
interface Props {
  light?: boolean; // true = para fondos oscuros
  showTagline?: boolean;
}
const { light = false, showTagline = true } = Astro.props;

/* Sobre fondo oscuro se usa la imagen SÓLO si hay una versión pensada para
   eso: invertir la clara daría colores que no son los de la marca (el
   wordmark azul petróleo se pierde y el degradado verde vira). Si no está,
   se cae al monograma dibujado, que sí tiene variante clara. */
const archivo = light ? site.logo.oscuro : site.logo.claro;
---

<a
  href="/"
  class:list={["logo", { "logo--light": light, "logo--img": Boolean(archivo) }]}
  aria-label={`${site.nombre} — ${site.tagline}`}
>
  {
    archivo ? (
      <img
        class="logo__img"
        src={archivo}
        alt={site.nombre}
        height={site.logo.alto}
        style={`height:${site.logo.alto}px`}
      />
    ) : (
      <>
        <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 40 40" width="40" height="40">
      <rect width="40" height="40" rx="11" fill="var(--mark-bg)" />
      <text
        x="50%"
        y="53%"
        text-anchor="middle"
        dominant-baseline="central"
        font-family="var(--font-base)"
        font-weight="700"
        font-size="18"
        letter-spacing="-0.5"
        fill="var(--mark-fg)">PB</text
      >
    </svg>
        </span>
        <span class="logo__text">
          <span class="logo__name">{site.nombre}</span>
          {showTagline && <span class="logo__tag">{site.tagline}</span>}
        </span>
      </>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    --mark-bg: var(--azul-petroleo);
    --mark-fg: var(--verde-acento);
  }
  .logo--light {
    --mark-bg: var(--verde-acento);
    --mark-fg: var(--azul-petroleo);
  }
  .logo__mark svg {
    display: block;
  }
  .logo__img {
    width: auto;
    max-width: 220px;
    object-fit: contain;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo__name {
    font-weight: var(--w-headline);
    font-size: 1.15rem;
    color: var(--azul-petroleo);
    letter-spacing: -0.01em;
  }
  .logo--light .logo__name {
    color: var(--blanco);
  }
  .logo__tag {
    font-size: 0.7rem;
    font-weight: var(--w-body);
    color: var(--verde-azulado);
    letter-spacing: 0.01em;
  }
</style>
