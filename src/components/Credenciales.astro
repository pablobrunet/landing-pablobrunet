---
import Frame from "./Frame.astro";
import Icon from "./Icon.astro";
import {
  credencialesMeta,
  credenciales,
  totalCertificaciones,
} from "../data/credenciales";
---

<div class="cred">
  <header class="cred__head">
    <div class="cred__intro">
      <span class="eyebrow">{credencialesMeta.eyebrow}</span>
      <h2 class="t-h2">{credencialesMeta.titulo}</h2>
      <p class="t-subhead text-muted">{credencialesMeta.subtitulo}</p>
    </div>

    <div class="cred__meta">
      <div class="cred__counter" aria-label={`${totalCertificaciones} certificaciones en total`}>
        <span class="cred__counter-n">{totalCertificaciones}</span>
        <span class="cred__counter-l">certificaciones</span>
      </div>
      <a href={credencialesMeta.linkedin} class="btn btn--outline cred__verify" target="_blank" rel="noopener">
        <Icon name="linkedin" size={18} />
        {credencialesMeta.linkedinLabel}
      </a>
    </div>
  </header>

  <div class="cred__blocks">
    {
      credenciales.map((ent) => (
        <section class="cred__block">
          <header class="cred__block-head">
            <span class="cred__badge">
              <Frame src={ent.badge} label={ent.badgeLabel} alt={`Insignia ${ent.entidad}`} ratio="1/1" />
            </span>
            <div>
              <h3 class="t-h3">{ent.entidad}</h3>
              <p class="cred__count t-caption">
                {ent.certificaciones.length}{" "}
                {ent.certificaciones.length === 1 ? "certificación" : "certificaciones"}
              </p>
            </div>
          </header>

          <div class="cred__grid">
            {ent.certificaciones.map((c) => (
              <article class="cred__card">
                <div class="cred__card-top">
                  <Icon name="shield" size={20} class="cred__card-i" />
                  {c.url && (
                    <a href={c.url} class="cred__card-link" target="_blank" rel="noopener" aria-label="Verificar credencial">
                      <Icon name="arrowUpRight" size={15} />
                    </a>
                  )}
                </div>
                <h4 class="cred__card-title">{c.titulo}</h4>
                <dl class="cred__card-meta">
                  <div>
                    <dt>Emisión</dt>
                    <dd>{c.fecha}</dd>
                  </div>
                  <div>
                    <dt>ID</dt>
                    <dd class="cred__id">{c.id}</dd>
                  </div>
                </dl>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</div>

<style>
  .cred__head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .cred__intro {
    max-width: 620px;
  }
  .cred__intro .t-subhead {
    margin-top: 0.75rem;
  }
  .cred__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }
  .cred__counter {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius);
    background: var(--azul-petroleo);
    color: var(--blanco);
  }
  .cred__counter-n {
    font-family: var(--font-title);
    font-size: 2rem;
    font-weight: var(--w-display);
    color: var(--verde-acento);
    line-height: 1;
  }
  .cred__counter-l {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .cred__blocks {
    display: grid;
    gap: 2.5rem;
  }
  .cred__block-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--borde);
  }
  .cred__badge {
    display: block;
    width: 56px;
    flex-shrink: 0;
  }
  .cred__count {
    color: var(--verde-azulado);
    font-weight: var(--w-subheadline);
    margin-top: 0.15rem;
  }

  .cred__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .cred__card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .cred__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .cred__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cred__card-i {
    color: var(--verde-acento-oscuro);
  }
  .cred__card-link {
    color: var(--texto-suave);
    transition: color var(--transition);
  }
  .cred__card-link:hover {
    color: var(--verde-acento-oscuro);
  }
  .cred__card-title {
    font-family: var(--font-title);
    font-size: 1.05rem;
    font-weight: var(--w-headline);
    line-height: 1.3;
    color: var(--azul-petroleo);
  }
  .cred__card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: auto;
  }
  .cred__card-meta dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--texto-suave);
  }
  .cred__card-meta dd {
    font-size: 0.9rem;
    font-weight: var(--w-subheadline);
    color: var(--azul-pizarra);
  }
  .cred__id {
    font-family: ui-monospace, "Cascadia Code", monospace;
    font-size: 0.82rem;
  }

  @media (min-width: 640px) {
    .cred__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 720px) {
    .cred__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
  @media (min-width: 1000px) {
    .cred__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
