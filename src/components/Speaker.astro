---
import { site } from "../data/site";
import Frame from "./Frame.astro";
import Icon from "./Icon.astro";
import { sinMarcas } from "../lib/texto";
const { speaker } = site;
---

<section class="speaker section" aria-label="Charlas">
  <div class="container">
    <div class="speaker__head">
      <div>
        <span class="eyebrow">{speaker.eyebrow}</span>
        <h2 class="t-h2">{sinMarcas(speaker.titulo)}</h2>
        <p class="t-subhead text-muted speaker__sub">{speaker.subtitulo}</p>
      </div>
      <a href={speaker.cta.href} class="btn btn--primary speaker__cta">
        {speaker.cta.label}
        <Icon name="arrow" size={18} />
      </a>
    </div>

    <ul class="speaker__gallery">
      {
        speaker.fotos.map((f) => (
          <li>
            <Frame src={f.img} label={f.imgLabel} alt="Foto de evento" ratio="3/4" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .speaker__head {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }
  .speaker__sub {
    margin-top: 0.75rem;
    max-width: 60ch;
  }
  .speaker__cta {
    align-self: flex-start;
  }
  .speaker__gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }

  @media (min-width: 720px) {
    .speaker__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
    .speaker__gallery {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
