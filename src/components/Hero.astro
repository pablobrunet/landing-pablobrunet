---
import { site } from "../data/site";
import Frame from "./Frame.astro";
import Icon from "./Icon.astro";
const { hero } = site;
---

<section class="hero" aria-label="Presentación">
  <!-- líneas de conexión del sistema gráfico -->
  <svg class="hero__lines" viewBox="0 0 600 500" fill="none" aria-hidden="true">
    <path d="M-20 380 C 160 380 200 260 360 260 S 560 140 640 140" />
    <path d="M-20 440 C 200 440 240 340 420 340 S 600 240 680 240" />
    <circle cx="360" cy="260" r="5" />
    <circle cx="420" cy="340" r="5" />
  </svg>

  <div class="container hero__inner">
    <div class="hero__copy">
      <span class="badge">
        <Icon name="shield" size={16} />
        {hero.badge}
      </span>

      <h1 class="t-display hero__title" set:html={hero.titulo.replace(/\n/g, "<br>")} />

      <p class="t-subhead text-muted hero__sub">{hero.subtitulo}</p>

      <div class="hero__disciplinas">
        {site.disciplinas.map((d) => <span class="chip">{d}</span>)}
      </div>

      <div class="hero__ctas">
        {
          hero.ctas.map((c) => (
            <a href={c.href} class:list={["btn", c.primary ? "btn--primary" : "btn--outline"]}>
              {c.label}
              {c.primary && <Icon name="arrow" size={18} />}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__media">
      <Frame src={hero.img} label={hero.imgLabel} alt={`Retrato de ${site.nombre}`} ratio="4/5" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(59, 163, 154, 0.08), transparent 55%),
      var(--blanco);
  }
  .hero__lines {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(60%, 700px);
    height: 100%;
    stroke: var(--verde-azulado);
    stroke-width: 1.5;
    opacity: 0.4;
    pointer-events: none;
  }
  .hero__lines circle {
    fill: var(--verde-acento);
    stroke: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__copy {
    max-width: 620px;
  }
  .hero__title {
    margin: 1rem 0;
    color: var(--azul-petroleo);
  }
  .hero__sub {
    max-width: 52ch;
  }
  .hero__disciplinas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .chip {
    font-size: var(--fs-caption);
    font-weight: var(--w-subheadline);
    color: var(--azul-pizarra);
    background: var(--gris-claro);
    border: 1px solid var(--borde);
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }
  .hero__media {
    max-width: 460px;
    width: 100%;
    justify-self: center;
  }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .hero__media {
      justify-self: end;
    }
  }
</style>
