---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { leads } from "../lib/leads";
const { newsletter } = site;
---

<Page title={`Newsletter — ${site.nombre}`} cta={false}>
  <PageHero
    eyebrow={newsletter.eyebrow}
    title={newsletter.titulo}
    subtitle={newsletter.subtitulo}
    crumbs={[{ label: "Recursos", href: "/recursos" }, { label: "Newsletter" }]}
  />

  <section class="section">
    <div class="container nl">
      <!-- Mismo destino que el bloque del home y que los recursos: la tabla
           `leads` de Supabase. Lo que los separa es el campo `origen`. -->
      <form
        class="nl__form"
        data-newsletter
        data-url={leads.endpoint}
        data-key={leads.clave}
        data-origen="newsletter"
      >
        <label class="visually-hidden" for="nl-email">Email</label>
        <input
          id="nl-email"
          type="email"
          name="email"
          required
          placeholder={newsletter.placeholder}
          autocomplete="email"
        />
        <input
          class="visually-hidden"
          id="nl-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <button type="submit" class="btn btn--primary">
          {newsletter.boton}
          <Icon name="mail" size={18} />
        </button>
        <p class="nl__error" data-nl-error hidden role="alert">
          No pudimos registrar tu correo. Probá de nuevo en un momento.
        </p>
      </form>

      <p class="nl__ok" data-nl-ok hidden>
        <Icon name="check" size={20} />
        <span>Listo, quedaste anotado. Nos leemos pronto.</span>
      </p>

      <ul class="nl__perks">
        <li><Icon name="check" size={16} /> Novedades reales de IA aplicada</li>
        <li><Icon name="check" size={16} /> Casos y herramientas útiles</li>
        <li><Icon name="check" size={16} /> Sin spam. Te podés dar de baja cuando quieras.</li>
      </ul>
    </div>
  </section>
</Page>

<style>
  .nl {
    max-width: 620px;
  }
  .nl__name {
    font-weight: var(--w-headline);
    color: var(--verde-resalte);
    margin-bottom: 1.25rem;
  }
  .nl__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .nl__form input {
    flex: 1 1 240px;
    font-family: inherit;
    font-size: 1rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--borde);
    background: var(--blanco);
  }
  .nl__form input:focus {
    outline: none;
    border-color: var(--verde-acento);
  }
  .nl__perks {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .nl__perks li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--azul-pizarra);
  }
  .nl__perks :global(svg) {
    color: var(--verde-resalte);
  }
  .nl__error {
    flex-basis: 100%;
    font-size: var(--fs-caption);
    color: #b3261e;
  }
  .nl__ok {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 191, 114, 0.1);
    color: var(--verde-resalte);
    font-weight: var(--w-subheadline);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  import { enviarLead } from "../scripts/enviarLead";

  function initNl() {
    const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
    if (!form || form.dataset.listo) return;
    form.dataset.listo = "1";

    const ok = document.querySelector<HTMLElement>("[data-nl-ok]");
    const error = document.querySelector<HTMLElement>("[data-nl-error]");
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const etiqueta = boton?.innerHTML ?? "";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const datos = new FormData(form);

      if (String(datos.get("website") ?? "").trim() !== "") {
        form.hidden = true;
        if (ok) ok.hidden = false;
        return;
      }

      if (error) error.hidden = true;
      if (boton) {
        boton.disabled = true;
        boton.textContent = "Enviando…";
      }

      try {
        await enviarLead(
          form.dataset.url ?? "",
          form.dataset.key ?? "",
          String(datos.get("email") ?? "").trim(),
          form.dataset.origen ?? "newsletter"
        );
      } catch {
        if (boton) {
          boton.disabled = false;
          boton.innerHTML = etiqueta;
        }
        if (error) error.hidden = false;
        return;
      }

      form.hidden = true;
      if (ok) ok.hidden = false;
    });
  }

  initNl();
  document.addEventListener("astro:page-load", initNl);
</script>
