---
/* =====================================================================
   ESPEJO DEL PROBLEMA (interactivo)
   ---------------------------------------------------------------------
   Convierte "interesante" en "esto me pasa a mí". Seis tarjetas
   clickeables; el panel de la derecha cuenta y devuelve una lectura
   distinta por CADA cantidad marcada —no por tramos—, para que el
   diagnóstico suba de a poco en vez de saltar.

   Los dolores y sus respuestas se editan en data/integra.ts, no acá:
   van emparejados uno a uno. Cada tarjeta es un <button aria-pressed>,
   así funciona con teclado y lo anuncia un lector de pantalla.
   ===================================================================== */
import { integra } from "../../data/integra";
const { espejo } = integra;
const total = espejo.dolores.length;
---

<section class="section i-claro" id="espejo" aria-label="Espejo del problema">
  <div class="container">
    <header class="i-head i-reveal">
      <span class="i-eyebrow">{espejo.eyebrow}</span>
      <h2 class="t-h2">{espejo.titulo}</h2>
      <p class="text-muted">{espejo.subtitulo}</p>
    </header>

    <div class="esp" data-espejo data-total={total}>
      <ul class="esp__grid">
        {
          espejo.dolores.map((d, i) => (
            <li class="i-reveal">
              <button type="button" class="dolor" aria-pressed="false" data-dolor>
                <span class="dolor__check" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12l4 4 10-10" />
                  </svg>
                </span>
                <span class="dolor__texto">{d}</span>
                <span class="dolor__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              </button>
            </li>
          ))
        }
      </ul>

      <aside class="esp__panel">
        {/* Las seis lecturas se dibujan todas y se apilan en la misma
            celda: el panel mide siempre lo que la más larga y no cambia
            de alto al marcar o desmarcar. Antes el texto se inyectaba por
            JS y el bloque crecía y se pasaba de la columna de tarjetas. */}
        <div class="marcador" data-marcador data-n="0">
          <div class="marcador__num">
            <strong data-contador>0</strong>
            <span>de {total}</span>
          </div>
          <div class="marcador__barra" role="progressbar" aria-valuemin="0" aria-valuemax={total} aria-valuenow="0" aria-label="Síntomas marcados" data-barra-wrap>
            <span data-barra></span>
          </div>

          <div class="marcador__lectura" aria-live="polite">
            <p class="marcador__pista" data-estado="0">Tocá las tarjetas que reconozcas.</p>
            {
              espejo.respuestas.map((r, i) => (
                <div class="marcador__r" data-estado={i + 1}>
                  <h3 class="t-h3">{r.titulo}</h3>
                  <p>{r.texto}</p>
                </div>
              ))
            }
          </div>

        </div>
      </aside>
    </div>

    {/* Cierra la sección a todo el ancho, debajo de las dos columnas.
        Adentro del panel competía con la lectura del conteo; acá es el
        remate de todo lo anterior y se lee como tal. Va en Azul Denim,
        que en la paleta es el secundario para información
        complementaria, y así no se confunde con el azul profundo del
        panel que puntúa. */}
    <p class="esp__fija i-reveal">{espejo.fija}</p>
  </div>
</section>

<style>
  .esp {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  /* Todas las tarjetas del mismo alto, sin importar cuánto texto tenga
     cada síntoma. Hacen falta las tres cosas:
       · grid-auto-rows: 1fr  → todas las filas miden lo mismo (la más alta)
       · el <li> como grid    → el botón puede estirarse dentro de la celda
       · height: 100%         → el botón ocupa todo el alto del <li>
     Sin la última, el <li> se estira pero el botón queda con su alto
     natural y se ve el desnivel. */
  .esp__grid {
    display: grid;
    gap: 0.75rem;
    grid-auto-rows: 1fr;
  }
  .esp__grid > li {
    display: grid;
  }

  /* ---- Tarjeta de dolor ---- */
  .dolor {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    width: 100%;
    height: 100%;
    text-align: left;
    padding: 1.05rem 3rem 1.05rem 1.1rem;
    font-family: inherit;
    font-size: 0.975rem;
    line-height: 1.45;
    color: var(--azul-petroleo);
    background: #fff;
    border: 1.5px solid var(--borde);
    border-radius: var(--radius);
    cursor: pointer;
    transition: border-color var(--transition), background var(--transition),
      transform var(--transition), box-shadow var(--transition);
  }
  .dolor:hover {
    border-color: var(--i-azul-500);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .dolor__check {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border-radius: 7px;
    border: 1.5px solid var(--borde-punteado);
    background: var(--i-hielo-2);
    color: transparent;
    transition: background var(--transition), border-color var(--transition), color var(--transition);
  }
  .dolor__n {
    position: absolute;
    top: 0.9rem;
    right: 1rem;
    font-size: 0.75rem;
    font-weight: var(--w-headline);
    color: var(--borde-punteado);
    letter-spacing: 0.04em;
  }
  .dolor[aria-pressed="true"] {
    border-color: var(--i-azul-600);
    background: linear-gradient(135deg, rgba(76, 134, 245, 0.1), rgba(30, 92, 242, 0.05));
  }
  .dolor[aria-pressed="true"] .dolor__check {
    background: var(--i-grad);
    border-color: transparent;
    color: #fff;
  }
  .dolor[aria-pressed="true"] .dolor__texto {
    font-weight: var(--w-subheadline);
  }
  .dolor[aria-pressed="true"] .dolor__n {
    /* El aclarado (--i-azul-500) queda en 3,5:1 sobre el fondo de la tarjeta
       marcada: para texto va el Azul Intenso, que llega a 5,2:1. */
    color: var(--i-azul-600);
  }

  /* ---- Panel de conteo ---- */
  .marcador {
    padding: clamp(1.35rem, 3vw, 1.85rem);
    border-radius: var(--radius-lg);
    background: var(--i-noche);
    color: #fff;
    box-shadow: var(--shadow-lg);
  }
  .marcador__num {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .marcador__num strong {
    font-family: var(--font-title);
    font-size: 3.25rem;
    line-height: 1;
    font-weight: var(--w-display);
    background: linear-gradient(120deg, #a9c8f5, #4c86f5);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .marcador__num span {
    color: rgba(220, 230, 246, 0.6);
    font-size: 0.95rem;
  }
  .marcador__barra {
    height: 6px;
    margin-top: 1rem;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .marcador__barra span {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 99px;
    background: var(--i-grad);
    transition: width 380ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  /* Todas las lecturas en la misma celda de grid: el alto lo fija la más
     larga y ya no depende de cuántas tarjetas haya marcadas. */
  .marcador__lectura {
    display: grid;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .marcador__lectura > * {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 240ms ease, visibility 240ms;
  }
  .marcador[data-n="0"] [data-estado="0"],
  .marcador[data-n="1"] [data-estado="1"],
  .marcador[data-n="2"] [data-estado="2"],
  .marcador[data-n="3"] [data-estado="3"],
  .marcador[data-n="4"] [data-estado="4"],
  .marcador[data-n="5"] [data-estado="5"],
  .marcador[data-n="6"] [data-estado="6"] {
    visibility: visible;
    opacity: 1;
  }
  .marcador__pista {
    font-size: 0.9rem;
    color: rgba(220, 230, 246, 0.65);
  }
  .marcador__r h3 {
    color: var(--i-neblina);
    margin-bottom: 0.5rem;
  }
  .marcador__r p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(220, 230, 246, 0.85);
  }
  /* Remate de la sección, a todo el ancho y debajo de las dos columnas. */
  .esp__fija {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    padding: clamp(1.25rem, 3vw, 1.85rem) clamp(1.35rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--i-denim);
    color: #fff;
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    font-size: clamp(1rem, 0.92rem + 0.45vw, 1.25rem);
    line-height: 1.55;
    text-align: center;
    text-wrap: balance;
  }
  @media (min-width: 700px) {
    .esp__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .esp {
      grid-template-columns: 1.35fr 0.85fr;
      gap: 2rem;
      /* Las dos columnas arrancan y terminan en la misma línea. Antes
         iban con `align-items: start`, así que cada una quedaba en su
         alto natural y el panel azul —más alto— sobraba por abajo.
         Con `stretch`, la fila mide lo que la más alta y las dos la
         ocupan entera. */
      align-items: stretch;
    }
    /* La columna de tarjetas se estira, y como sus filas son `1fr` el
       alto sobrante se reparte parejo entre las seis: crecen todas por
       igual en vez de quedar cortas. */
    .esp__grid {
      height: 100%;
    }
    /* El panel se estira igual. Sin esto, el <aside> ocupa la fila pero
       el bloque azul de adentro conserva su alto y no se nota el cambio.
       Se saca el `sticky`: es incompatible con estirarse, y con las dos
       columnas del mismo alto ya no tenía nada que hacer. */
    .esp__panel {
      display: grid;
    }
  }
</style>

<script>
  function initEspejo() {
    const raiz = document.querySelector<HTMLElement>("[data-espejo]");
    if (!raiz || raiz.dataset.listo) return;
    raiz.dataset.listo = "1";

    const total = Number(raiz.dataset.total ?? 6);
    const tarjetas = Array.from(raiz.querySelectorAll<HTMLButtonElement>("[data-dolor]"));
    const marcador = raiz.querySelector<HTMLElement>("[data-marcador]");
    const contador = raiz.querySelector<HTMLElement>("[data-contador]");
    const barra = raiz.querySelector<HTMLElement>("[data-barra]");
    const barraWrap = raiz.querySelector<HTMLElement>("[data-barra-wrap]");

    /* El texto de cada lectura ya está en el HTML: acá sólo se anota
       cuántas hay marcadas y el CSS enciende la que corresponde. Así el
       panel no cambia de alto y el contenido existe sin JavaScript. */
    function pintar() {
      const n = tarjetas.filter((t) => t.getAttribute("aria-pressed") === "true").length;

      if (contador) contador.textContent = String(n);
      if (barra) barra.style.width = `${(n / total) * 100}%`;
      barraWrap?.setAttribute("aria-valuenow", String(n));
      if (marcador) marcador.dataset.n = String(Math.min(n, total));
    }

    tarjetas.forEach((t) => {
      t.addEventListener("click", () => {
        t.setAttribute("aria-pressed", t.getAttribute("aria-pressed") === "true" ? "false" : "true");
        pintar();
      });
    });

    pintar();
  }

  initEspejo();
  document.addEventListener("astro:page-load", initEspejo);
</script>
