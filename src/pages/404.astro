---
import Page from "../layouts/Page.astro";
import Icon from "../components/Icon.astro";
---

<Page title="Página no encontrada" cta={false}>
  <section class="notfound section">
    <div class="container notfound__inner">
      <span class="notfound__code">404</span>
      <h1 class="t-h2">Esta página no existe</h1>
      <p class="t-subhead text-muted">
        Puede que el enlace esté roto o la página se haya movido.
      </p>
      <div class="notfound__actions">
        <a href="/" class="btn btn--primary">
          Volver al inicio
          <Icon name="arrow" size={18} />
        </a>
        <a href="/contacto" class="btn btn--outline">Contacto</a>
      </div>
    </div>
  </section>
</Page>

<style>
  .notfound {
    text-align: center;
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .notfound__inner {
    max-width: 560px;
    margin-inline: auto;
  }
  .notfound__code {
    display: block;
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: var(--w-display);
    color: var(--verde-acento);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
