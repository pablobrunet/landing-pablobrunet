---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import Frame from "../../components/Frame.astro";
import Icon from "../../components/Icon.astro";
import { blogMeta, blog } from "../../data/blog";
---

<Page title={`Blog — ${blogMeta.titulo}`}>
  <PageHero
    eyebrow={blogMeta.eyebrow}
    title={blogMeta.titulo}
    subtitle={blogMeta.subtitulo}
    crumbs={[{ label: "Blog" }]}
  />

  <section class="section">
    <div class="container">
      <div class="grid">
        {
          blog.map((p) => (
            <a href={`/blog/${p.slug}`} class="card post">
              <Frame src={p.img} label={p.imgLabel} alt={p.titulo} ratio="16/9" rounded={false} />
              <div class="post__body">
                <span class="post__cat">{p.categoria}</span>
                <h2 class="t-h3">{p.titulo}</h2>
                <p class="text-muted post__ex">{p.resumen}</p>
                <span class="post__cta">
                  Leer artículo
                  <Icon name="arrowUpRight" size={15} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Page>

<style>
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .post {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .post__body {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .post__cat {
    font-size: var(--fs-caption);
    font-weight: var(--w-subheadline);
    color: var(--verde-azulado);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .post__ex {
    margin: 0.4rem 0 1rem;
    flex-grow: 1;
  }
  .post__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-acento-oscuro);
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
