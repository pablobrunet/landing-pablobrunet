---
/* =====================================================================
   CARRUSEL DE FOTOS NAVEGABLE
   ---------------------------------------------------------------------
   Tres visibles por fila en escritorio; se recorre con las flechas, con
   el dedo o con la rueda horizontal. Al llegar a un extremo da la vuelta,
   así nunca queda trabado.
   Usa scroll nativo con `scroll-snap`, no un carrusel a fuerza de JS:
   funciona con teclado, con lector de pantalla y sin JavaScript.
   ===================================================================== */
import Frame from "./Frame.astro";
import Icon from "./Icon.astro";

interface Foto {
  img: string;
  imgLabel?: string;
  alt?: string; // no se muestra: solo lectores de pantalla y buscadores
  /* Si viene `titulo`, la foto lleva una placa al pie con el lugar y el tema.
     Sin `titulo` la foto va limpia, como antes. */
  titulo?: string;
  subtitulo?: string;
  /* Encuadre, para las fotos que el recorte centrado deja mal (típico en
     las verticales): "center 30%" sube el foco. Ver Frame.astro. */
  pos?: string;
}
interface Props {
  fotos: Foto[];
  ratio?: string;
  etiqueta: string; // para el aria-label del carrusel
}
const { fotos, ratio = "4/3", etiqueta } = Astro.props;
---

<div class="car" data-carrusel>
  <div
    class="car__pista"
    data-pista
    role="group"
    aria-label={etiqueta}
    tabindex="0"
  >
    {
      fotos.map((f) => (
        <div class="car__item">
          <figure class="car__foto">
            <Frame
              src={f.img}
              label={f.imgLabel}
              alt={f.alt ?? ""}
              ratio={ratio}
              pos={f.pos}
            />
            {f.titulo && (
              <figcaption class="car__placa">
                <span class="car__lugar">{f.titulo}</span>
                {f.subtitulo && <span class="car__tema">{f.subtitulo}</span>}
              </figcaption>
            )}
          </figure>
        </div>
      ))
    }
  </div>

  <div class="car__nav">
    <button class="car__btn" type="button" data-prev aria-label="Fotos anteriores">
      <Icon name="chevron" size={20} />
    </button>
    <button class="car__btn" type="button" data-next aria-label="Fotos siguientes">
      <Icon name="chevron" size={20} />
    </button>
  </div>
</div>

<style>
  .car {
    position: relative;
  }
  .car__pista {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * 1rem) / 1.15);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* espacio para que la sombra de las tarjetas no se corte */
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }
  .car__pista::-webkit-scrollbar {
    display: none;
  }
  .car__item {
    scroll-snap-align: start;
    min-width: 0;
  }
  /* ---- Foto con placa ---- */
  .car__foto {
    position: relative;
    border-radius: var(--radius);
    /* recorta el degradado contra las esquinas redondeadas del marco */
    overflow: hidden;
    isolation: isolate;
  }
  /* La placa arranca abajo a la izquierda y el degradado se desvanece antes
     de la mitad: da contraste al texto sin velar la foto. */
  .car__placa {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 2.75rem 1.1rem 0.95rem;
    color: #fff;
    text-shadow: 0 1px 2px rgba(11, 31, 42, 0.45);
    background: linear-gradient(
      to top,
      rgba(11, 31, 42, 0.78) 0%,
      rgba(11, 31, 42, 0.55) 35%,
      rgba(11, 31, 42, 0.18) 70%,
      transparent 100%
    );
    pointer-events: none;
  }
  .car__lugar {
    font-weight: var(--w-headline);
    font-size: 1.02rem;
    line-height: 1.25;
  }
  .car__tema {
    font-size: var(--fs-caption);
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.85);
  }
  /* ---- Flechas ---- */
  .car__nav {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .car__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--blanco);
    border: 1px solid var(--borde);
    color: var(--azul-petroleo);
    cursor: pointer;
    transition: background var(--transition), color var(--transition),
      border-color var(--transition);
  }
  .car__btn:hover {
    background: var(--verde-acento);
    border-color: var(--verde-acento);
    color: var(--azul-petroleo);
  }
  /* El ícono es un chevron hacia abajo: se gira para cada lado. */
  .car__btn[data-prev] :global(svg) {
    transform: rotate(90deg);
  }
  .car__btn[data-next] :global(svg) {
    transform: rotate(-90deg);
  }

  /* Los divisores no son enteros a propósito: dejan asomar un pedazo de la
     foto siguiente, que es la señal de que el carrusel sigue hacia la
     derecha. Con 3 justas parece que no hay nada más. */
  @media (min-width: 640px) {
    .car__pista {
      grid-auto-columns: calc((100% - 2rem) / 2.2);
    }
  }
  @media (min-width: 900px) {
    .car__pista {
      grid-auto-columns: calc((100% - 3rem) / 3.2);
    }
  }
</style>

<script>
  function initCarruseles() {
    document.querySelectorAll<HTMLElement>("[data-carrusel]").forEach((car) => {
      if (car.dataset.listo) return;
      car.dataset.listo = "1";

      const pista = car.querySelector<HTMLElement>("[data-pista]");
      const prev = car.querySelector<HTMLButtonElement>("[data-prev]");
      const next = car.querySelector<HTMLButtonElement>("[data-next]");
      if (!pista) return;

      // Ancho de un salto: el de la primera foto más el hueco.
      const paso = () => {
        const item = pista.querySelector<HTMLElement>(".car__item");
        if (!item) return pista.clientWidth;
        const gap = parseFloat(getComputedStyle(pista).columnGap || "0");
        return item.getBoundingClientRect().width + gap;
      };

      const finDeLaPista = () =>
        Math.abs(pista.scrollLeft + pista.clientWidth - pista.scrollWidth) < 4;

      next?.addEventListener("click", () => {
        // Al final, vuelve al principio: el recorrido no se corta nunca.
        if (finDeLaPista()) pista.scrollTo({ left: 0 });
        else pista.scrollBy({ left: paso() });
      });

      prev?.addEventListener("click", () => {
        if (pista.scrollLeft < 4) pista.scrollTo({ left: pista.scrollWidth });
        else pista.scrollBy({ left: -paso() });
      });
    });
  }

  initCarruseles();
  document.addEventListener("astro:page-load", initCarruseles);
</script>
