---
/* =====================================================================
   /cotizacion-estudio-milman — PROPUESTA PARA ESTUDIO MILMAN
   ---------------------------------------------------------------------
   Propuesta de servicios para un cliente concreto, surgida de la reunión
   del 14/08/2026. Se comparte por enlace directo y va con `noindex`: no
   es contenido del sitio.

   ES UNA PROPUESTA PUBLICADA COMO PÁGINA, NO UN PDF Y NO UNA LANDING.
   De ahí las dos reglas que la gobiernan:

     · El LENGUAJE es el de un documento: descriptivo, con el alcance y
       las condiciones definidos punto por punto. Los títulos nombran lo
       que hay debajo; no hay promesas de resultado ni llamados a la
       acción. La regla completa está en data/milman.ts.

     · La FORMA aprovecha que es HTML: índice navegable, secciones con
       aire, tarjetas, calendario de fases y selector de áreas sin
       JavaScript. Es el sistema visual de las propuestas de Royjo y
       Biscayart y de la landing del Método INTEGRA —mismos tokens,
       mismas utilidades (`.i-oscuro`, `.i-head`, `.i-eyebrow`, `.i-hl`,
       `.i-reveal`), mismo navbar y pie—.

   IDENTIDAD VISUAL. styles/integra.css se importa sólo acá, así que su
   CSS no viaja en las demás páginas.

   ORDEN DEL DOCUMENTO. Los diez puntos salen del array `indice` de los
   datos, que es también el que dibuja el índice de la portada:

      01 Objeto de la propuesta
      02 Situación actual y consideraciones previas
      03 Enfoque de trabajo
      04 Alcance del servicio                      4.1 a 4.7
      05 Las siete fases en sesenta días
      06 Participantes y dedicación prevista
      07 Aplicaciones previstas por área
      08 Condiciones económicas
      09 Condiciones generales                     9.1 a 9.6
      10 Próximos pasos

   ⚠️ Si se agrega, se saca o se reordena una sección hay que tocar tres
   lugares: el array `indice`, el `n` de la sección en los datos y el
   orden de los componentes de acá abajo.

   FONDOS. Alternan claro / tenue / oscuro para separar los bloques de
   lectura. Los dos oscuros son el enfoque y el calendario de fases: las
   dos secciones donde se describe cómo se trabaja.

   ⚠️ ANTES DE ENVIAR hay cuatro definiciones pendientes —el importe, la
   forma de pago, la validez y la cadencia de encuentros—. Están todas
   listadas en el encabezado de data/milman.ts.
   ===================================================================== */
import "../../styles/integra.css";
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import MilmanHero from "../../components/milman/MilmanHero.astro";
import MilmanObjeto from "../../components/milman/MilmanObjeto.astro";
import MilmanEnfoque from "../../components/milman/MilmanEnfoque.astro";
import MilmanAlcance from "../../components/milman/MilmanAlcance.astro";
import MilmanFases from "../../components/milman/MilmanFases.astro";
import MilmanParticipantes from "../../components/milman/MilmanParticipantes.astro";
import MilmanAplicaciones from "../../components/milman/MilmanAplicaciones.astro";
import MilmanEconomicas from "../../components/milman/MilmanEconomicas.astro";
import MilmanGenerales from "../../components/milman/MilmanGenerales.astro";
import MilmanCierre from "../../components/milman/MilmanCierre.astro";
import { milman } from "../../data/milman";
---

<Base
  title={milman.seo.title}
  description={milman.seo.description}
  waMensaje={milman.whatsapp.mensaje}
  waEtiqueta={milman.whatsapp.etiqueta}
  noindex
>
  <Navbar />
  <main>
    <MilmanHero />
    <MilmanObjeto />
    <MilmanEnfoque />
    <MilmanAlcance />
    <MilmanFases />
    <MilmanParticipantes />
    <MilmanAplicaciones />
    <MilmanEconomicas />
    <MilmanGenerales />
    <MilmanCierre />
  </main>
  <Footer />
</Base>

<script>
  /* ------------------------------------------------------------------
     Aparición al hacer scroll, igual que en la landing del Método
     INTEGRA y en las propuestas de Royjo y Biscayart. La clase
     `is-listo` es la que aplica el estado inicial oculto: sin JS nunca
     se agrega y el contenido se ve normal.

     El selector de áreas no necesita JavaScript: son radios nativos.
     ------------------------------------------------------------------ */
  function initPropuestaMilman() {
    if (!document.querySelector("#condiciones-economicas")) return;

    const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducido || !("IntersectionObserver" in window)) return;

    const bloques = Array.from(document.querySelectorAll<HTMLElement>(".i-reveal"));
    bloques.forEach((b) => b.classList.add("is-listo"));

    const obs = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (!e.isIntersecting) return;
          (e.target as HTMLElement).classList.add("is-visible");
          obs.unobserve(e.target);
        });
      },
      { rootMargin: "0px 0px -12% 0px", threshold: 0.05 }
    );
    bloques.forEach((b) => obs.observe(b));
  }

  initPropuestaMilman();
  document.addEventListener("astro:page-load", initPropuestaMilman);
</script>
