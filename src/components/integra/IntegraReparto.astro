---
/* =====================================================================
   QUIÉN HACE QUÉ
   ---------------------------------------------------------------------
   La idea que tiene que quedar es una sola: hay dos partes y una zona
   donde se cruzan. Por eso no son tres tarjetas iguales en fila —eso se
   leía como una plantilla— sino una composición: los dos extremos en
   claro, el cruce en el medio, oscuro y elevado, con dos conectores que
   entran hacia él.

   El orden de las columnas lo fija data/integra.ts y no es decorativo:
   "juntos" tiene que ir en el medio para que la figura funcione.
   ===================================================================== */
import { integra } from "../../data/integra";
const { reparto } = integra;
---

<section class="section i-hielo i-claro" aria-label="Quién hace qué">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <h2 class="t-h2">
        {reparto.titulo}
        <span class="i-hl rep__resalte">{reparto.tituloResalte}</span>
      </h2>
      <p class="text-muted">{reparto.subtitulo}</p>
    </header>

    <div class="rep i-reveal">
      {
        reparto.columnas.map((col) => (
          <article class:list={["rep__card", `rep__card--${col.tono}`]}>
            <header class="rep__head">
              <span class="rep__icono" aria-hidden="true">
                {col.icono === "brujula" && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M15.5 8.5l-2 5-5 2 2-5z" />
                  </svg>
                )}
                {col.icono === "manos" && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 11l3-3 4 4 3-3" />
                    <path d="M3 13.5l4.5 4.5a3 3 0 0 0 4.2 0l.3-.3" />
                    <path d="M21 10.5L16.5 6a3 3 0 0 0-4.2 0l-.3.3" />
                  </svg>
                )}
                {col.icono === "equipo" && (
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="8" r="3.2" />
                    <path d="M3.5 19.5c0-3 2.5-5 5.5-5s5.5 2 5.5 5" />
                    <path d="M16 5.5a3 3 0 0 1 0 5.6M17.5 14.8c1.9.6 3.2 2.3 3.2 4.7" />
                  </svg>
                )}
              </span>
              <h3 class="rep__t">{col.titulo}</h3>
            </header>

            <ul class="rep__lista">
              {col.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* La segunda oración baja de renglón. El azul lo pone `.i-hl`, que
     sobre fondo claro resuelve a --verde-resalte (#1747C2): color plano y
     con contraste de sobra, no el degradé que usa sobre oscuro. */
  .rep__resalte {
    display: block;
  }

  .rep {
    display: grid;
    gap: 1rem;
  }

  /* ---------------------------- Las piezas --------------------------- */
  .rep__card {
    position: relative;
    padding: clamp(1.35rem, 3vw, 1.75rem);
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radius-lg);
  }
  .rep__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--borde);
  }
  .rep__icono {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--i-hielo);
    border: 1px solid var(--borde);
    color: var(--i-azul-600);
  }
  .rep__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.05rem;
    line-height: 1.2;
    color: var(--azul-petroleo);
  }
  .rep__lista {
    display: grid;
    gap: 0.55rem;
  }
  .rep__lista li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--azul-pizarra);
  }
  /* Guion en vez de tilde verde: acá no se está marcando nada como
     conseguido, sólo enumerando lo que aporta cada parte. */
  .rep__lista li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.66em;
    width: 7px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--i-azul-500);
  }

  /* ------------------------- El cruce, al medio ---------------------- */
  .rep__card--juntos {
    background: var(--i-navy);
    border-color: transparent;
    box-shadow: var(--shadow-lg);
  }
  .rep__card--juntos .rep__head {
    border-bottom-color: rgba(169, 200, 245, 0.22);
  }
  .rep__card--juntos .rep__icono {
    background: rgba(169, 200, 245, 0.14);
    border-color: rgba(169, 200, 245, 0.3);
    color: var(--i-celeste);
  }
  .rep__card--juntos .rep__t {
    color: #fff;
  }
  .rep__card--juntos .rep__lista li {
    color: rgba(220, 230, 246, 0.88);
  }
  .rep__card--juntos .rep__lista li::before {
    background: var(--i-celeste);
  }

  @media (min-width: 900px) {
    .rep {
      grid-template-columns: 1fr 1.06fr 1fr;
      gap: 1.5rem;
      /* Los extremos se alinean abajo; el del medio sobresale hacia
         arriba, que es lo que hace legible la figura. */
      align-items: end;
    }
    .rep__card--juntos {
      /* Sobresale por arriba y por abajo respecto de los extremos. */
      margin-block: -1.5rem;
      padding-block: calc(clamp(1.35rem, 3vw, 1.75rem) + 1.5rem);
    }

    /* Conectores: dos líneas cortas que entran desde los extremos hacia
       el centro. Se dibujan sobre las tarjetas laterales para no depender
       de un elemento extra en el HTML. */
    .rep__card--nosotros::after,
    .rep__card--empresa::before {
      content: "";
      position: absolute;
      top: 50%;
      width: 1.5rem;
      height: 1.5px;
      background: linear-gradient(90deg, transparent, var(--i-azul-500));
    }
    .rep__card--nosotros::after {
      left: 100%;
    }
    .rep__card--empresa::before {
      right: 100%;
      background: linear-gradient(270deg, transparent, var(--i-azul-500));
    }
  }
</style>
