---
import { site } from "../data/site";
import Frame from "./Frame.astro";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
const { casos } = site;
---

<section class="portfolio section section--tint" id="casos" aria-label="Casos">
  <div class="container">
    <SectionHeading
      eyebrow={casos.eyebrow}
      title={casos.titulo}
      subtitle={casos.subtitulo}
    />

    <div class="portfolio__grid">
      {
        casos.items.map((c) => (
          <a href={c.href} class="card case">
            <Frame src={c.img} label={c.imgLabel} alt={c.titulo} ratio="16/10" rounded={false} />
            <div class="case__body">
              <span class="case__cat">{c.categoria}</span>
              <h3 class="t-h3">{c.titulo}</h3>
              <p class="t-caption text-muted case__loc">
                <Icon name="location" size={14} />
                {c.ubicacion}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="portfolio__more">
      <a href={casos.verMas.href} class="btn btn--outline">{casos.verMas.label}</a>
    </div>
  </div>
</section>

<style>
  .portfolio__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .case {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .case__body {
    padding: 1.25rem 1.35rem 1.5rem;
  }
  .case__cat {
    display: inline-block;
    font-size: var(--fs-caption);
    font-weight: var(--w-subheadline);
    color: var(--verde-acento-oscuro);
    background: rgba(0, 191, 114, 0.1);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.6rem;
  }
  .case__loc {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }
  .portfolio__more {
    margin-top: 2rem;
    text-align: center;
  }

  @media (min-width: 640px) {
    .portfolio__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .portfolio__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
