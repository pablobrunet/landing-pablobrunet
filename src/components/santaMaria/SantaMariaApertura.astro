---
/* =====================================================================
   01 · DIAGNÓSTICO   ·   02 · OBJETO
   ---------------------------------------------------------------------
   Las dos secciones de apertura van en un mismo archivo: comparten
   estructura —encabezado, texto, un bloque destacado— y separarlas sólo
   habría duplicado el andamiaje. Mismo recurso que BiscayartObjeto.astro.

   El diagnóstico abre con los puntos de partida, en fondo tenue y
   numerados: es lo que motiva el programa, así que va primero. El objeto
   cierra con la finalidad en una franja: la frase que define para qué se
   contrata el servicio.
   ===================================================================== */
import { santaMaria } from "../../data/santaMaria";
const { diagnostico, objeto } = santaMaria;
---

<section class="section i-hielo i-claro diag" id={diagnostico.id} aria-label={diagnostico.titulo}>
  <div class="container">
    <header class="i-head i-reveal">
      <span class="i-eyebrow">{diagnostico.eyebrow}</span>
      <h2 class="t-h2">{diagnostico.titulo}</h2>
      <p class="text-muted">{diagnostico.intro}</p>
    </header>

    <ol class="diag__lista i-reveal">
      {
        diagnostico.puntos.map((p, i) => (
          <li>
            <span class="diag__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span>{p}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section i-claro obj" id={objeto.id} aria-label={objeto.titulo}>
  <div class="container">
    <header class="i-head i-reveal">
      <span class="i-eyebrow">{objeto.eyebrow}</span>
      <h2 class="t-h2">{objeto.titulo}</h2>
      {objeto.parrafos.map((p) => <p class="text-muted">{p}</p>)}
    </header>

    <div class="obj__finalidad i-reveal">
      <span class="obj__finalidad-t">{objeto.finalidadTitulo}</span>
      <p>{objeto.finalidad}</p>
    </div>
  </div>
</section>

<style>
  .diag .i-head,
  .obj .i-head {
    max-width: 62rem;
  }
  .obj .i-head p + p {
    margin-top: 0.9rem;
  }

  /* ---- Puntos de partida ---- */
  .diag__lista {
    display: grid;
    gap: 0.7rem;
    list-style: none;
  }
  .diag__lista li {
    display: flex;
    align-items: flex-start;
    gap: 0.95rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    background: #fff;
    border: 1px solid var(--borde);
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--azul-pizarra);
  }
  .diag__n {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--i-neblina);
    color: var(--verde-resalte);
    font-size: 0.72rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.06em;
  }

  /* ---- Finalidad ---- */
  .obj__finalidad {
    padding: clamp(1.35rem, 3vw, 1.85rem) clamp(1.35rem, 3vw, 1.95rem);
    border-radius: var(--radius);
    border-left: 4px solid var(--i-azul-600);
    background: rgba(30, 92, 242, 0.06);
  }
  .obj__finalidad-t {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--verde-resalte);
  }
  .obj__finalidad p {
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    font-size: clamp(1rem, 0.92rem + 0.5vw, 1.2rem);
    line-height: 1.55;
    color: var(--azul-petroleo);
  }

  @media (min-width: 900px) {
    /* Cuatro renglones cortos: en una sola columna la sección quedaba
       como una lista larga de tarjetas casi vacías. */
    .diag__lista {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
