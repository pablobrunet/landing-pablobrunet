---
/* =====================================================================
   CIERRE — /programa-ejecutivos
   ---------------------------------------------------------------------
   Bloque oscuro final con los dos CTAs: agendar y escribir. Los dos halos
   difuminados en las esquinas opuestas son los del original.
   ===================================================================== */
import { ejecutivos } from "../../data/ejecutivos";
const { cierre } = ejecutivos.home;
const { agenda, whatsapp } = ejecutivos.enlaces;
---

<section class="ej-oscuro ej-sec eci">
  <span class="eci__halo eci__halo--a" aria-hidden="true"></span>
  <span class="eci__halo eci__halo--b" aria-hidden="true"></span>

  <div class="ej-wrap eci__inner">
    <h2 class="ej-h2 eci__titulo">
      <span class="eci__suave">{cierre.tituloSuave}</span><br />{cierre.titulo}
    </h2>
    <p class="eci__sub">{cierre.subtitulo}</p>

    <div class="eci__ctas">
      <a
        class="ej-btn ej-btn--blanco ej-btn--grande"
        href={agenda}
        target="_blank"
        rel="noopener noreferrer"
      >
        {cierre.ctaPrimario}
      </a>
      <a
        class="ej-btn ej-btn--fantasma ej-btn--grande"
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
      >
        {cierre.ctaSecundario}
      </a>
    </div>
  </div>
</section>

<style>
  .eci {
    position: relative;
    overflow: hidden;
  }
  .eci__halo {
    position: absolute;
    width: 24rem;
    height: 24rem;
    border-radius: 50%;
    filter: blur(64px);
  }
  .eci__halo--a {
    top: 0;
    right: 0;
    transform: translate(50%, -50%);
    background: rgba(76, 134, 245, 0.14);
  }
  .eci__halo--b {
    bottom: 0;
    left: 0;
    transform: translate(-50%, 50%);
    background: rgba(59, 108, 183, 0.14);
  }
  .eci__inner {
    position: relative;
    z-index: 1;
    max-width: 56rem;
    text-align: center;
    display: grid;
    gap: 2rem;
    justify-items: center;
  }
  .eci__titulo {
    color: #ffffff;
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.75rem);
  }
  .eci__suave {
    font-weight: 400;
  }
  .eci__sub {
    max-width: 42rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
  }
  .eci__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    padding-top: 1rem;
  }
</style>
