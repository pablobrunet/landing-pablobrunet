---
import { site } from "../data/site";
import Icon from "./Icon.astro";
const { newsletter } = site;
---

<section class="newsletter section" aria-label="Newsletter">
  <div class="container">
    <div class="newsletter__card">
      <div class="newsletter__copy">
        <span class="eyebrow">{newsletter.eyebrow}</span>
        <h2 class="t-h2">{newsletter.titulo}</h2>
        <p class="newsletter__name">{newsletter.nombreNewsletter}</p>
        <p class="t-subhead text-muted">{newsletter.subtitulo}</p>
      </div>

      <!--
        FORM SIN CONECTAR. Para activarlo, apuntá el `action` a tu proveedor
        (Mailchimp / Beehiiv / ConvertKit / etc.) o manejá el submit por JS.
      -->
      <form class="newsletter__form" data-newsletter onsubmit="return false">
        <label class="visually-hidden" for="nl-email">Email</label>
        <input
          id="nl-email"
          type="email"
          name="email"
          required
          placeholder={newsletter.placeholder}
          autocomplete="email"
        />
        <button type="submit" class="btn btn--primary">
          {newsletter.boton}
          <Icon name="mail" size={18} />
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .newsletter__card {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: clamp(2rem, 5vw, 3.5rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 120% at 0% 0%, rgba(59, 163, 154, 0.08), transparent 50%),
      var(--gris-claro);
    border: 1px solid var(--borde);
  }
  .newsletter__name {
    font-weight: var(--w-headline);
    color: var(--verde-acento-oscuro);
    margin: 0.5rem 0 0.75rem;
  }
  .newsletter__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .newsletter__form input {
    flex: 1 1 220px;
    font-family: inherit;
    font-size: 1rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--borde);
    background: var(--blanco);
  }
  .newsletter__form input:focus {
    outline: none;
    border-color: var(--verde-acento);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (min-width: 820px) {
    .newsletter__card {
      grid-template-columns: 1.2fr 0.8fr;
    }
  }
</style>

<script>
  // Placeholder: mostrá un aviso hasta conectar el proveedor real.
  const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
  form?.addEventListener("submit", () => {
    alert("Formulario de ejemplo. Conectá tu proveedor de newsletter para activarlo.");
  });
</script>
