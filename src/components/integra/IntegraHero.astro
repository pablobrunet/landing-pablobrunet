---
/* =====================================================================
   HERO — Método INTEGRA
   ---------------------------------------------------------------------
   Está diseñado para TRÁFICO FRÍO: no asume que conocen a Pablo. Abre por
   el dolor, nunca por "capacidad instalada" — esa idea recién se entiende
   después del reencuadre.

   Va una foto, no un video: todavía no hay VSL grabado. Cuando lo haya,
   esta misma imagen sirve de portada y se le monta el reproductor encima.

   La imagen se importa desde src/assets (no desde public/) para que pase
   por el optimizador de Astro: el original son 3,2 MB de cámara, y así
   sale en webp y en tres anchos según la pantalla.
   ===================================================================== */
import { Image } from "astro:assets";
import { integra } from "../../data/integra";
import portada from "../../assets/hero/integra1.jpg";
const { hero, imagen, anclas } = integra;
---

<section class="ih" aria-label="Método INTEGRA">
  <div class="ih__fondo" aria-hidden="true">
    <span class="ih__halo ih__halo--a"></span>
    <span class="ih__halo ih__halo--b"></span>
    <span class="trama ih__trama"></span>
  </div>

  <div class="container ih__inner">
    <div class="ih__copy">
      <p class="ih__chip">{hero.chip}</p>

      <h1 class="t-display ih__titulo">
        {hero.titulo}
        <span class="i-hl">{hero.tituloResalte}</span>
      </h1>

      <p class="ih__sub">{hero.subtitulo}</p>

      <div class="ih__ctas">
        <a href={`#${anclas.agenda}`} class="btn btn--primary ih__cta">{hero.ctaPrimario}</a>
        <a href={`#${anclas.chequeo}`} class="btn ih__ghost">{hero.ctaSecundario}</a>
      </div>
      <p class="ih__nota">{hero.ctaPrimarioNota}</p>

      <ul class="ih__confianza">
        {
          hero.confianza.map((c) => (
            <li class="ih__conf">
              {c.tipo === "logo" && c.img ? (
                <span class="ih__conf-logo">
                  {/* width/height respetan la proporción real del PNG
                      (1125×531 ≈ 2,12:1) para que no haya salto al cargar. */}
                  <img src={c.img} alt="" width="212" height="100" loading="eager" />
                </span>
              ) : (
                <span class="ih__conf-punto" aria-hidden="true" />
              )}
              <span>{c.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ih__media">
      <figure class="foto">
        {/* `width` acota el src de reserva: sin él Astro lo genera al
            tamaño original (4032px = 405 kB) y esa es la URL que termina
            en el atributo src. Con 1040 el peor caso son 60 kB. */}
        <Image
          src={portada}
          alt={imagen.alt}
          width={1040}
          height={780}
          widths={[520, 760, 1040]}
          sizes="(min-width: 980px) 42vw, 92vw"
          formats={["webp"]}
          quality={72}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .ih {
    position: relative;
    overflow: hidden;
    background: var(--i-noche);
    color: #fff;
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3rem, 7vw, 5rem);
  }

  /* ---- Fondo: dos halos de luz + trama fina, todo detrás del contenido ---- */
  .ih__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ih__halo {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .ih__halo--a {
    width: 46rem;
    height: 46rem;
    top: -22rem;
    right: -14rem;
    background: radial-gradient(circle, rgba(76, 134, 245, 0.55), transparent 70%);
  }
  .ih__halo--b {
    width: 34rem;
    height: 34rem;
    bottom: -18rem;
    left: -12rem;
    background: radial-gradient(circle, rgba(30, 92, 242, 0.5), transparent 70%);
  }
  .ih__trama {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(80% 60% at 50% 0%, #000 0%, transparent 75%);
    mask-image: radial-gradient(80% 60% at 50% 0%, #000 0%, transparent 75%);
  }

  .ih__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    align-items: center;
  }

  /* ---- Columna de texto ---- */
  .ih__chip {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    margin-bottom: 1.35rem;
    border-radius: var(--radius-pill);
    background: rgba(169, 200, 245, 0.1);
    border: 1px solid rgba(169, 200, 245, 0.28);
    color: var(--i-neblina);
    font-size: 0.8125rem;
    font-weight: var(--w-subheadline);
    line-height: 1.35;
  }
  .ih__titulo {
    font-size: clamp(2.05rem, 1.1rem + 3.6vw, 3.6rem);
    line-height: 1.06;
  }
  .ih__titulo .i-hl {
    display: block;
  }
  .ih__sub {
    max-width: 40rem;
    margin-top: 1.35rem;
    font-size: 1.0625rem;
    line-height: 1.68;
    color: rgba(220, 230, 246, 0.8);
  }
  .ih__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .ih__cta {
    padding-inline: 1.7rem;
  }
  .ih__ghost {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }
  .ih__ghost:hover {
    background: rgba(255, 255, 255, 0.13);
  }
  .ih__nota {
    margin-top: 0.9rem;
    font-size: var(--fs-caption);
    color: rgba(220, 230, 246, 0.65);
  }

  /* ---- Franja de confianza ---- */
  .ih__confianza {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .ih__conf {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.95rem;
    font-weight: var(--w-subheadline);
    color: var(--i-neblina);
  }
  /* La insignia oficial viene pensada para fondo claro: va sobre una
     píldora blanca para que no se coma sobre el azul profundo.
     Es la única credencial verificable de la franja, así que se dibuja
     grande: a 26px de alto el logo no se llegaba a leer. */
  .ih__conf-logo {
    display: grid;
    place-items: center;
    padding: 0.6rem 0.95rem;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(6, 12, 30, 0.35);
  }
  .ih__conf-logo img {
    height: clamp(38px, 3.4vw, 52px);
    width: auto;
  }
  .ih__conf-punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--i-celeste);
    flex-shrink: 0;
  }

  /* ---- Foto ---- */
  .foto {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(150deg, #17408f, #0a1430 70%);
    box-shadow: 0 30px 70px rgba(6, 12, 30, 0.55);
    transition: transform 500ms cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 500ms cubic-bezier(0.2, 0.7, 0.3, 1),
      border-color 500ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El zoom va sobre la imagen y no sobre el marco: así el borde
       redondeado queda quieto y sólo se acerca el contenido. */
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  /* Velo azul que se disipa al pasar el mouse: la foto "se enciende". */
  .foto::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(30, 92, 242, 0.28), rgba(10, 20, 48, 0.42));
    opacity: 1;
    transition: opacity 500ms ease;
    pointer-events: none;
  }
  .foto:hover {
    transform: translateY(-6px);
    border-color: rgba(169, 200, 245, 0.45);
    box-shadow: 0 38px 84px rgba(6, 12, 30, 0.62), 0 0 0 1px rgba(169, 200, 245, 0.18);
  }
  .foto:hover :global(img) {
    transform: scale(1.06);
  }
  .foto:hover::after {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .foto,
    .foto :global(img),
    .foto::after {
      transition: none;
    }
    .foto:hover,
    .foto:hover :global(img) {
      transform: none;
    }
  }

  @media (min-width: 980px) {
    .ih__inner {
      grid-template-columns: 1.08fr 0.92fr;
      gap: 3.5rem;
    }
  }
</style>
