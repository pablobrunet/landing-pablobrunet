---
/* =====================================================================
   DE HOY AL DÍA 60 · v4 — de uso aislado a un sistema real
   ---------------------------------------------------------------------
   A la izquierda, "Hoy": siete problemas en tarjetitas escalonadas, con
   ícono. Una flecha lleva a la derecha, "Día 60": una tarjeta oscura con
   el resultado en una frase y cuatro tarjetas chicas, cada una con un
   ejemplo de cómo se ve (la lista de mejoras, una prueba con su
   decisión, quién hace qué y la semana de trabajo).

   Sólo colores de la paleta INTEGRA: hoy va en grises y azules apagados;
   el día 60 en azul intenso. El contraste cuenta el antes y el después.

   Al bajar entra primero la columna de hoy; apenas se avanza un poco
   más, entra todo lo de la derecha. Sin JavaScript o con movimiento
   reducido se ve todo de entrada: la animación sólo corre si el script
   agrega `rs--js`.

   Debajo, la cita del cliente en una franja gris a todo el ancho, que
   cierra la sección. Sin foto ni comillas gigantes: el texto solo, grande.
   ===================================================================== */
import { integra } from "../../data/integra";
import { integra2 } from "../../data/integra2";
const { resultado: r, anclas } = integra2;
/* La cita es la del cliente real de la v1: no se reescribe. */
const { cita, citaPie } = integra.instalado;
/* "Miguel S. - Dueño de PyME" → nombre y rol en dos líneas. */
const [citaNombre, citaRol] = citaPie.split(/\s+-\s+/);

/* Íconos de la columna de hoy (trazo, 24×24). */
const iconos: Record<string, string> = {
  persona: '<circle cx="12" cy="8" r="4" /><path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6" />',
  charla:
    '<path d="M4 5h10a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9l-4 3v-3H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z" /><path d="M18 9h2a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-1v3l-4-3h-3" />',
  hoja: '<path d="M6 3h8l4 4v14H6z" /><path d="M14 3v4h4 M9 12h6 M9 16h4" />',
  equipo:
    '<circle cx="12" cy="8" r="3" /><circle cx="5" cy="10" r="2.2" /><circle cx="19" cy="10" r="2.2" /><path d="M7 20c.8-3 2.8-5 5-5s4.2 2 5 5 M1.5 18c.5-2 1.8-3.4 3.5-3.4 M22.5 18c-.5-2-1.8-3.4-3.5-3.4" />',
  brujula: '<circle cx="12" cy="12" r="9" /><path d="M15.5 8.5l-2 5-5 2 2-5z" />',
  reloj: '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />',
  bateria:
    '<rect x="2" y="7" width="17" height="10" rx="2" /><path d="M22 10.5v3" /><rect x="4.5" y="9.5" width="3.5" height="5" rx="0.6" fill="currentColor" stroke="none" />',
};
/* Avatar relleno para "quién hace qué". */
const avatar = '<circle cx="12" cy="8" r="4.2" /><path d="M3.5 21c1.2-4.6 4.6-7 8.5-7s7.3 2.4 8.5 7z" />';
---

<section class="section i-claro rs" aria-label="De cómo está hoy a cómo queda al día 60">
  <div class="container">
    <header class="rs__head i-reveal">
      <p class="rs__eyebrow">{r.eyebrow} <strong>{r.eyebrowResalte}</strong></p>
      <h2 class="t-h2">
        {r.titulo} <span class="i-hl">{r.tituloResalte}</span>
      </h2>
      <p class="text-muted">{r.subtitulo}</p>
    </header>
  </div>

  <div class="rs__grid" data-rs>
    {/* ================= HOY ================= */}
    <div class="rs__hoy" data-rs-hoy>
      <p class="rs__rotulo">{r.etiquetaAntes}</p>
      <ul class="rs__hoy-lista">
        {
          r.hoy.map((h, i) => (
            <li class="rs__prob" style={`--i:${i}`}>
              <span class="rs__prob-ico" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={iconos[h.icono]}
                />
              </span>
              <p>{h.texto}</p>
              {i % 2 === 0 && (
                <svg class="rs__tension" viewBox="0 0 20 28" width="18" height="26" aria-hidden="true">
                  <path d="M4 7l7-5 M4 14h11 M4 21l7 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                </svg>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    {/* ================= FLECHA ================= */}
    <div class="rs__puente" aria-hidden="true">
      <span class="rs__flecha">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14 M13 6l6 6-6 6" /></svg>
      </span>
    </div>

    {/* ================= DÍA 60 ================= */}
    <div class="rs__der" data-rs-der>
      <article class="rs__oscura rs__pieza" style="--i:0">
        <p class="rs__rotulo rs__rotulo--oscuro">{r.etiquetaDespues}</p>
        <h3 class="rs__oscura-t">
          {r.dia60.titulo} <span>{r.dia60.tituloResalte}</span>
        </h3>
        <p class="rs__oscura-p">{r.dia60.texto}</p>
        <p class="rs__oscura-pie">{r.dia60.pie}</p>
        <span class="rs__arco" aria-hidden="true"></span>
      </article>

      <div class="rs__tarjetas">
        {/* Lista de mejoras */}
        <article class="rs__tarjeta rs__pieza" style="--i:1">
          <h3 class="rs__t">{r.lista.titulo}</h3>
          <p class="rs__p">{r.lista.texto}</p>
          <div class="rs__mock" aria-hidden="true">
            <p class="rs__mock-t">{r.lista.cabecera}</p>
            <ul class="rs__lista">
              {
                r.lista.filas.map((f) => (
                  <li class={`rs__prio--${f.prioridad.toLowerCase()}`}>
                    <span class="rs__punto" />
                    <span class="rs__lista-area">{f.area}</span>
                    <span class="rs__pill">{f.prioridad}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>

        {/* Prueba con su decisión */}
        <article class="rs__tarjeta rs__pieza" style="--i:2">
          <h3 class="rs__t">{r.pruebas.titulo}</h3>
          <p class="rs__p">{r.pruebas.texto}</p>
          <div class="rs__mock" aria-hidden="true">
            <p class="rs__mock-t">{r.pruebas.cabecera}</p>
            <ul class="rs__pasos">
              {
                r.pruebas.pasos.map((p) => (
                  <li>
                    <span class="rs__radio" />
                    {p}
                  </li>
                ))
              }
              <li class="rs__pasos-dec">
                <span class="rs__radio rs__radio--on" />
                <strong>{r.pruebas.decision}</strong>
                <span class="rs__select">
                  {r.pruebas.opcion}
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
                </span>
              </li>
            </ul>
          </div>
        </article>

        {/* Quién hace qué */}
        <article class="rs__tarjeta rs__pieza" style="--i:3">
          <h3 class="rs__t">{r.equipo.titulo}</h3>
          <p class="rs__p">{r.equipo.texto}</p>
          <div class="rs__mock" aria-hidden="true">
            <ul class="rs__equipo">
              {
                r.equipo.filas.map((f) => (
                  <li>
                    <span class={`rs__avatar rs__avatar--${f.tono}`}>
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" set:html={avatar} />
                    </span>
                    <span class="rs__equipo-area">{f.area}</span>
                    <span class="rs__pill rs__pill--rol">{f.hace}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>

        {/* La semana de trabajo */}
        <article class="rs__tarjeta rs__pieza" style="--i:4">
          <h3 class="rs__t">{r.ritmo.titulo}</h3>
          <p class="rs__p">{r.ritmo.texto}</p>
          <div class="rs__mock" aria-hidden="true">
            <p class="rs__mock-t rs__mock-t--fila">
              {r.ritmo.cabecera}
              <span>{r.ritmo.rango}</span>
            </p>
            <div class="rs__dias">
              {r.ritmo.dias.map((d, i) => <span class={i === r.ritmo.diaActivo ? "is-activo" : ""}>{d}</span>)}
            </div>
            <ul class="rs__eventos">
              {
                r.ritmo.eventos.map((e, i) => (
                  <li class={i === 0 ? "" : "rs__eventos--suave"}>
                    <span class="rs__ev-punto" />
                    <div>
                      <p>
                        <strong>{e.t}</strong>
                        {e.hora && <span>{e.hora}</span>}
                      </p>
                      <span class="rs__barra" />
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </article>
      </div>
    </div>
  </div>

  <div class="rs__franja">
    <div class="container">
      <figure class="rs__cita i-reveal">
        <blockquote>{cita}</blockquote>
        <div class="rs__cita-pie">
          <figcaption>
            <strong>{citaNombre}</strong>
            {citaRol && <span>{citaRol}</span>}
          </figcaption>
          <a href={`#${anclas.agenda}`} class="btn btn--primary">{r.cta}</a>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  /* ============================ ENCABEZADO ============================ */
  .rs__head {
    max-width: 820px;
    margin: 0 auto clamp(2.25rem, 5vw, 3.25rem);
    text-align: center;
  }
  .rs__eyebrow {
    font-size: 0.75rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }
  .rs__eyebrow strong {
    color: var(--i-azul-600);
    font-weight: var(--w-display);
  }
  .rs__head h2 {
    margin-top: 0.7rem;
    font-size: clamp(1.9rem, 1.2rem + 2.8vw, 3.2rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .rs__head .text-muted {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  /* ============================== GRILLA ==============================
     Más ancha que el container del sitio: son cuatro columnas. */
  .rs__grid {
    display: grid;
    width: min(1400px, 100% - 2 * var(--gutter));
    margin-inline: auto;
  }
  .rs__rotulo {
    font-size: 0.8rem;
    font-weight: var(--w-display);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  /* ---- Columna de hoy: todo en grises azulados, apagado ---- */
  .rs__hoy {
    padding: 1.4rem 1.1rem 1.25rem;
    border-radius: 20px;
    background: var(--i-hielo);
    border: 1px solid var(--borde);
  }
  .rs__hoy > .rs__rotulo {
    padding: 0 0.4rem 1rem;
    border-bottom: 1px solid var(--borde);
  }
  .rs__hoy-lista {
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
    display: grid;
    gap: 0.85rem;
  }
  .rs__prob {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-right: 1.4rem;
    padding: 0.95rem 1rem;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 6px 20px rgba(13, 27, 61, 0.06);
  }
  .rs__prob:nth-child(even) {
    margin-right: 0;
    margin-left: 1.4rem;
  }
  .rs__prob p {
    font-size: 0.93rem;
    line-height: 1.45;
    color: var(--texto-suave);
  }
  .rs__prob-ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--i-hielo);
    border: 1px solid var(--borde);
    color: #8a9ab8;
  }
  /* Rayitas de "esto molesta" al costado de algunos problemas. */
  .rs__tension {
    position: absolute;
    top: -0.35rem;
    right: -1.3rem;
    color: var(--borde-punteado);
  }

  /* ---- Flecha ---- */
  .rs__puente {
    position: relative;
    display: grid;
    place-items: center;
    height: 4.5rem;
  }
  .rs__puente::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: var(--borde);
  }
  .rs__flecha {
    position: relative;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--borde);
    box-shadow: 0 6px 18px rgba(13, 27, 61, 0.1);
    color: var(--i-azul-600);
    transform: rotate(90deg);
  }

  /* ---- Derecha: tarjeta oscura + cuatro tarjetas ---- */
  .rs__der {
    display: grid;
    gap: 1rem;
  }
  .rs__oscura {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border-radius: 22px;
    background: var(--i-navy);
    /* El título se mide contra el ancho de la tarjeta, no de la pantalla. */
    container-type: inline-size;
    color: #fff;
    box-shadow: 0 24px 50px -20px rgba(13, 27, 61, 0.55);
  }
  .rs__rotulo--oscuro {
    position: relative;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid rgba(169, 200, 245, 0.22);
    color: var(--i-celeste);
  }
  .rs__oscura-t {
    position: relative;
    margin-top: clamp(1.8rem, 5vw, 3.6rem);
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: clamp(1.9rem, 16cqi, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .rs__oscura-t span {
    color: var(--i-azul-500);
  }
  .rs__oscura-p {
    position: relative;
    margin-top: 1.6rem;
    padding-top: 1.6rem;
    max-width: 24rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(220, 230, 246, 0.85);
  }
  .rs__oscura-p::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 2.6rem;
    height: 2px;
    background: var(--i-azul-500);
  }
  .rs__oscura-pie {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: auto;
    padding-top: 2.2rem;
    max-width: 15rem;
    font-size: 0.72rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.2em;
    line-height: 1.6;
    text-transform: uppercase;
    color: rgba(220, 230, 246, 0.8);
  }
  .rs__oscura-pie::before {
    content: "";
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--i-azul-600);
  }
  /* Un arco grande abajo a la derecha, apenas más claro que el fondo. */
  .rs__arco {
    position: absolute;
    right: -45%;
    bottom: -48%;
    width: 110%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(30, 92, 242, 0.16);
    box-shadow: 0 0 0 3.5rem rgba(30, 92, 242, 0.07);
    pointer-events: none;
  }

  .rs__tarjetas {
    display: grid;
    gap: 1rem;
  }
  .rs__tarjeta {
    display: flex;
    flex-direction: column;
    padding: 1.35rem 1.35rem 1.25rem;
    border-radius: 18px;
    background: var(--i-hielo-2);
    border: 1px solid var(--borde);
  }
  .rs__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--azul-petroleo);
  }
  .rs__p {
    margin-top: 0.4rem;
    margin-bottom: 1.1rem;
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }
  /* El "ejemplo" de cada tarjeta: una cajita blanca abajo. */
  .rs__mock {
    margin-top: auto;
    padding: 1rem 1rem 0.9rem;
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 6px 20px rgba(13, 27, 61, 0.06);
    font-size: 0.8rem;
    color: var(--azul-petroleo);
  }
  .rs__mock-t {
    margin-bottom: 0.75rem;
    font-size: 0.85rem;
    font-weight: var(--w-headline);
  }
  .rs__mock-t--fila {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .rs__mock-t--fila span {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--texto-suave);
  }
  .rs__pill {
    flex-shrink: 0;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: var(--w-subheadline);
    white-space: nowrap;
  }
  .rs__pill--rol {
    background: var(--i-neblina);
    color: var(--i-azul-800);
  }

  .rs__lista,
  .rs__pasos,
  .rs__equipo,
  .rs__eventos {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Lista de mejoras: la prioridad se lee por la intensidad del azul. */
  .rs__lista li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0;
  }
  .rs__lista li + li {
    border-top: 1px solid var(--i-hielo);
  }
  .rs__punto {
    flex-shrink: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .rs__lista-area {
    flex: 1;
    color: var(--texto-suave);
  }
  .rs__prio--alta .rs__punto {
    background: var(--i-azul-600);
  }
  .rs__prio--alta .rs__pill {
    background: var(--i-azul-600);
    color: #fff;
  }
  .rs__prio--media .rs__punto {
    background: var(--i-denim);
  }
  .rs__prio--media .rs__pill {
    background: var(--i-neblina);
    color: var(--i-azul-800);
  }
  .rs__prio--baja .rs__punto {
    background: var(--i-celeste);
  }
  .rs__prio--baja .rs__pill {
    background: var(--i-hielo);
    color: var(--texto-suave);
  }

  /* Prueba con su decisión */
  .rs__pasos li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0;
    color: var(--texto-suave);
  }
  .rs__radio {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--borde-punteado);
  }
  .rs__radio--on {
    width: 24px;
    height: 24px;
    margin-left: -3px;
    border: 3px solid var(--i-celeste);
    background: var(--i-azul-600);
    box-shadow: inset 0 0 0 2px #fff;
  }
  .rs__pasos-dec strong {
    color: var(--azul-petroleo);
    font-weight: var(--w-headline);
  }
  .rs__select {
    flex-shrink: 0;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    background: var(--i-neblina);
    color: var(--verde-resalte);
    font-weight: var(--w-headline);
    box-shadow: 0 4px 12px rgba(30, 92, 242, 0.12);
  }

  /* Quién hace qué: cuatro azules de la paleta. */
  .rs__equipo li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.35rem 0;
  }
  .rs__avatar {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--i-neblina);
  }
  .rs__avatar--intenso {
    color: var(--i-azul-600);
  }
  .rs__avatar--denim {
    color: var(--i-denim);
  }
  .rs__avatar--marino {
    color: var(--i-navy);
  }
  .rs__avatar--claro {
    color: var(--i-azul-500);
  }
  .rs__equipo-area {
    flex: 1;
    font-weight: var(--w-subheadline);
  }

  /* La semana de trabajo */
  .rs__dias {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.4rem;
    margin-bottom: 0.9rem;
  }
  .rs__dias span {
    padding: 0.4rem 0;
    border-radius: 8px;
    background: var(--i-hielo);
    text-align: center;
    font-size: 0.72rem;
    color: var(--texto-suave);
  }
  .rs__dias .is-activo {
    background: var(--i-azul-600);
    color: #fff;
    font-weight: var(--w-headline);
  }
  .rs__eventos li {
    position: relative;
    display: flex;
    gap: 0.75rem;
    padding-bottom: 0.8rem;
  }
  .rs__eventos li:first-child::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 14px;
    bottom: 0;
    width: 1px;
    background: var(--borde);
  }
  .rs__ev-punto {
    flex-shrink: 0;
    width: 11px;
    height: 11px;
    margin-top: 2px;
    border-radius: 50%;
    background: var(--i-azul-600);
  }
  .rs__eventos--suave .rs__ev-punto {
    background: var(--i-celeste);
  }
  .rs__eventos div {
    flex: 1;
  }
  .rs__eventos p {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .rs__eventos p span {
    flex-shrink: 0;
    white-space: nowrap;
    color: var(--texto-suave);
    font-size: 0.72rem;
  }
  .rs__barra {
    display: block;
    width: 45%;
    height: 7px;
    margin-top: 0.45rem;
    border-radius: 4px;
    background: var(--i-hielo);
  }
  .rs__eventos--suave .rs__barra {
    width: 65%;
  }

  /* ============================ TAMAÑOS ============================ */
  @media (min-width: 640px) {
    .rs__tarjetas {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 900px) {
    .rs__grid {
      grid-template-columns: minmax(280px, 0.8fr) 64px 2.4fr;
      align-items: stretch;
    }
    /* La columna de hoy acompaña el alto de la derecha: si sobra lugar,
       los problemas se reparten en vez de dejar un hueco abajo. */
    .rs__hoy {
      display: flex;
      flex-direction: column;
    }
    .rs__hoy-lista {
      flex: 1;
      align-content: space-between;
    }
    .rs__puente {
      height: auto;
    }
    .rs__flecha {
      transform: none;
    }
  }
  @media (min-width: 1200px) {
    .rs__der {
      grid-template-columns: 1fr 1.55fr;
    }
  }

  /* ============================ ANIMACIÓN ============================
     Primero entra la columna de hoy (cada problema escalonado); después
     la flecha y todo lo de la derecha. */
  .rs__hoy,
  .rs__prob,
  .rs__pieza,
  .rs__flecha {
    transition:
      opacity 650ms cubic-bezier(0.2, 0.7, 0.3, 1),
      transform 650ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .rs__prob,
  .rs__pieza {
    transition-delay: calc(150ms + var(--i) * 110ms);
  }
  .rs--js .rs__hoy:not(.is-on) {
    opacity: 0;
    transform: translateY(24px);
  }
  .rs--js .rs__hoy:not(.is-on) .rs__prob {
    opacity: 0;
    transform: translateX(-18px);
  }
  .rs--js:not(.der-on) .rs__flecha {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  .rs--js:not(.der-on) .rs__pieza {
    opacity: 0;
    transform: translateY(24px);
  }
  @media (min-width: 900px) {
    .rs--js:not(.der-on) .rs__flecha {
      transform: translateX(-12px) scale(0.6);
    }
    .rs--js:not(.der-on) .rs__pieza {
      transform: translateX(32px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rs__hoy,
    .rs__prob,
    .rs__pieza,
    .rs__flecha {
      transition: none;
    }
  }

  /* ======================= CITA DEL CLIENTE =======================
     Franja en el mismo gris que "Así se vive desde adentro" (--i-hielo), a todo el ancho y
     pegada al pie: se come el padding de abajo de .section y lo repone
     adentro. La cita va en tinta oscura, con una línea azul a la izquierda. */
  .rs__franja {
    margin: clamp(3rem, 6vw, 4.5rem) 0 calc(-1 * var(--section-y));
    padding-block: clamp(3rem, 6vw, 4.75rem);
    background: var(--i-hielo);
    border-top: 1px solid var(--borde);
  }
  .rs__cita {
    max-width: 920px;
    margin: 0 auto;
  }
  .rs__cita blockquote {
    margin: 0;
    padding-left: clamp(1.1rem, 3vw, 1.75rem);
    border-left: 3px solid var(--i-azul-600);
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    font-size: clamp(1.25rem, 1rem + 1.1vw, 1.8rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--i-navy);
    text-wrap: pretty;
  }
  .rs__cita-pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding: 1.4rem 0 0 clamp(1.1rem, 3vw, 1.75rem);
    border-top: 1px solid #cfd7e3;
  }
  .rs__cita figcaption {
    display: grid;
    gap: 0.15rem;
    font-size: 0.95rem;
    line-height: 1.35;
  }
  .rs__cita figcaption strong {
    font-weight: var(--w-display);
    color: var(--i-navy);
  }
  .rs__cita figcaption span {
    color: var(--texto-suave);
  }
</style>

<script>
  /* La columna de hoy entra cuando su borde de arriba pasa el 85% de la
     pantalla; lo de la derecha, recién cuando pasa el 55%. Así, en
     escritorio (donde están en la misma fila) se ve primero la izquierda
     y apenas se baja un poco más aparece el resto. Una vez adentro,
     volver a subir no lo esconde. */
  function initResultado() {
    const raiz = document.querySelector<HTMLElement>("[data-rs]");
    if (!raiz || raiz.dataset.listo) return;
    raiz.dataset.listo = "1";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!("IntersectionObserver" in window)) return;

    const hoy = raiz.querySelector<HTMLElement>("[data-rs-hoy]");
    const der = raiz.querySelector<HTMLElement>("[data-rs-der]");
    if (!hoy || !der) return;
    raiz.classList.add("rs--js");

    const obsHoy = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        hoy.classList.add("is-on");
        obsHoy.disconnect();
      },
      { rootMargin: "0px 0px -15% 0px" }
    );
    const obsDer = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        hoy.classList.add("is-on");
        raiz.classList.add("der-on");
        obsDer.disconnect();
      },
      { rootMargin: "0px 0px -45% 0px" }
    );
    obsHoy.observe(hoy);
    obsDer.observe(der);
  }

  initResultado();
  document.addEventListener("astro:page-load", initResultado);
</script>
