---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import { resaltar } from "../lib/texto";
const { hero } = site;
---

<section class="hero section--dark" aria-label="Presentación">
  <!-- Foto de una charla (Foro Campo IA) como fondo, bajo un velo azul petróleo que se carga
       más del lado del texto. La foto es oscura: sobre fondo oscuro se lee
       entera, y el texto pasa a blanco. Es decorativa: alt vacío. -->
  <div class="hero__fondo" aria-hidden="true">
    <img
      class="hero__foto"
      src="/images/pablo/foro-campo-ia.webp"
      alt=""
      width="1376"
      height="680"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <span class="hero__velo"></span>
  </div>

  <!-- Trama abajo a la izquierda, del lado del texto: nada de decoración
       cruzando por detrás del retrato. -->
  <span class="hero__trama trama" aria-hidden="true"></span>

  <div class="container hero__inner">
    <div class="hero__copy">
      <!-- Insignia + etiqueta: la imagen aporta el sello, el texto explica
           qué es. Enlaza a la sección donde está desarrollado. -->
      <a class="hero__cred" href={hero.badgeHref}>
        <img
          class="hero__cred-img"
          src={hero.badgeImg}
          alt={hero.badgeAlt}
          width="816"
          height="311"
        />
        <span class="hero__cred-txt">
          <strong>{hero.badgeTitulo}</strong>
          <span>{hero.badgeDetalle}</span>
        </span>
      </a>

      <h1 class="t-display hero__title" set:html={resaltar(hero.titulo)} />

      <div class="hero__sub">
        {hero.subtitulo.map((par) => <p class="t-subhead text-muted">{par}</p>)}
      </div>

      <div class="hero__ctas">
        {
          hero.ctas.map((c) => (
            <a href={c.href} class:list={["btn", c.primary ? "btn--primary" : "btn--outline"]}>
              {c.label}
              {c.primary && <Icon name="arrow" size={18} />}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hero__media">
      <!-- Retrato recortado, sin marco: apoya en el borde inferior del hero,
           igual que la foto de fondo. -->
      <img
        class="hero__retrato"
        src={hero.img}
        alt={`Retrato de ${site.nombre}`}
        width="1024"
        height="1024"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Sin padding abajo: el retrato apoya en el mismo borde que la foto de
       fondo. El texto recupera ese aire con su propio padding. */
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: 0;
    background: var(--azul-petroleo);
  }
  .hero__fondo {
    position: absolute;
    inset: 0;
  }
  .hero__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Encuadre sobre el escenario y el público, no sobre el techo. */
    object-position: center 60%;
  }
  /* Velo: petróleo denso detrás del texto (contraste AA de sobra para el
     blanco) y más liviano hacia la derecha, donde el auditorio se ve. */
  .hero__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(11, 31, 42, 0.9) 0%, rgba(11, 31, 42, 0.78) 42%, rgba(11, 31, 42, 0.45) 100%),
      linear-gradient(180deg, rgba(11, 31, 42, 0.35) 0%, transparent 30%, transparent 75%, rgba(11, 31, 42, 0.6) 100%);
  }
  /* En celular el texto ocupa todo el ancho: velo parejo y un poco más denso. */
  @media (max-width: 899px) {
    .hero__velo {
      background: linear-gradient(180deg, rgba(11, 31, 42, 0.86), rgba(11, 31, 42, 0.72));
    }
  }
  .hero__trama {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(30%, 340px);
    height: 46%;
    opacity: 0.25;
    -webkit-mask-image: linear-gradient(25deg, #000, transparent 62%);
    mask-image: linear-gradient(25deg, #000, transparent 62%);
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__copy {
    max-width: 620px;
  }
  /* ---- Insignia + etiqueta ----
     Se lee como una unidad: sello a la izquierda, qué significa a la derecha,
     separados por una regla fina. Tipografía chica y en gris: es una marca de
     credibilidad, no un titular, y no debe competir con el H1. */
  .hero__cred {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    /* Sin ficha: se lee como una línea de texto más, apoyada sobre la foto. */
    transition: opacity var(--transition);
  }
  .hero__cred:hover {
    opacity: 0.8;
  }
  /* Alto fijo y ancho automático: la insignia nunca se recorta ni se deforma. */
  .hero__cred-img {
    height: 30px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
    /* Versión del sello sólo con logo y letras en blanco, sin marco ni fondo. */
    opacity: 0.9;
  }
  .hero__cred-txt {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-left: 0.85rem;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
    line-height: 1.3;
  }
  .hero__cred-txt strong {
    font-size: 0.8rem;
    font-weight: var(--w-headline);
    color: rgba(255, 255, 255, 0.9);
  }
  .hero__cred-txt span {
    font-size: 0.76rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* En pantallas chicas la etiqueta pasa debajo para no comprimir la insignia. */
  @media (max-width: 420px) {
    .hero__cred {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
    .hero__cred-txt {
      padding-left: 0;
      border-left: 0;
    }
  }
  .hero__title {
    margin: 1.25rem 0 1rem;
    color: var(--blanco);
    /* Un punto por debajo del display general. */
    font-size: clamp(2rem, 1.25rem + 2.6vw, 3.2rem);
  }
  .hero__sub {
    max-width: 52ch;
  }
  /* El primer párrafo abre y va un punto más grande; el segundo desarrolla.
     Misma familia y color: la jerarquía la da solo el cuerpo. */
  .hero__sub p:first-child {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.9);
  }
  .hero__sub p + p {
    margin-top: 0.85rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }
  .hero__media {
    max-width: 570px;
    width: 100%;
    justify-self: center;
    /* Siempre pegado abajo, aunque el texto sea más alto que la foto. */
    align-self: end;
  }
  .hero__retrato {
    display: block;
    width: 100%;
    height: auto;
    /* drop-shadow sigue el contorno del PNG (box-shadow dibujaría la caja):
       un halo oscuro y amplio que despega la figura del auditorio del fondo. */
    filter: drop-shadow(0 0 2px rgba(0, 0, 0, 0.35)) drop-shadow(0 0 28px rgba(0, 0, 0, 0.45));
  }

  @media (min-width: 900px) {
    /* Columna de texto un poco más ancha, para que el título corra más a la
       derecha; el retrato ya no depende del ancho de su columna. */
    .hero__inner {
      grid-template-columns: 1.08fr 0.92fr;
    }
    .hero__copy {
      max-width: 680px;
      /* Mismo aire abajo que arriba: el texto queda centrado respecto de la foto. */
      padding-bottom: clamp(2.5rem, 6vw, 5rem);
    }
    /* El retrato toma el alto de la columna de texto: arranca apenas debajo de
       la insignia y apoya en el borde inferior. El ancho sale solo de la
       proporción (nunca se estira) y se centra en su columna: los márgenes
       transparentes del PNG pueden desbordar hacia el hueco entre columnas. */
    .hero__media {
      max-width: none;
      justify-self: stretch;
      align-self: stretch;
      position: relative;
    }
    .hero__retrato {
      position: absolute;
      bottom: 0;
      left: 50%;
      width: auto;
      max-width: none;
      /* Puede subir por encima de la insignia, dentro del aire superior del hero. */
      height: calc(100% + 3.5rem);
      transform: translateX(-50%);
    }
  }

  /* Monitores grandes: el hero entero (texto, botones, insignia y retrato)
     crece un 20% en bloque, así mantiene las proporciones de la notebook en
     lugar de quedar chato. `zoom` escala también el ancho máximo del
     contenedor; el aire de arriba se agranda a mano porque es de la sección. */
  @media (min-width: 1600px) {
    .hero {
      padding-top: 6rem;
    }
    .hero__inner {
      zoom: 1.2;
    }
  }
</style>
