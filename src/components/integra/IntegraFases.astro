---
/* =====================================================================
   EL MÉTODO — las siete fases INTEGRA
   ---------------------------------------------------------------------
   Es la sección que tiene que demostrar que hay un método atrás. Dos
   decisiones de diseño sostienen eso:

   1) SECUENCIA, NO BLOQUES SUELTOS. Las siete letras van sobre un riel
      con su número de orden (01…07) y una barra de progreso que avanza
      con la fase elegida. Antes eran siete cuadrados iguales flotando,
      que se leían como bloques de juguete: nada indicaba que fuera un
      recorrido con principio y final.

   2) FICHA TÉCNICA, NO TARJETA. El panel se abre con una cabecera oscura
      que dice en qué fase estás ("Fase 03 de 07") y sigue con la pregunta
      que ordena esa fase y su desarrollo. La forma es la de un documento
      de trabajo, que es exactamente lo que se está vendiendo.

   Se sacaron las letras con degradé: el texto relleno con gradiente es el
   recurso que más rápido delata una plantilla y le quitaba seriedad a lo
   único que la sección tiene que transmitir.

   SIN JAVASCRIPT. Son radios + labels: el estado vive en el :checked y el
   CSS muestra el panel que corresponde. Funciona apenas se pinta el HTML,
   anda con las flechas del teclado —comportamiento nativo de un grupo de
   radios— y no depende de ningún bundle.

   ALTURA FIJA. Los siete paneles se apilan en la misma celda de grid, así
   que el bloque mide siempre lo mismo que el más largo y no salta al
   cambiar de letra. Los inactivos van con `visibility: hidden`, que
   además los saca del árbol de accesibilidad.
   ===================================================================== */
import { integra } from "../../data/integra";
const { metodo, anclas } = integra;

const fases = metodo.fases;
const cols = fases.length;
const dosDigitos = (n: number) => String(n).padStart(2, "0");
---

<section class="section i-hielo i-claro" id={anclas.metodo} aria-label="El método INTEGRA">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{metodo.eyebrow}</span>
      <h2 class="t-h2">{metodo.titulo}</h2>
      <p class="text-muted">{metodo.subtitulo}</p>
    </header>

    <div class="ft i-reveal" style={`--cols:${cols}`}>
      {/* Los radios van sueltos y antes de todo: el CSS necesita que sean
          hermanos del riel y del panel para alcanzarlos con ~. */}
      {
        fases.map((f, i) => (
          <input
            class="ft__radio"
            type="radio"
            name="fase-integra"
            id={`fase-${f.letra}`}
            value={f.letra}
            checked={i === 0}
          />
        ))
      }

      <div class="ft__barra">
        <span class="ft__barra-linea" aria-hidden="true"></span>
        <span class="ft__barra-avance" aria-hidden="true"></span>
      </div>

      <div class="ft__riel" role="radiogroup" aria-label="Las siete fases del Método INTEGRA">
        {
          fases.map((f, i) => (
            <label class="paso" for={`fase-${f.letra}`}>
              <span class="paso__num" aria-hidden="true">
                {dosDigitos(i + 1)}
              </span>
              <span class="paso__letra" aria-hidden="true">
                {f.letra}
              </span>
              <span class="paso__nombre">{f.nombre}</span>
            </label>
          ))
        }
      </div>

      <p class="ft__pista">{metodo.pista}</p>

      <div class="ft__paneles">
        {
          fases.map((f, i) => (
            <article class="ficha" id={`panel-${f.letra}`}>
              <header class="ficha__head">
                <span class="ficha__letra" aria-hidden="true">
                  {f.letra}
                </span>
                <span class="ficha__ident">
                  <span class="ficha__orden">
                    Fase {dosDigitos(i + 1)} <i>de</i> {dosDigitos(cols)}
                  </span>
                  <span class="ficha__nombre">{f.nombre}</span>
                </span>
                {f.etiqueta && <span class="ficha__tag">{f.etiqueta}</span>}
              </header>

              <div class="ficha__cuerpo">
                <p class="ficha__pregunta">{f.pregunta}</p>
                <p class="ficha__texto">{f.texto}</p>
                {f.regla && <p class="ficha__regla">{f.regla}</p>}
                {f.destacado && <p class="ficha__destacado">{f.destacado}</p>}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ft {
    position: relative;
    --activa: 0; /* la fija el radio marcado; mueve la barra de avance */
  }

  /* Los radios no se ven pero SÍ se enfocan: por eso no van con
     `display:none`, que los sacaría del orden de tabulación. */
  .ft__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* ------------------------- El riel y su avance --------------------- */
  .ft__barra {
    position: relative;
    height: 2px;
    margin-bottom: 1.25rem;
  }
  .ft__barra-linea {
    position: absolute;
    inset: 0;
    background: var(--borde);
  }
  .ft__barra-avance {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    /* Se detiene en el centro de la fase activa, no en su borde. */
    width: calc((var(--activa) + 0.5) * (100% / var(--cols)));
    background: var(--i-azul-600);
    transition: width 320ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .ft__riel {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: clamp(0.25rem, 0.8vw, 0.6rem);
  }
  .paso {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: clamp(0.6rem, 1.4vw, 0.9rem) 0.2rem;
    border-radius: 12px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background var(--transition), border-color var(--transition);
  }
  .paso:hover {
    background: rgba(30, 92, 242, 0.06);
  }
  .paso__num {
    font-size: 0.62rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.12em;
    color: var(--borde-punteado);
    transition: color var(--transition);
  }
  /* Sin degradé y con el trazo cerrado: la inicial tiene que leerse como
     un dato, no como una decoración. */
  .paso__letra {
    display: grid;
    place-items: center;
    width: clamp(2.1rem, 4.4vw, 3rem);
    height: clamp(2.1rem, 4.4vw, 3rem);
    border-radius: 10px;
    border: 1.5px solid var(--borde-punteado);
    background: #fff;
    font-family: var(--font-title);
    font-weight: var(--w-display);
    font-size: clamp(1.05rem, 0.75rem + 1.3vw, 1.6rem);
    line-height: 1;
    letter-spacing: 0;
    color: var(--azul-pizarra);
    transition: background var(--transition), border-color var(--transition),
      color var(--transition), transform var(--transition);
  }
  .paso__nombre {
    font-size: 0.68rem;
    font-weight: var(--w-subheadline);
    line-height: 1.2;
    text-align: center;
    color: var(--texto-suave);
    /* En pantallas chicas no entra el nombre completo: manda la inicial,
       que además es la que arma el acrónimo. */
    display: none;
  }
  .ft__pista {
    margin-top: 0.9rem;
    font-size: var(--fs-caption);
    color: var(--texto-suave);
    text-align: center;
  }

  /* ---------------------------- La ficha ----------------------------- */
  .ft__paneles {
    display: grid;
    margin-top: 1.5rem;
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  /* Las siete en la misma celda: el alto lo fija la más larga y ya no
     cambia al elegir otra letra. */
  .ficha {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 220ms ease, visibility 220ms;
  }
  .ficha__head {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: clamp(1rem, 2.5vw, 1.35rem) clamp(1.25rem, 3.5vw, 2.25rem);
    background: var(--i-navy);
    color: #fff;
  }
  .ficha__letra {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: var(--i-azul-600);
    font-family: var(--font-title);
    font-weight: var(--w-display);
    font-size: 1.5rem;
    line-height: 1;
  }
  .ficha__ident {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }
  .ficha__orden {
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--i-celeste);
  }
  .ficha__orden i {
    font-style: normal;
    opacity: 0.55;
  }
  .ficha__nombre {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: clamp(1.1rem, 0.95rem + 0.7vw, 1.45rem);
    line-height: 1.15;
  }
  .ficha__tag {
    margin-left: auto;
    flex-shrink: 0;
    padding: 0.3rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(169, 200, 245, 0.35);
    background: rgba(169, 200, 245, 0.12);
    font-size: 0.68rem;
    font-weight: var(--w-subheadline);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--i-celeste);
  }

  .ficha__cuerpo {
    padding: clamp(1.25rem, 3.5vw, 2.25rem);
  }
  /* Todo el texto de la ficha va al mismo cuerpo que los subtítulos de
     sección (`.i-head p` en integra.css: 1,0625rem / 1,65). La jerarquía
     la marcan el peso, el color y la regla al costado — no el tamaño. */
  .ficha__cuerpo p {
    font-size: 1.0625rem;
    line-height: 1.65;
  }
  /* La pregunta es la que ordena cada fase: mismo cuerpo, pero con la
     tipografía de títulos y una regla al costado. */
  .ficha__pregunta {
    padding-left: 0.9rem;
    border-left: 3px solid var(--i-azul-600);
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    color: var(--azul-petroleo);
  }
  .ficha__texto {
    margin-top: 1.1rem;
    color: var(--azul-pizarra);
  }
  .ficha__regla {
    margin-top: 1rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
  }
  .ficha__destacado {
    margin-top: 1.25rem;
    padding: 1rem 1.15rem;
    border-radius: var(--radius-sm);
    background: var(--i-hielo);
    border: 1px solid var(--borde);
    color: var(--azul-petroleo);
  }

  /* --------------------- Qué prende cada radio ----------------------- */
  /* Paso activo */
  #fase-I:checked ~ .ft__riel .paso:nth-child(1) .paso__letra,
  #fase-N:checked ~ .ft__riel .paso:nth-child(2) .paso__letra,
  #fase-T:checked ~ .ft__riel .paso:nth-child(3) .paso__letra,
  #fase-E:checked ~ .ft__riel .paso:nth-child(4) .paso__letra,
  #fase-G:checked ~ .ft__riel .paso:nth-child(5) .paso__letra,
  #fase-R:checked ~ .ft__riel .paso:nth-child(6) .paso__letra,
  #fase-A:checked ~ .ft__riel .paso:nth-child(7) .paso__letra {
    background: var(--i-navy);
    border-color: var(--i-navy);
    color: #fff;
    transform: translateY(-2px);
  }
  #fase-I:checked ~ .ft__riel .paso:nth-child(1) .paso__num,
  #fase-N:checked ~ .ft__riel .paso:nth-child(2) .paso__num,
  #fase-T:checked ~ .ft__riel .paso:nth-child(3) .paso__num,
  #fase-E:checked ~ .ft__riel .paso:nth-child(4) .paso__num,
  #fase-G:checked ~ .ft__riel .paso:nth-child(5) .paso__num,
  #fase-R:checked ~ .ft__riel .paso:nth-child(6) .paso__num,
  #fase-A:checked ~ .ft__riel .paso:nth-child(7) .paso__num {
    color: var(--i-azul-600);
  }
  #fase-I:checked ~ .ft__riel .paso:nth-child(1) .paso__nombre,
  #fase-N:checked ~ .ft__riel .paso:nth-child(2) .paso__nombre,
  #fase-T:checked ~ .ft__riel .paso:nth-child(3) .paso__nombre,
  #fase-E:checked ~ .ft__riel .paso:nth-child(4) .paso__nombre,
  #fase-G:checked ~ .ft__riel .paso:nth-child(5) .paso__nombre,
  #fase-R:checked ~ .ft__riel .paso:nth-child(6) .paso__nombre,
  #fase-A:checked ~ .ft__riel .paso:nth-child(7) .paso__nombre {
    color: var(--azul-petroleo);
    font-weight: var(--w-headline);
  }

  /* Foco visible por teclado: el radio está oculto, así que el anillo lo
     tiene que dibujar el paso. */
  #fase-I:focus-visible ~ .ft__riel .paso:nth-child(1),
  #fase-N:focus-visible ~ .ft__riel .paso:nth-child(2),
  #fase-T:focus-visible ~ .ft__riel .paso:nth-child(3),
  #fase-E:focus-visible ~ .ft__riel .paso:nth-child(4),
  #fase-G:focus-visible ~ .ft__riel .paso:nth-child(5),
  #fase-R:focus-visible ~ .ft__riel .paso:nth-child(6),
  #fase-A:focus-visible ~ .ft__riel .paso:nth-child(7) {
    outline: 3px solid var(--i-azul-600);
    outline-offset: 2px;
  }

  /* Ficha activa */
  #fase-I:checked ~ .ft__paneles #panel-I,
  #fase-N:checked ~ .ft__paneles #panel-N,
  #fase-T:checked ~ .ft__paneles #panel-T,
  #fase-E:checked ~ .ft__paneles #panel-E,
  #fase-G:checked ~ .ft__paneles #panel-G,
  #fase-R:checked ~ .ft__paneles #panel-R,
  #fase-A:checked ~ .ft__paneles #panel-A {
    visibility: visible;
    opacity: 1;
  }

  /* Índice de la fase activa, para el avance de la barra */
  #fase-I:checked ~ .ft__barra { --activa: 0; }
  #fase-N:checked ~ .ft__barra { --activa: 1; }
  #fase-T:checked ~ .ft__barra { --activa: 2; }
  #fase-E:checked ~ .ft__barra { --activa: 3; }
  #fase-G:checked ~ .ft__barra { --activa: 4; }
  #fase-R:checked ~ .ft__barra { --activa: 5; }
  #fase-A:checked ~ .ft__barra { --activa: 6; }

  @media (prefers-reduced-motion: reduce) {
    .ficha,
    .paso__letra,
    .ft__barra-avance {
      transition: none;
    }
  }

  @media (min-width: 720px) {
    .paso__nombre {
      display: block;
    }
  }
</style>
