---
import Base from "../layouts/Base.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Empresas from "../components/Empresas.astro";
import Pillars from "../components/Pillars.astro";
import MuroComentarios from "../components/MuroComentarios.astro";
import Services from "../components/Services.astro";
import Speaker from "../components/Speaker.astro";
import Videos from "../components/Videos.astro";
import Redes from "../components/Redes.astro";
import Blog from "../components/Blog.astro";
import Newsletter from "../components/Newsletter.astro";
import CtaBanner from "../components/CtaBanner.astro";
import Footer from "../components/Footer.astro";
import { charlasMeta, charlas } from "../data/videos";
import { comentarios, fotosMuro, muroHome } from "../data/testimonios";
---

<Base>
  <Navbar />
  <main>
    <Hero />
    <Empresas />
    <Pillars />
    {/* Va pegado al bloque "Sobre mí" y con el mismo fondo blanco: lo que
        dicen de Pablo cierra lo que Pablo dice de sí mismo. */}
    <MuroComentarios
      eyebrow={muroHome.eyebrow}
      titulo={muroHome.titulo}
      subtitulo={muroHome.subtitulo}
      comentarios={comentarios}
      fotos={fotosMuro}
      fondo="blanco"
    />
    <Services />
    <Speaker />
    <section class="section section--tint">
      <div class="container">
        <Videos
          eyebrow={charlasMeta.eyebrow}
          titulo={charlasMeta.titulo}
          subtitulo={charlasMeta.subtitulo}
          items={charlas}
        />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <Redes />
      </div>
    </section>

    <Blog />
    <Newsletter />
    <CtaBanner />
  </main>
  <Footer />
</Base>
