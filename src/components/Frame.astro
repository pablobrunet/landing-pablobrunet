---
/* Marco de imagen con placeholder.
   - Si `src` tiene valor → muestra la imagen.
   - Si `src` está vacío  → muestra un marco vacío con la ruta esperada
     (`label`), para que Pablo sepa exactamente dónde subir la foto.
   Uso:
     <Frame src={site.hero.img} label={site.hero.imgLabel} alt="Retrato" ratio="4/5" />
*/
interface Props {
  src?: string;
  label?: string;
  alt?: string;
  ratio?: string; // ej "4/5", "16/9", "1/1"
  rounded?: boolean;
  class?: string;
}
const {
  src = "",
  label = "",
  alt = "",
  ratio = "4/5",
  rounded = true,
  class: className = "",
} = Astro.props;

const hasImage = src && src.trim() !== "";
---

<div
  class:list={["frame", { "frame--empty": !hasImage, "frame--rounded": rounded }, className]}
  style={`--ratio:${ratio}`}
>
  {
    hasImage ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <div class="frame__placeholder">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <circle cx="9" cy="10" r="2" />
          <path d="M3 17l5-4 4 3 3-3 6 5" />
        </svg>
        <span class="frame__hint">Espacio para foto</span>
        {label && <code class="frame__path">{label}</code>}
      </div>
    )
  }
</div>

<style>
  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio, 4 / 5);
    overflow: hidden;
    background: var(--gris-claro);
  }
  .frame--rounded {
    border-radius: var(--radius);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .frame--empty {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(
        45deg,
        rgba(59, 163, 154, 0.04),
        rgba(59, 163, 154, 0.04) 12px,
        transparent 12px,
        transparent 24px
      ),
      var(--gris-claro);
    border: 1.5px dashed var(--borde-punteado);
    color: var(--verde-azulado);
  }
  .frame__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 1rem;
    text-align: center;
  }
  .frame__hint {
    font-size: var(--fs-caption);
    font-weight: var(--w-subheadline);
    color: var(--azul-pizarra);
    letter-spacing: 0.02em;
  }
  .frame__path {
    font-family: ui-monospace, "Cascadia Code", "Courier New", monospace;
    font-size: 0.72rem;
    color: var(--texto-suave);
    background: rgba(11, 31, 42, 0.05);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    word-break: break-all;
    max-width: 100%;
  }
</style>
