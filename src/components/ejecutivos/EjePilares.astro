---
/* =====================================================================
   QUÉ NOS DIFERENCIA — /programa-ejecutivos
   ---------------------------------------------------------------------
   Texto y los cuatro pilares a la izquierda; a la derecha un mosaico de
   dos columnas desfasadas con cuatro fotos de talleres en blanco y negro
   que recuperan el color al pasar el mouse.

   Lleva el id `diferencia` porque es el destino del segundo CTA del hero.
   ===================================================================== */
import EjeIcon from "./EjeIcon.astro";
import { ejecutivos } from "../../data/ejecutivos";
const { pilares } = ejecutivos.home;
/* Dos columnas desfasadas: las fotos se reparten de a pares. */
const columnaA = [pilares.fotos[0], pilares.fotos[2]];
const columnaB = [pilares.fotos[3], pilares.fotos[1]];
---

<section class="ej-sec ej-sup ep" id="diferencia">
  <div class="ej-wrap ep__grid">
    <div class="ep__copy ej-reveal">
      <h2 class="ej-h2">
        {pilares.titulo}<br />{pilares.tituloLinea2}
      </h2>
      <p class="ej-lead">{pilares.subtitulo}</p>

      <div class="ep__items">
        {
          pilares.items.map((p) => (
            <div class="ep__item">
              <span class="ep__ico">
                <EjeIcon name="cheque" size={24} />
              </span>
              <h3 class="ep__item-titulo">{p.titulo}</h3>
              <p class="ep__item-desc">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="ep__mosaico ej-reveal">
      {
        [columnaA, columnaB].map((fotos, i) => (
          <div class={`ep__col ${i === 0 ? "ep__col--desfasada" : ""}`}>
            {fotos.map((f) => (
              <figure class="ep__foto ej-filete">
                <img src={f.src} alt={f.alt} loading="lazy" referrerpolicy="no-referrer" />
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ep__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .ep__copy {
    display: grid;
    gap: 2rem;
  }
  .ep__copy .ej-lead {
    max-width: 42rem;
  }
  .ep__items {
    display: grid;
    gap: 1.5rem;
  }
  .ep__item {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .ep__ico {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.625rem;
    background: rgba(30, 92, 242, 0.1);
    color: var(--e-acento);
  }
  .ep__item-titulo {
    font-family: var(--font-title);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--e-texto);
  }
  .ep__item-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--e-texto-var);
  }

  /* ---- Mosaico ---- */
  .ep__mosaico {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .ep__col {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .ep__col--desfasada {
    padding-top: 3rem;
  }
  .ep__foto {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--e-r-3xl);
    overflow: hidden;
    box-shadow: var(--e-sombra-prem);
    transition: transform 300ms ease, box-shadow 300ms ease, filter 300ms ease;
  }
  .ep__foto:hover {
    transform: translateY(-4px);
  }
  .ep__foto {
    background: var(--e-sup-alta);
  }
  .ep__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: transform 700ms ease, filter 700ms ease;
  }
  .ep__foto:hover img {
    transform: scale(1.05);
    filter: grayscale(0);
  }

  @media (min-width: 640px) {
    .ep__items {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .ep__grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ep__foto,
    .ep__foto img,
    .ep__foto:hover,
    .ep__foto:hover img {
      transform: none;
      transition: none;
    }
  }
</style>
