---
/* =====================================================================
   QUÉ QUEDA INSTALADO EN TU EMPRESA
   ---------------------------------------------------------------------
   Las tres capacidades, una tarjeta cada una y las tres con el mismo
   peso: es lo único que se promete al día 60.

   La columna de artefactos (workbook, repositorio, plan de 90 días) se
   sacó a propósito: enumerar documentos hacía leer el programa como una
   entrega de papeles y competía con lo que de verdad se vende, que es la
   capacidad que queda funcionando.
   ===================================================================== */
import Icon from "../Icon.astro";
import { integra } from "../../data/integra";
const { instalado, anclas } = integra;
---

<section class="section i-claro" id="que-queda" aria-label="Qué queda instalado">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <h2 class="t-h2">{instalado.titulo}</h2>
      <p class="text-muted">{instalado.subtitulo}</p>
    </header>

    <div class="queda">
      {/* <ul> y no <ol>: las tres capacidades no son pasos ordenados, y el
          reset de global.css sólo saca los marcadores de <ul> — con <ol> el
          navegador dibujaba "1. 2. 3." delante de cada tarjeta. */}
      <ul class="queda__lista">
        {
          instalado.capacidades.items.map((it) => (
            <li class="queda__card i-reveal">
              <span class="queda__n" aria-hidden="true">
                <Icon name={it.icono} size={22} />
              </span>
              <div>
                <h3 class="queda__t">{it.titulo}</h3>
                <p class="text-muted">{it.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <figure class="queda__foto i-reveal">
        <img src={instalado.foto} alt={instalado.fotoAlt} width="1400" height="1050" loading="lazy" />
      </figure>
    </div>

    <figure class="queda__cita i-reveal">
      <blockquote>{instalado.cita}</blockquote>
      <figcaption>{instalado.citaPie}</figcaption>
    </figure>

    <div class="queda__cta i-reveal">
      <a href={`#${anclas.agenda}`} class="btn btn--primary">{instalado.cta}</a>
    </div>
  </div>
</section>

<style>
  .queda {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  /* Las tres capacidades apiladas, no en fila: así cada una se lee como
     un renglón corto y queda lugar al costado para la foto. */
  .queda__lista {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .queda__card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: clamp(1.1rem, 2.5vw, 1.4rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--borde);
    background: linear-gradient(120deg, var(--i-hielo-2), #fff 45%);
  }
  /* El ícono al costado del texto, no encima: apilado sumaba una línea
     por tarjeta y estiraba la columna al pedo. */
  .queda__n {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--i-hielo);
    border: 1px solid var(--borde);
    color: var(--i-azul-600);
  }
  .queda__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.05rem;
    margin-bottom: 0.3rem;
  }
  .queda__card p {
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .queda__foto {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--borde);
    box-shadow: var(--shadow);
    /* En mobile manda su propia proporción; en escritorio toma el alto de
       la columna de tarjetas (ver el media query). */
    aspect-ratio: 4 / 3;
  }
  .queda__foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .queda__cita {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.6rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--i-noche);
    color: #fff;
    text-align: center;
  }
  .queda__cita blockquote {
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    font-size: clamp(1.05rem, 0.9rem + 0.9vw, 1.45rem);
    line-height: 1.5;
    max-width: 52rem;
    margin-inline: auto;
  }
  .queda__cita blockquote::before,
  .queda__cita blockquote::after {
    content: '"';
    color: var(--i-celeste);
  }
  .queda__cita figcaption {
    margin-top: 1rem;
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(220, 230, 246, 0.55);
  }
  .queda__cta {
    margin-top: 1.75rem;
    text-align: center;
  }

  @media (min-width: 860px) {
    .queda {
      grid-template-columns: 1.15fr 1fr;
      align-items: stretch;
    }
    /* Sin proporción fija, la foto se estira a lo que midan las tres
       tarjetas: arranca y termina a la misma altura que la columna de al
       lado. */
    .queda__foto {
      aspect-ratio: auto;
      height: 100%;
    }
  }
</style>
