---
/* =====================================================================
   HERO — Método INTEGRA
   ---------------------------------------------------------------------
   Está diseñado para TRÁFICO FRÍO: no asume que conocen a Pablo. Abre por
   el dolor, nunca por "capacidad instalada" — esa idea recién se entiende
   después del reencuadre.

   La foto va de FONDO, a sangre, con un velo azul noche encima: opaco
   donde va el texto y más liviano hacia la derecha, donde se ve la gente.
   Arriba del velo quedan los halos de luz y la trama de puntos.

   La imagen se importa desde src/assets (no desde public/) para que pase
   por el optimizador de Astro: el original son 3,2 MB de cámara, y así
   sale en webp y en tres anchos según la pantalla.
   ===================================================================== */
import { Image } from "astro:assets";
import { integra } from "../../data/integra";
import portada from "../../assets/hero/integra1.jpg";
import logoIntegra from "../../assets/integra/integra-lockup-blanco.png";
const { hero, anclas } = integra;
---

<section class="ih" aria-label="Método INTEGRA">
  <div class="ih__fondo" aria-hidden="true">
    {/* `width` acota el src de reserva: sin él Astro lo genera al tamaño
        original (4032px) y esa es la URL que termina en el atributo src. */}
    <Image
      class="ih__foto"
      src={portada}
      alt=""
      width={1920}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      formats={["webp"]}
      quality={70}
      loading="eager"
      fetchpriority="high"
    />
    <span class="ih__velo"></span>
    <span class="ih__halo ih__halo--a"></span>
    <span class="ih__halo ih__halo--b"></span>
    <span class="trama ih__trama"></span>
  </div>

  <div class="container ih__inner">
    <div class="ih__copy">
      {/* La marca del programa antes que nada: quien llega de LinkedIn o
          de una pauta tiene que saber en un vistazo dónde está. El lockup
          blanco es el que sirve acá, sobre el azul profundo. */}
      <Image
        class="ih__logo"
        src={logoIntegra}
        alt="Método INTEGRA"
        widths={[240, 480]}
        sizes="240px"
        formats={["webp"]}
        loading="eager"
      />

      <p class="ih__chip">{hero.chip}</p>

      <h1 class="t-display ih__titulo">
        {hero.titulo}
        <span class="i-hl">{hero.tituloResalte}</span>
      </h1>

      <p class="ih__sub">{hero.subtitulo}</p>

      <div class="ih__ctas">
        <a href={`#${anclas.agenda}`} class="btn btn--primary ih__cta">{hero.ctaPrimario}</a>
        <a href={`#${anclas.chequeo}`} class="btn ih__ghost">{hero.ctaSecundario}</a>
      </div>
      <p class="ih__nota">{hero.ctaPrimarioNota}</p>

      <ul class="ih__confianza">
        {
          hero.confianza.map((c) => (
            <li class="ih__conf">
              {c.tipo === "logo" && c.img ? (
                <span class="ih__conf-logo">
                  {/* width/height respetan la proporción real del PNG
                      (816×311) para que no haya salto al cargar. */}
                  <img src={c.img} alt="" width="816" height="311" loading="eager" />
                </span>
              ) : (
                <span class="ih__conf-punto" aria-hidden="true" />
              )}
              <span>{c.texto}</span>
            </li>
          ))
        }
      </ul>
    </div>

  </div>
</section>

<style>
  .ih {
    position: relative;
    overflow: hidden;
    background: var(--i-noche);
    color: #fff;
    padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3.5rem, 8vw, 6rem);
    isolation: isolate;
  }

  /* ---- Fondo: dos halos de luz + trama fina, todo detrás del contenido ---- */
  .ih__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ih__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
  }
  /* Velo: en celular el texto ocupa todo el ancho, así que va parejo y
     más cerrado; desde tablet se abre hacia la derecha para que la foto
     respire del lado donde no hay texto. */
  .ih__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(10, 20, 48, 0.9) 0%, rgba(10, 20, 48, 0.8) 50%, rgba(10, 20, 48, 0.94) 100%);
  }
  @media (min-width: 760px) {
    .ih__velo {
      background:
        linear-gradient(90deg, rgba(10, 20, 48, 0.95) 0%, rgba(10, 20, 48, 0.84) 42%, rgba(10, 20, 48, 0.4) 100%),
        linear-gradient(0deg, rgba(10, 20, 48, 0.65) 0%, transparent 35%);
    }
  }
  .ih__halo {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .ih__halo--a {
    width: 46rem;
    height: 46rem;
    top: -22rem;
    right: -14rem;
    background: radial-gradient(circle, rgba(76, 134, 245, 0.55), transparent 70%);
  }
  .ih__halo--b {
    width: 34rem;
    height: 34rem;
    bottom: -18rem;
    left: -12rem;
    background: radial-gradient(circle, rgba(30, 92, 242, 0.5), transparent 70%);
  }
  .ih__trama {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(80% 60% at 50% 0%, #000 0%, transparent 75%);
    mask-image: radial-gradient(80% 60% at 50% 0%, #000 0%, transparent 75%);
  }

  .ih__inner {
    position: relative;
    width: 100%;
  }
  .ih__copy {
    max-width: 44rem;
  }

  /* ---- Columna de texto ---- */
  .ih__logo {
    display: block;
    width: auto;
    height: clamp(2.1rem, 4.5vw, 2.9rem);
    margin-bottom: 1.5rem;
  }
  .ih__chip {
    display: inline-block;
    padding: 0.45rem 0.95rem;
    margin-bottom: 1.35rem;
    border-radius: var(--radius-pill);
    background: rgba(169, 200, 245, 0.1);
    border: 1px solid rgba(169, 200, 245, 0.28);
    color: var(--i-neblina);
    font-size: 0.8125rem;
    font-weight: var(--w-subheadline);
    line-height: 1.35;
  }
  .ih__titulo {
    font-size: clamp(2.05rem, 1.1rem + 3.6vw, 3.6rem);
    line-height: 1.06;
  }
  /* Las dos oraciones corren seguidas: el salto forzado las separaba como
     si fueran dos titulares distintos. Quiebra sola donde no entre. */
  .ih__titulo .i-hl {
    display: inline;
  }
  .ih__sub {
    max-width: 40rem;
    margin-top: 1.35rem;
    font-size: 1.0625rem;
    line-height: 1.68;
    color: rgba(220, 230, 246, 0.8);
  }
  .ih__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .ih__cta {
    padding-inline: 1.7rem;
  }
  .ih__ghost {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.28);
    color: #fff;
  }
  .ih__ghost:hover {
    background: rgba(255, 255, 255, 0.13);
  }
  .ih__nota {
    margin-top: 0.9rem;
    font-size: var(--fs-caption);
    color: rgba(220, 230, 246, 0.65);
  }

  /* ---- Franja de confianza ---- */
  .ih__confianza {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .ih__conf {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.95rem;
    font-weight: var(--w-subheadline);
    color: var(--i-neblina);
  }
  /* Igual que en el home: versión del sello sólo con logo y letras en
     blanco, sin píldora ni marco, apoyada directo sobre el azul. Una regla
     fina la separa del texto que la acompaña. */
  .ih__conf-logo {
    display: flex;
    align-items: center;
    padding-right: 0.9rem;
    border-right: 1px solid rgba(255, 255, 255, 0.16);
  }
  .ih__conf-logo img {
    height: 30px;
    width: auto;
    object-fit: contain;
    opacity: 0.9;
  }
  .ih__conf-punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--i-celeste);
    flex-shrink: 0;
  }

  @media (min-width: 980px) {
    .ih {
      min-height: min(92vh, 56rem);
      display: grid;
      align-items: center;
    }
  }
</style>
