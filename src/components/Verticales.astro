---
import { verticalesMeta, verticales } from "../data/verticales";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section class="verticals section" aria-label="Verticales">
  <div class="container">
    <SectionHeading
      eyebrow={verticalesMeta.eyebrow}
      title={verticalesMeta.titulo}
      subtitle={verticalesMeta.subtitulo}
    />

    <div class="verticals__grid">
      {
        verticales.map((v) => (
          <a href={`/verticales/${v.slug}`} class="card vertical">
            <span class="vertical__icon">
              <Icon name={v.icon} size={22} />
            </span>
            <h3 class="t-h3">{v.nombre}</h3>
            <Icon name="arrowUpRight" size={16} class="vertical__arrow" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .verticals__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .vertical {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.35rem;
  }
  .vertical__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: 12px;
    background: rgba(59, 163, 154, 0.12);
    color: var(--verde-azulado);
  }
  .vertical h3 {
    flex-grow: 1;
    font-size: 1.05rem;
  }
  .vertical__arrow {
    color: var(--borde-punteado);
    transition: color var(--transition), transform var(--transition);
  }
  .vertical:hover .vertical__arrow {
    color: var(--verde-acento);
    transform: translate(2px, -2px);
  }

  @media (min-width: 640px) {
    .verticals__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .verticals__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
