---
/* =====================================================================
   01 · CONTEXTO Y AUDIENCIA
   ---------------------------------------------------------------------
   Lista numerada, mismo patrón que el diagnóstico de Santa María
   (SantaMariaApertura.astro): explica quién es la audiencia y por qué el
   formato es el que es —una hora, con foco práctico— antes de entrar al
   contenido de la charla.
   ===================================================================== */
import { speedAgro } from "../../data/speedAgro";
const { contexto } = speedAgro;
---

<section class="section i-hielo i-claro ctx" id={contexto.id} aria-label={contexto.titulo}>
  <div class="container">
    <header class="i-head i-reveal">
      <span class="i-eyebrow">{contexto.eyebrow}</span>
      <h2 class="t-h2">{contexto.titulo}</h2>
      <p class="text-muted">{contexto.intro}</p>
    </header>

    <ol class="ctx__lista i-reveal">
      {
        contexto.puntos.map((p, i) => (
          <li>
            <span class="ctx__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <span>{p}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ctx .i-head {
    max-width: 62rem;
  }

  .ctx__lista {
    display: grid;
    gap: 0.7rem;
    list-style: none;
  }
  .ctx__lista li {
    display: flex;
    align-items: flex-start;
    gap: 0.95rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    background: #fff;
    border: 1px solid var(--borde);
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--azul-pizarra);
  }
  .ctx__n {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--i-neblina);
    color: var(--verde-resalte);
    font-size: 0.72rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.06em;
  }

  @media (min-width: 900px) {
    .ctx__lista {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
