---
import { site } from "../data/site";
import Icon from "./Icon.astro";
import { sinMarcas } from "../lib/texto";
interface Props {
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title = site.finalCta.titulo,
  subtitle = site.finalCta.subtitulo,
  ctaLabel = site.finalCta.cta.label,
  ctaHref = site.finalCta.cta.href,
} = Astro.props;
---

<section class="cta section section--dark">
  <div class="container cta__inner">
    <h2 class="t-h2 cta__title">{sinMarcas(title)}</h2>
    <p class="t-subhead cta__sub">{subtitle}</p>
    <div class="cta__actions">
      <a href={ctaHref} class="btn btn--primary">
        {ctaLabel}
        <Icon name="arrow" size={18} />
      </a>
      <a href={`mailto:${site.email}`} class="btn btn--ghost">
        <Icon name="mail" size={18} />
        {site.email}
      </a>
    </div>
    <p class="cta__note">
      <Icon name="clock" size={16} />
      {site.finalCta.nota}
    </p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .cta__inner {
    position: relative;
    max-width: 760px;
    margin-inline: auto;
  }
  .cta__title {
    color: var(--blanco);
  }
  .cta__sub {
    margin: 1rem auto 2rem;
    color: rgba(255, 255, 255, 0.75);
    max-width: 56ch;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
  }
  .cta__note {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    width: 100%;
    font-size: var(--fs-caption);
    color: rgba(255, 255, 255, 0.7);
  }
</style>
