---
/* =====================================================================
   QUIÉN HACE QUÉ
   ---------------------------------------------------------------------
   Tres tarjetas parejas, tres ítems cada una. La versión anterior tenía
   trece ítems de un lado y nueve del otro, más un bloque de "qué no
   incluye" y otro de horas exigidas: se leía como un contrato y enfriaba
   justo antes del cierre. Lo que importa acá es que se entienda el
   reparto de un vistazo, no dejarlo pactado por escrito.

   Los tres íconos van en línea (no importados) porque son propios de
   esta sección y no se repiten en el resto del sitio.
   ===================================================================== */
import { integra } from "../../data/integra";
const { reparto } = integra;
---

<section class="section i-hielo i-claro" aria-label="Quién hace qué">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{reparto.eyebrow}</span>
      <h2 class="t-h2">{reparto.titulo}</h2>
      <p class="text-muted">{reparto.subtitulo}</p>
    </header>

    <div class="rep">
      {
        reparto.columnas.map((col) => (
          <article class:list={["rep__card", `rep__card--${col.tono}`, "i-reveal"]}>
            <span class="rep__icono" aria-hidden="true">
              {col.icono === "brujula" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M15.5 8.5l-2 5-5 2 2-5z" />
                </svg>
              )}
              {col.icono === "equipo" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="9" cy="8" r="3.2" />
                  <path d="M3.5 19.5c0-3 2.5-5 5.5-5s5.5 2 5.5 5" />
                  <path d="M16 5.5a3 3 0 0 1 0 5.6M17.5 14.8c1.9.6 3.2 2.3 3.2 4.7" />
                </svg>
              )}
              {col.icono === "manos" && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 11l3-3 4 4 3-3" />
                  <path d="M3 13.5l4.5 4.5a3 3 0 0 0 4.2 0l.3-.3" />
                  <path d="M21 10.5L16.5 6a3 3 0 0 0-4.2 0l-.3.3" />
                </svg>
              )}
            </span>

            <h3 class="rep__t">{col.titulo}</h3>
            <ul class="rep__lista">
              {col.items.map((it) => (
                <li>
                  <svg class="rep__tick" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12l4 4 10-10" />
                  </svg>
                  {it}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rep {
    display: grid;
    gap: 1.1rem;
  }
  .rep__card {
    padding: clamp(1.35rem, 3vw, 1.85rem);
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: var(--radius-lg);
    border-top: 4px solid var(--i-azul-500);
  }
  /* La del medio es la que más cuesta aceptar (lo que pone la empresa):
     va marcada para que no se lea como una obligación escondida. */
  .rep__card--empresa {
    border-top-color: var(--i-azul-600);
  }
  .rep__card--juntos {
    border-top-color: var(--i-celeste);
  }
  .rep__icono {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: 0.9rem;
    border-radius: 12px;
    background: rgba(30, 92, 242, 0.09);
    color: var(--i-azul-600);
  }
  .rep__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.1rem;
    margin-bottom: 0.9rem;
    color: var(--azul-petroleo);
  }
  .rep__lista {
    display: grid;
    gap: 0.6rem;
  }
  .rep__lista li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--azul-pizarra);
  }
  .rep__tick {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--i-azul-600);
  }

  @media (min-width: 860px) {
    .rep {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
