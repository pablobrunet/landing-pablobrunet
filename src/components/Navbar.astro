---
import { site } from "../data/site";
import { servicios } from "../data/servicios";
import { casos } from "../data/casos";
import { verticales } from "../data/verticales";
import { recursos } from "../data/recursos";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

// Construye el contenido de cada desplegable a partir de los datos.
type MenuKey = "servicios" | "casos" | "verticales" | "recursos";
const menus: Record<MenuKey, { verTodos: string; items: { label: string; href: string; desc?: string }[] }> = {
  servicios: {
    verTodos: "/servicios",
    items: servicios.map((s) => ({ label: s.titulo, href: `/servicios/${s.slug}`, desc: s.resumen })),
  },
  casos: {
    verTodos: "/casos",
    items: casos.map((c) => ({ label: c.titulo, href: `/casos/${c.slug}`, desc: c.categoria })),
  },
  verticales: {
    verTodos: "/verticales",
    items: verticales.map((v) => ({ label: v.nombre, href: `/verticales/${v.slug}`, desc: v.resumen })),
  },
  recursos: {
    verTodos: "/recursos",
    items: recursos.map((r) => ({ label: r.titulo, href: r.href, desc: r.descripcion })),
  },
};
---

<header class="nav">
  <div class="container nav__inner">
    <Logo />

    <nav class="nav__links" aria-label="Principal">
      {
        site.nav.map((item) =>
          "menu" in item && item.menu ? (
            <div class="nav__item" data-dropdown>
              <button class="nav__trigger" aria-expanded="false" aria-haspopup="true">
                {item.label}
                <Icon name="chevron" size={16} class="nav__chev" />
              </button>
              <div class="nav__panel" role="menu">
                <div class="nav__panel-grid">
                  {menus[item.menu as MenuKey].items.map((sub) => (
                    <a href={sub.href} class="nav__sub" role="menuitem">
                      <span class="nav__sub-label">{sub.label}</span>
                      {sub.desc && <span class="nav__sub-desc">{sub.desc}</span>}
                    </a>
                  ))}
                </div>
                <a href={menus[item.menu as MenuKey].verTodos} class="nav__vertodos">
                  Ver todo
                  <Icon name="arrow" size={15} />
                </a>
              </div>
            </div>
          ) : (
            <a href={item.href} class="nav__link">
              {item.label}
            </a>
          )
        )
      }
    </nav>

    <div class="nav__actions">
      <ul class="nav__social">
        {
          site.redes.map((r) => (
            <li>
              <a href={r.href} aria-label={r.label} target="_blank" rel="noopener">
                <Icon name={r.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <a href={site.cta.href} class="btn btn--primary nav__cta">{site.cta.label}</a>
      <button class="nav__burger" aria-label="Abrir menú" aria-expanded="false" data-burger>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Menú mobile (acordeón) -->
  <div class="nav__mobile" data-mobile-menu hidden>
    <nav aria-label="Móvil">
      {
        site.nav.map((item) =>
          "menu" in item && item.menu ? (
            <div class="m-acc" data-acc>
              <button class="m-acc__head" aria-expanded="false">
                {item.label}
                <Icon name="chevron" size={16} />
              </button>
              <div class="m-acc__body" hidden>
                <a href={menus[item.menu as MenuKey].verTodos} class="m-acc__all">
                  Ver todo {item.label.toLowerCase()}
                </a>
                {menus[item.menu as MenuKey].items.map((sub) => (
                  <a href={sub.href}>{sub.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} class="m-link">
              {item.label}
            </a>
          )
        )
      }
      <a href={site.cta.href} class="btn btn--primary">{site.cta.label}</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--borde);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 72px;
  }
  .nav__links {
    display: none;
    align-items: center;
    gap: 0.35rem;
  }
  .nav__link,
  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: var(--w-subheadline);
    color: var(--azul-pizarra);
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    transition: color var(--transition), background var(--transition);
  }
  .nav__link:hover,
  .nav__trigger:hover {
    color: var(--verde-acento-oscuro);
    background: var(--gris-claro);
  }
  .nav__chev {
    transition: transform var(--transition);
  }

  /* Dropdown */
  .nav__item {
    position: relative;
  }
  .nav__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    width: min(460px, 82vw);
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: 0.75rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition), transform var(--transition), visibility var(--transition);
  }
  .nav__item:hover .nav__panel,
  .nav__item:focus-within .nav__panel,
  .nav__trigger[aria-expanded="true"] + .nav__panel {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .nav__item:hover .nav__chev,
  .nav__item:focus-within .nav__chev {
    transform: rotate(180deg);
  }
  .nav__panel-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem;
  }
  .nav__sub {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.7rem;
    border-radius: 10px;
    transition: background var(--transition);
  }
  .nav__sub:hover {
    background: var(--gris-claro);
  }
  .nav__sub-label {
    font-weight: var(--w-subheadline);
    color: var(--azul-petroleo);
    font-size: 0.9rem;
  }
  .nav__sub-desc {
    font-size: 0.75rem;
    color: var(--texto-suave);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .nav__vertodos {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.5rem 0.2rem 0.2rem;
    padding: 0.5rem 0.5rem;
    font-size: 0.85rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-acento-oscuro);
  }
  .nav__vertodos:hover {
    gap: 0.65rem;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav__social {
    display: none;
    gap: 0.65rem;
  }
  .nav__social a {
    color: var(--azul-pizarra);
    transition: color var(--transition);
  }
  .nav__social a:hover {
    color: var(--verde-acento);
  }
  .nav__cta {
    display: none;
  }
  .nav__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--borde);
    border-radius: 10px;
    cursor: pointer;
  }
  .nav__burger span {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--azul-petroleo);
    border-radius: 2px;
    transition: transform var(--transition), opacity var(--transition);
  }
  .nav__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile */
  .nav__mobile {
    border-top: 1px solid var(--borde);
    background: var(--blanco);
    padding: 1rem var(--gutter) 1.5rem;
    max-height: 80vh;
    overflow-y: auto;
  }
  .nav__mobile nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: var(--maxw);
    margin-inline: auto;
  }
  .m-link,
  .m-acc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.85rem 0.5rem;
    font-family: inherit;
    font-size: 1rem;
    font-weight: var(--w-subheadline);
    color: var(--azul-petroleo);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--borde);
    cursor: pointer;
  }
  .m-acc__body {
    display: flex;
    flex-direction: column;
    padding: 0.25rem 0.5rem 0.5rem 1rem;
  }
  .m-acc__body a {
    padding: 0.6rem 0;
    color: var(--azul-pizarra);
    font-size: 0.95rem;
  }
  .m-acc__all {
    color: var(--verde-acento-oscuro) !important;
    font-weight: var(--w-subheadline);
  }
  .m-acc__head[aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }
  .nav__mobile .btn {
    margin-top: 1rem;
  }

  @media (min-width: 1000px) {
    .nav__links,
    .nav__social {
      display: flex;
    }
    .nav__cta {
      display: inline-flex;
    }
    .nav__burger {
      display: none;
    }
    .nav__mobile {
      display: none !important;
    }
  }
</style>

<script>
  function initNav() {
    // Burger → menú mobile
    const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    burger?.addEventListener("click", () => {
      const open = burger.getAttribute("aria-expanded") === "true";
      burger.setAttribute("aria-expanded", String(!open));
      if (menu) menu.hidden = open;
    });

    // Acordeones mobile
    document.querySelectorAll<HTMLElement>("[data-acc]").forEach((acc) => {
      const head = acc.querySelector<HTMLButtonElement>(".m-acc__head");
      const body = acc.querySelector<HTMLElement>(".m-acc__body");
      head?.addEventListener("click", () => {
        const open = head.getAttribute("aria-expanded") === "true";
        head.setAttribute("aria-expanded", String(!open));
        if (body) body.hidden = open;
      });
    });

    // Dropdowns desktop: click (táctil/teclado) además del hover por CSS
    document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dd) => {
      const trigger = dd.querySelector<HTMLButtonElement>(".nav__trigger");
      trigger?.addEventListener("click", (e) => {
        e.preventDefault();
        const open = trigger.getAttribute("aria-expanded") === "true";
        document
          .querySelectorAll(".nav__trigger[aria-expanded='true']")
          .forEach((t) => t.setAttribute("aria-expanded", "false"));
        trigger.setAttribute("aria-expanded", String(!open));
      });
    });
    document.addEventListener("click", (e) => {
      if (!(e.target as HTMLElement).closest("[data-dropdown]")) {
        document
          .querySelectorAll(".nav__trigger[aria-expanded='true']")
          .forEach((t) => t.setAttribute("aria-expanded", "false"));
      }
    });
  }

  initNav();
  // Re-inicializa tras cada navegación con View Transitions
  document.addEventListener("astro:page-load", initNav);
</script>
