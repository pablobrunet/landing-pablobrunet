---
import { site } from "../data/site";
import { sobreMi } from "../data/sobreMi";
import Frame from "./Frame.astro";
import Icon from "./Icon.astro";
---

<section class="about section" id="sobre-mi" aria-label="Sobre mí">
  <div class="container about__inner">
    <div class="about__media">
      <Frame src={sobreMi.img} label={sobreMi.imgLabel} alt={`Foto de ${site.nombre}`} ratio="4/5" />
    </div>

    <div class="about__copy">
      <span class="eyebrow">{sobreMi.eyebrow}</span>
      <h2 class="t-h2">{sobreMi.titulo}</h2>
      <p class="t-subhead text-muted about__p">{sobreMi.parrafo}</p>

      <ul class="about__pillars">
        {
          sobreMi.pilares.map((p) => (
            <li class="pillar">
              <span class="pillar__icon">
                <Icon name={p.icon} size={22} />
              </span>
              <div>
                <h3 class="t-h3">{p.titulo}</h3>
                <p class="text-muted">{p.texto}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <a href="/sobre-mi" class="btn btn--outline about__cta">
        Conocé mi historia
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .about__media {
    max-width: 440px;
    width: 100%;
    justify-self: center;
  }
  .about__p {
    margin-top: 1rem;
  }
  .about__pillars {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .pillar {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .pillar__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(0, 191, 114, 0.1);
    color: var(--verde-acento-oscuro);
  }
  .pillar h3 {
    margin-bottom: 0.15rem;
  }
  .about__cta {
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    .about__inner {
      grid-template-columns: 0.9fr 1.1fr;
    }
    .about__media {
      justify-self: start;
    }
  }
</style>
