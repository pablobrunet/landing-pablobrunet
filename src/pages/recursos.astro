---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
import { recursosMeta, recursos } from "../data/recursos";
import { sinMarcas } from "../lib/texto";
---

<Page title={`Recursos — ${sinMarcas(recursosMeta.titulo)}`}>
  <PageHero
    eyebrow={recursosMeta.eyebrow}
    title={recursosMeta.titulo}
    subtitle={recursosMeta.subtitulo}
    crumbs={[{ label: "Recursos" }]}
  />

  <section class="section">
    <div class="container">
      <div class="grid">
        {
          recursos.map((r) => (
            <a href={r.href} class="card res">
              <span class="res__icon">
                <Icon name={r.icon} size={26} />
              </span>
              <h2 class="t-h3">{r.titulo}</h2>
              <p class="text-muted res__text">{r.descripcion}</p>
              <span class="res__cta">
                {r.cta}
                <Icon name="arrowUpRight" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <LeadMagnet />
    </div>
  </section>
</Page>

<style>
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .res {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .res__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: var(--azul-petroleo);
    color: var(--verde-acento);
    margin-bottom: 1.25rem;
  }
  .res__text {
    margin: 0.5rem 0 1.5rem;
    flex-grow: 1;
  }
  .res__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
    transition: gap var(--transition);
  }
  .res:hover .res__cta {
    gap: 0.7rem;
  }

  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
