---
/* =====================================================================
   PORTADA E ÍNDICE — Propuesta para Biscayart
   ---------------------------------------------------------------------
   Quien abre esta página pidió un presupuesto: la portada no argumenta a
   favor de contratar nada, ubica. El titular nombra el servicio, la
   bajada dice qué comprende y la ficha —a la altura del titular, no al
   pie— tiene los datos que se consultan: fecha, referencia, validez,
   participantes.

   Los dos enlaces del pie de la columna de texto no son llamados a la
   acción: son atajos de lectura hacia el alcance y las condiciones, los
   dos puntos que se buscan primero. Por eso van en tono discreto y no
   como botones de conversión.

   EL ÍNDICE VA ACÁ, dentro de la misma sección oscura. Es una propuesta
   de once puntos con referencias cruzadas —"según el punto 8", "descrito
   en el 4.1"— y sin un índice esas remisiones no se pueden seguir. Se
   arma con el array `indice` de los datos, que es el mismo del que sale
   la numeración de cada sección.

   Mismo lenguaje visual que la portada del Método INTEGRA: azul
   profundo, dos halos de luz y la trama de puntos, todo detrás del
   contenido.
   ===================================================================== */
import Icon from "../Icon.astro";
import { biscayart } from "../../data/biscayart";
const { hero, indice, indiceTitulo } = biscayart;
---

<section class="bh" aria-label="Propuesta de servicios para Biscayart Semillas">
  <div class="bh__fondo" aria-hidden="true">
    <span class="bh__halo bh__halo--a"></span>
    <span class="bh__halo bh__halo--b"></span>
    <span class="trama bh__trama"></span>
  </div>

  <div class="container bh__inner">
    <div class="bh__copy">
      {/* Membrete: el logo del cliente encabeza la propuesta. Va DENTRO
          de la columna de texto y no en un bloque propio arriba de la
          grilla: así lo único que lo separa del chip es su margen, y no
          se le suma el aire que meten el contenedor y la grilla.

          Sobre placa blanca, porque el logo es azul marino y rojo y
          sobre el fondo de la portada el isotipo se perdería. Si no hay
          archivo cargado, el bloque no se dibuja. */}
      {
        hero.logo.src && (
          <span class="bh__placa">
            <img
              src={hero.logo.src}
              alt={hero.logo.alt}
              width={hero.logo.ancho}
              height={hero.logo.alto}
            />
          </span>
        )
      }

      <h1 class="t-display bh__titulo">
        {hero.titulo}
        <span class="i-hl">{hero.tituloResalte}</span>
      </h1>

      <p class="bh__sub">{hero.subtitulo}</p>

      <p class="bh__enlaces">
        {
          hero.enlaces.map((e) => (
            <a href={`#${e.id}`}>
              {e.etiqueta}
              <Icon name="arrow" size={15} />
            </a>
          ))
        }
      </p>
    </div>

    <aside class="bh__ficha">
      <p class="bh__ficha-t">{hero.fichaTitulo}</p>
      <dl class="bh__filas">
        {
          hero.fichaFilas.map((f) => (
            <div class="bh__fila">
              <span class="bh__fila-ico" aria-hidden="true">
                <Icon name={f.icono} size={16} />
              </span>
              <div>
                <dt>{f.etiqueta}</dt>
                <dd>{f.valor}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>

  {/* ---- Índice ---- */}
  <nav class="container bh__indice" aria-label={indiceTitulo}>
    <p class="bh__indice-t">{indiceTitulo}</p>
    <ol>
      {
        indice.map((s) => (
          <li>
            <a href={`#${s.id}`}>
              <span class="bh__indice-n">{s.n}</span>
              <span class="bh__indice-e">{s.titulo}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<style>
  .bh {
    position: relative;
    overflow: hidden;
    background: var(--i-noche);
    color: #fff;
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  /* ---- Fondo ---- */
  .bh__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bh__halo {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .bh__halo--a {
    width: 44rem;
    height: 44rem;
    top: -22rem;
    right: -14rem;
    background: radial-gradient(circle, rgba(76, 134, 245, 0.55), transparent 70%);
  }
  .bh__halo--b {
    width: 32rem;
    height: 32rem;
    bottom: -18rem;
    left: -12rem;
    background: radial-gradient(circle, rgba(30, 92, 242, 0.5), transparent 70%);
  }
  .bh__trama {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(80% 60% at 50% 0%, #000 0%, transparent 75%);
    mask-image: radial-gradient(80% 60% at 50% 0%, #000 0%, transparent 75%);
  }

  /* ---- Membrete ---- */
  /* Encabeza la columna de texto, arriba del título. Va DENTRO de la
     columna y no en un bloque propio sobre la grilla: así lo único que
     lo separa de lo que sigue es este margen, y no se le suma el aire
     del contenedor ni el arranque de la grilla. Su relleno interno
     cuenta como parte de esa distancia, así que va corto. */
  .bh__placa {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.5rem 0.85rem;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 14px 34px rgba(6, 12, 30, 0.35);
  }
  /* Alto fijo y ancho automático: el logo es apaisado y lo que tiene que
     mantenerse constante es su altura, no el ancho de la placa. */
  .bh__placa img {
    display: block;
    width: auto;
    height: clamp(30px, 4.5vw, 40px);
  }

  .bh__inner {
    position: relative;
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.25rem);
    align-items: center;
  }

  /* ---- Columna de texto ---- */
  .bh__titulo {
    font-size: clamp(1.8rem, 1.1rem + 2.7vw, 2.85rem);
    line-height: 1.12;
  }
  /* Las dos partes corren seguidas: el salto forzado las leería como dos
     titulares distintos. Quiebra sola donde no entre. */
  .bh__titulo .i-hl {
    display: inline;
  }
  .bh__sub {
    max-width: 40rem;
    margin-top: 1.35rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(220, 230, 246, 0.8);
  }
  /* Atajos de lectura, no botones: subrayado al pasar y flecha que se
     despega. Un par de botones sólidos acá convertiría una propuesta en
     una página de captación. */
  .bh__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1.85rem;
  }
  .bh__enlaces a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid rgba(169, 200, 245, 0.45);
    font-size: 0.95rem;
    font-weight: var(--w-subheadline);
    color: var(--i-celeste);
    transition: gap var(--transition), border-color var(--transition);
  }
  .bh__enlaces a:hover {
    gap: 0.75rem;
    border-color: var(--i-celeste);
  }

  /* ---- Ficha ---- */
  .bh__ficha {
    padding: clamp(1.35rem, 3vw, 1.8rem);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(169, 200, 245, 0.24);
    box-shadow: 0 30px 70px rgba(6, 12, 30, 0.5);
    backdrop-filter: blur(6px);
  }
  .bh__ficha-t {
    font-size: 0.72rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--i-celeste);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(169, 200, 245, 0.2);
  }
  .bh__filas {
    display: grid;
  }
  .bh__fila {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 0.75rem 0;
  }
  .bh__fila + .bh__fila {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .bh__fila-ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: rgba(169, 200, 245, 0.12);
    color: var(--i-celeste);
  }
  .bh__fila dt {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(220, 230, 246, 0.6);
  }
  .bh__fila dd {
    margin-top: 0.15rem;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 0.9375rem;
    line-height: 1.35;
    color: #fff;
  }

  /* ---- Índice ---- */
  .bh__indice {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.75rem, 4vw, 2.25rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .bh__indice-t {
    margin-bottom: 1.1rem;
    font-size: 0.72rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--i-celeste);
  }
  .bh__indice ol {
    display: grid;
    gap: 0.15rem 2rem;
    list-style: none;
  }
  .bh__indice a {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.45rem 0.5rem 0.45rem 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgba(220, 230, 246, 0.82);
    transition: color var(--transition);
  }
  .bh__indice a:hover {
    color: #fff;
  }
  .bh__indice a:hover .bh__indice-e {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bh__indice-n {
    flex-shrink: 0;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    color: var(--i-celeste);
  }

  @media (min-width: 640px) {
    .bh__indice ol {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 980px) {
    .bh__inner {
      grid-template-columns: 1.12fr 0.88fr;
      gap: 3.5rem;
    }
    .bh__indice ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
