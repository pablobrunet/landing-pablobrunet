---
/* =====================================================================
   PORTADA E ÍNDICE — Propuesta para Grupo Santa María
   ---------------------------------------------------------------------
   Quien abre esta página pidió un presupuesto: la portada no argumenta a
   favor de contratar nada, ubica. El titular nombra el servicio, la
   bajada dice qué comprende y la ficha —a la altura del titular, no al
   pie— tiene los datos que se consultan: fecha, referencia, validez,
   encuentros. Mismo componente que BiscayartHero.astro.

   No hay logo del cliente cargado (`hero.logo.src` vacío en los datos),
   así que el bloque del membrete no se dibuja.

   Mismo lenguaje visual que la portada del Método INTEGRA: azul
   profundo, dos halos de luz y la trama de puntos, todo detrás del
   contenido.
   ===================================================================== */
import Icon from "../Icon.astro";
import { santaMaria } from "../../data/santaMaria";
const { hero, indice, indiceTitulo } = santaMaria;
---

<section class="sh" aria-label="Propuesta de servicios para Grupo Santa María">
  <div class="sh__fondo" aria-hidden="true">
    <span class="sh__halo sh__halo--a"></span>
    <span class="sh__halo sh__halo--b"></span>
    <span class="trama sh__trama"></span>
  </div>

  <div class="container sh__inner">
    <div class="sh__copy">
      {
        hero.logo.src && (
          <span class="sh__placa">
            <img
              src={hero.logo.src}
              alt={hero.logo.alt}
              width={hero.logo.ancho}
              height={hero.logo.alto}
            />
          </span>
        )
      }

      <h1 class="t-display sh__titulo">
        {hero.titulo}
        <span class="i-hl">{hero.tituloResalte}</span>
      </h1>

      <p class="sh__sub">{hero.subtitulo}</p>

      <p class="sh__enlaces">
        {
          hero.enlaces.map((e) => (
            <a href={`#${e.id}`}>
              {e.etiqueta}
              <Icon name="arrow" size={15} />
            </a>
          ))
        }
      </p>
    </div>

    <aside class="sh__ficha">
      <p class="sh__ficha-t">{hero.fichaTitulo}</p>
      <dl class="sh__filas">
        {
          hero.fichaFilas.map((f) => (
            <div class="sh__fila">
              <span class="sh__fila-ico" aria-hidden="true">
                <Icon name={f.icono} size={16} />
              </span>
              <div>
                <dt>{f.etiqueta}</dt>
                <dd>{f.valor}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>

  {/* ---- Índice ---- */}
  <nav class="container sh__indice" aria-label={indiceTitulo}>
    <p class="sh__indice-t">{indiceTitulo}</p>
    <ol>
      {
        indice.map((s) => (
          <li>
            <a href={`#${s.id}`}>
              <span class="sh__indice-n">{s.n}</span>
              <span class="sh__indice-e">{s.titulo}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</section>

<style>
  .sh {
    position: relative;
    overflow: hidden;
    background: var(--i-noche);
    color: #fff;
    padding-block: clamp(3rem, 7vw, 5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  /* ---- Fondo ---- */
  .sh__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .sh__halo {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.55;
  }
  .sh__halo--a {
    width: 44rem;
    height: 44rem;
    top: -22rem;
    right: -14rem;
    background: radial-gradient(circle, rgba(76, 134, 245, 0.55), transparent 70%);
  }
  .sh__halo--b {
    width: 32rem;
    height: 32rem;
    bottom: -18rem;
    left: -12rem;
    background: radial-gradient(circle, rgba(30, 92, 242, 0.5), transparent 70%);
  }
  .sh__trama {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(80% 60% at 50% 0%, #000 0%, transparent 75%);
    mask-image: radial-gradient(80% 60% at 50% 0%, #000 0%, transparent 75%);
  }

  /* ---- Membrete ---- */
  .sh__placa {
    display: inline-flex;
    margin-bottom: 1rem;
    padding: 0.5rem 0.85rem;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 14px 34px rgba(6, 12, 30, 0.35);
  }
  .sh__placa img {
    display: block;
    width: auto;
    height: clamp(30px, 4.5vw, 40px);
  }

  .sh__inner {
    position: relative;
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.25rem);
    align-items: center;
  }

  /* ---- Columna de texto ---- */
  .sh__titulo {
    font-size: clamp(1.8rem, 1.1rem + 2.7vw, 2.85rem);
    line-height: 1.12;
  }
  .sh__titulo .i-hl {
    display: inline;
  }
  .sh__sub {
    max-width: 40rem;
    margin-top: 1.35rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(220, 230, 246, 0.8);
  }
  .sh__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1.85rem;
  }
  .sh__enlaces a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid rgba(169, 200, 245, 0.45);
    font-size: 0.95rem;
    font-weight: var(--w-subheadline);
    color: var(--i-celeste);
    transition: gap var(--transition), border-color var(--transition);
  }
  .sh__enlaces a:hover {
    gap: 0.75rem;
    border-color: var(--i-celeste);
  }

  /* ---- Ficha ---- */
  .sh__ficha {
    padding: clamp(1.35rem, 3vw, 1.8rem);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.055);
    border: 1px solid rgba(169, 200, 245, 0.24);
    box-shadow: 0 30px 70px rgba(6, 12, 30, 0.5);
    backdrop-filter: blur(6px);
  }
  .sh__ficha-t {
    font-size: 0.72rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--i-celeste);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(169, 200, 245, 0.2);
  }
  .sh__filas {
    display: grid;
  }
  .sh__fila {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 0.75rem 0;
  }
  .sh__fila + .sh__fila {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .sh__fila-ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: rgba(169, 200, 245, 0.12);
    color: var(--i-celeste);
  }
  .sh__fila dt {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(220, 230, 246, 0.6);
  }
  .sh__fila dd {
    margin-top: 0.15rem;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 0.9375rem;
    line-height: 1.35;
    color: #fff;
  }

  /* ---- Índice ---- */
  .sh__indice {
    position: relative;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: clamp(1.75rem, 4vw, 2.25rem);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .sh__indice-t {
    margin-bottom: 1.1rem;
    font-size: 0.72rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--i-celeste);
  }
  .sh__indice ol {
    display: grid;
    gap: 0.15rem 2rem;
    list-style: none;
  }
  .sh__indice a {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding: 0.45rem 0.5rem 0.45rem 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: rgba(220, 230, 246, 0.82);
    transition: color var(--transition);
  }
  .sh__indice a:hover {
    color: #fff;
  }
  .sh__indice a:hover .sh__indice-e {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .sh__indice-n {
    flex-shrink: 0;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    color: var(--i-celeste);
  }

  @media (min-width: 640px) {
    .sh__indice ol {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 980px) {
    .sh__inner {
      grid-template-columns: 1.12fr 0.88fr;
      gap: 3.5rem;
    }
    .sh__indice ol {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
