---
/* =====================================================================
   HERO — /programa-ejecutivos/programa
   ---------------------------------------------------------------------
   Mismo fondo que el hero del índice (foto a sangre, velo azul y luces
   que derivan a la derecha): título, bajada y las tres fichas de formato
   a la izquierda. Debajo, en una franja clara, el bloque oscuro con el
   objetivo del programa.
   ===================================================================== */
import EjeIcon from "./EjeIcon.astro";
import EjeFondoHero from "./EjeFondoHero.astro";
import { ejecutivos } from "../../data/ejecutivos";
const { hero } = ejecutivos.programa;
---

<section class="ej-noche eph">
  <EjeFondoHero src={hero.imagen} alt={hero.imagenAlt} />

  <div class="ej-wrap">
    <div class="eph__copy">
      <p class="eph__chip">
        <EjeIcon name="maletin" size={14} />
        {hero.chip}
      </p>

      <h1 class="eph__titulo">{hero.titulo}</h1>
      <p class="eph__bajada">{hero.bajada}</p>
      <p class="eph__sub">{hero.subtitulo}</p>

      <div class="eph__datos">
        {
          hero.datos.map((d) => (
            <div class="eph__dato">
              <p class="eph__dato-label">{d.label}</p>
              <p class="eph__dato-valor">{d.valor}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="ej-sec ej-sec--corta ej-aurora eph-obj">
  <div class="ej-wrap">
    <div class="eph__objetivo">
      <span class="eph__objetivo-luz" aria-hidden="true"></span>
      <div class="eph__objetivo-cabeza">
        <span class="eph__objetivo-ico">
          <EjeIcon name="diana" size={28} />
        </span>
        <p class="eph__objetivo-eyebrow">{hero.objetivo.eyebrow}</p>
        <h2 class="eph__objetivo-titulo">{hero.objetivo.titulo}</h2>
      </div>
      <p class="eph__objetivo-desc">{hero.objetivo.desc}</p>
    </div>
  </div>
</section>

<style>
  .eph {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: min(52rem, calc(100svh - var(--nav-alto)));
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .eph__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 44rem;
  }

  .eph__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(169, 200, 245, 0.35);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    color: var(--e-celeste);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .eph__titulo {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: clamp(2.125rem, 1.4rem + 2.6vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #ffffff;
    max-width: 18ch;
  }
  .eph__bajada {
    font-family: var(--font-title);
    font-size: clamp(1.3rem, 1rem + 1.2vw, 1.875rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.2;
    color: var(--e-celeste);
    max-width: 26ch;
  }
  .eph__sub {
    max-width: 36rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
  }

  /* Fichas de formato: vidrio esmerilado sobre el velo */
  .eph__datos {
    display: grid;
    gap: 1rem;
    width: 100%;
    margin-top: 0.5rem;
  }
  .eph__dato {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--e-r-xl);
    border: 1px solid rgba(169, 200, 245, 0.22);
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(10px);
    transition: transform 500ms ease, background 500ms ease;
  }
  .eph__dato:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.11);
  }
  .eph__dato-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--e-celeste);
  }
  .eph__dato-valor {
    font-family: var(--font-title);
    font-weight: 700;
    line-height: 1.35;
    color: #ffffff;
  }

  /* ---- Objetivo ---- */
  .eph__objetivo {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 1.5rem;
    border-radius: var(--e-r-3xl);
    background: var(--e-navy);
    color: #ffffff;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    box-shadow: var(--e-sombra-prem);
    transition: transform 500ms ease;
  }
  .eph__objetivo:hover {
    transform: translateY(-4px);
  }
  .eph__objetivo-luz {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, rgba(76, 134, 245, 0.22), transparent 35%);
  }
  .eph__objetivo-cabeza,
  .eph__objetivo-desc {
    position: relative;
    z-index: 1;
  }
  .eph__objetivo-cabeza {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .eph__objetivo-ico {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.5rem;
    border-radius: var(--e-r-xl);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.1);
    color: var(--e-azul-500);
    transition: background 500ms ease, transform 500ms ease;
  }
  .eph__objetivo:hover .eph__objetivo-ico {
    background: rgba(255, 255, 255, 0.16);
    transform: scale(1.1);
  }
  .eph__objetivo-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
  .eph__objetivo-titulo {
    font-family: var(--font-title);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.875rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .eph__objetivo-desc {
    font-size: 1.0625rem;
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.85);
  }

  @media (min-width: 640px) {
    .eph__datos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .eph__objetivo {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .eph__dato,
    .eph__dato:hover,
    .eph__objetivo,
    .eph__objetivo:hover {
      transform: none;
      transition: none;
    }
  }
</style>
