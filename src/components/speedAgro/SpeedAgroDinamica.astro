---
/* =====================================================================
   03 · DINÁMICA
   ---------------------------------------------------------------------
   Cuatro tarjetas parejas, sin jerarquía entre ellas. Mismo patrón que
   SantaMariaMetodologia.astro: no hay timeline de fases porque no hay
   varias etapas que ordenar, es un único encuentro de una hora.

   Sin bajada bajo el título: las cuatro tarjetas se explican solas y la
   línea que había ("un único encuentro, presencial") no agregaba nada.
   ===================================================================== */
import Icon from "../Icon.astro";
import { speedAgro } from "../../data/speedAgro";
const { dinamica } = speedAgro;
---

<section class="section i-hielo i-claro din" id={dinamica.id} aria-label={dinamica.titulo}>
  <div class="container">
    <header class="i-head i-reveal">
      <span class="i-eyebrow">{dinamica.eyebrow}</span>
      <h2 class="t-h2">{dinamica.titulo}</h2>
    </header>

    <div class="din__detalles">
      {
        dinamica.detalles.map((d) => (
          <article class="det i-reveal">
            <span class="det__ico" aria-hidden="true">
              <Icon name={d.icono} size={18} />
            </span>
            <h3 class="det__t">{d.titulo}</h3>
            <p class="det__p">{d.texto}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .din .i-head {
    max-width: 62rem;
  }

  .din__detalles {
    display: grid;
    gap: 1rem;
  }
  .det {
    padding: clamp(1.25rem, 2.6vw, 1.6rem);
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--borde);
    box-shadow: var(--shadow-sm);
  }
  .det__ico {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-bottom: 0.85rem;
    border-radius: 11px;
    background: var(--i-hielo);
    border: 1px solid var(--borde);
    color: var(--i-azul-600);
  }
  .det__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1rem;
    line-height: 1.3;
    color: var(--azul-petroleo);
    margin-bottom: 0.45rem;
  }
  .det__p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--azul-pizarra);
  }

  @media (min-width: 760px) {
    .din__detalles {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
