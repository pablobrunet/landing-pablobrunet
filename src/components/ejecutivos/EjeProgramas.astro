---
/* =====================================================================
   LOS TRES PROGRAMAS — /programa-ejecutivos
   ---------------------------------------------------------------------
   El del medio va marcado como destacado: fondo oscuro y botón blanco.
   Es el mismo que tiene página propia, así que su tarjeta enlaza al
   resumen además de ofrecer el contacto.
   ===================================================================== */
import { ejecutivos } from "../../data/ejecutivos";
const { programas } = ejecutivos.home;
const { agenda } = ejecutivos.enlaces;
const { programa: rutaPrograma } = ejecutivos.rutas;
---

<section class="ej-sec ej-sup-baja epg" id="soluciones">
  <div class="ej-wrap">
    <header class="epg__head ej-reveal">
      <h2 class="ej-h2">{programas.titulo}</h2>
      <p class="ej-lead">{programas.subtitulo}</p>
    </header>

    <div class="epg__grid">
      {
        programas.items.map((prog) => (
          <article class:list={["epg__card", "ej-reveal", prog.destacado && "epg__card--destacada"]}>
            <div class="epg__cuerpo">
              <p class="epg__publico">{prog.publico}</p>
              <h3 class="ej-h3 epg__nombre">{prog.nombre}</h3>

              <dl class="epg__datos">
                <div>
                  <dt>Objetivo</dt>
                  <dd>{prog.objetivo}</dd>
                </div>
                <div>
                  <dt>Formato</dt>
                  <dd>{prog.formato}</dd>
                </div>
              </dl>
            </div>

            <div class="epg__acciones">
              {prog.destacado && (
                <a class="epg__resumen" href={rutaPrograma}>
                  Ver el resumen del programa
                </a>
              )}
              <a
                class="epg__cta"
                href={agenda}
                target="_blank"
                rel="noopener noreferrer"
              >
                {programas.cta}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .epg__head {
    max-width: 44rem;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
    text-align: center;
    display: grid;
    gap: 1rem;
  }
  .epg__grid {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .epg__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .epg__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
    min-height: 450px;
    padding: clamp(2rem, 4vw, 3rem);
    border-radius: var(--e-r-3xl);
    background: var(--e-sup);
    border: 1px solid var(--e-linea);
    box-shadow: var(--e-sombra-amb);
    transition: transform 300ms ease, box-shadow 300ms ease;
  }
  .epg__card:hover {
    transform: scale(1.02);
    box-shadow: var(--e-sombra-prem);
  }
  .epg__card--destacada {
    background: var(--e-navy);
    border-color: transparent;
    color: #ffffff;
  }

  .epg__cuerpo {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  .epg__publico {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--e-acento);
  }
  .epg__card--destacada .epg__publico {
    color: rgba(255, 255, 255, 0.6);
  }
  .epg__card--destacada .epg__nombre {
    color: #ffffff;
  }

  .epg__datos {
    display: grid;
    gap: 1.5rem;
  }
  .epg__datos dt {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.6;
    margin-bottom: 0.35rem;
  }
  .epg__datos dd {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--e-texto);
  }
  .epg__card--destacada .epg__datos dd {
    color: rgba(255, 255, 255, 0.92);
  }

  .epg__acciones {
    display: grid;
    gap: 0.85rem;
  }
  .epg__resumen {
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--e-celeste);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color var(--transition);
  }
  .epg__resumen:hover {
    color: #ffffff;
  }
  .epg__cta {
    display: block;
    width: 100%;
    padding: 1rem;
    border-radius: var(--e-r-xl);
    text-align: center;
    font-weight: 700;
    background: var(--e-grad);
    color: #ffffff;
    transition: background var(--transition), color var(--transition);
  }
  .epg__cta:hover {
    background: linear-gradient(135deg, #4c86f5 0%, #1747c2 55%, #12306b 100%);
  }
  .epg__card--destacada .epg__cta {
    background: #ffffff;
    color: var(--e-azul-900);
    box-shadow: none;
  }
  .epg__card--destacada .epg__cta:hover {
    background: var(--e-neblina);
  }

  @media (prefers-reduced-motion: reduce) {
    .epg__card,
    .epg__card:hover {
      transform: none;
      transition: none;
    }
  }
</style>
