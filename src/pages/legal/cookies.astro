---
import Page from "../../layouts/Page.astro";
import PageHero from "../../components/PageHero.astro";
import { site } from "../../data/site";
---

<Page title={`Política de cookies — ${site.nombre}`} cta={false}>
  <PageHero
    eyebrow="Legal"
    title="Política de cookies"
    crumbs={[{ label: "Cookies" }]}
  />
  <section class="section">
    <div class="container legal">
      <p class="text-muted note">
        COMPLETAR: reemplazá este texto por tu política de cookies real. Si el
        sitio no usa cookies de terceros todavía, dejalo indicado acá.
      </p>
      <h2 class="t-h3">1. Qué son las cookies</h2>
      <p>COMPLETAR.</p>
      <h2 class="t-h3">2. Cookies que usa este sitio</h2>
      <p>COMPLETAR.</p>
      <h2 class="t-h3">3. Cómo gestionarlas</h2>
      <p>COMPLETAR.</p>
      <h2 class="t-h3">4. Contacto</h2>
      <p>Consultas: <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Page>

<style>
  .legal {
    max-width: 68ch;
  }
  .legal h2 {
    margin-top: 2rem;
  }
  .legal p {
    margin-top: 0.6rem;
    color: var(--azul-pizarra);
    line-height: 1.7;
  }
  .legal a {
    color: var(--verde-acento-oscuro);
  }
  .note {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--verde-acento);
    background: var(--gris-claro);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
</style>
