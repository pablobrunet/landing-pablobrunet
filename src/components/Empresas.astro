---
/* =====================================================================
   EMPRESAS QUE CONFÍAN — franja angosta con carrusel infinito.
   La pista se duplica y se desplaza -50%, así el loop no tiene costura.
   ===================================================================== */
import { empresasMeta, empresas } from "../data/empresas";
import { sinMarcas } from "../lib/texto";

const secuencia = [...empresas, ...empresas];
---

{
  empresas.length > 0 && (
<section class="emp" aria-label="Empresas que confían">
  <div class="container">
    <p class="emp__title t-caption center">{sinMarcas(empresasMeta.titulo)}</p>
  </div>

  <div class="emp__marquee">
    <ul class="emp__track">
      {
        secuencia.map((e, i) => (
          <li class="emp__item" aria-hidden={i >= empresas.length ? "true" : undefined}>
            {e.img ? (
              <img src={e.img} alt={e.nombre} loading="lazy" decoding="async" />
            ) : (
              <span class="emp__nombre">{e.nombre}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
  )
}

<style>
  .emp {
    padding-block: 1.6rem;
    background: var(--gris-claro);
    border-block: 1px solid var(--borde);
  }
  .emp__title {
    margin-bottom: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: var(--w-subheadline);
    color: var(--texto-suave);
  }

  .emp__marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .emp__track {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 5vw, 3.75rem);
    width: max-content;
    animation: emp-scroll 42s linear infinite;
  }
  .emp__marquee:hover .emp__track {
    animation-play-state: paused;
  }
  @keyframes emp-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .emp__item {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    height: 46px;
  }
  /* Gris por defecto, color al pasar el mouse: unifica logos de estilos
     muy distintos y evita que la franja se vuelva un arcoíris. */
  .emp__item img {
    max-height: 30px;
    width: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.62;
    transition: filter var(--transition), opacity var(--transition);
  }
  .emp__item:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  /* Sin logo todavía: el nombre en texto mantiene la tira en pie. */
  .emp__nombre {
    font-weight: var(--w-subheadline);
    font-size: 0.875rem;
    color: var(--azul-pizarra);
    white-space: nowrap;
    padding: 0.4rem 0.9rem;
    border: 1px dashed var(--borde-punteado);
    border-radius: var(--radius-pill);
  }

  @media (prefers-reduced-motion: reduce) {
    .emp__track {
      animation: none;
    }
    .emp__marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      padding-inline: var(--gutter);
    }
    .emp__item img {
      filter: grayscale(0);
      opacity: 1;
    }
  }
</style>
