---
import Base from "./Base.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CtaBanner from "../components/CtaBanner.astro";

/* Acepta todo lo que acepta Base (título, descripción, imagen, datos
   estructurados…) y se lo pasa tal cual. */
type BaseProps = import("./Base.astro").Props;
interface Props extends BaseProps {
  cta?: boolean; // muestra el banner de CTA final antes del footer
}
const { cta = true, ...base } = Astro.props;
---

<Base {...base}>
  <Navbar />
  <main>
    <slot />
    {cta && <CtaBanner />}
  </main>
  <Footer />
</Base>
