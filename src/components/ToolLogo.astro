---
/* =====================================================================
   LOGOS DE HERRAMIENTAS (monocromos, heredan `currentColor`)
   ---------------------------------------------------------------------
   Son versiones simplificadas y monocromas de cada marca, dibujadas
   inline para que el carrusel cargue sin pedidos extra y se vea uniforme.
   ¿Querés los logos oficiales a color? Subilos a /public/images/logos/ y
   poné la ruta en el campo `img` de site.ts → herramientas.logos.
   Ese archivo tiene prioridad sobre el dibujo de acá.
   ===================================================================== */
interface Props {
  name: string; // clave de la marca
  size?: number;
}
const { name, size = 22 } = Astro.props;

// Rayos del "destello" de Claude: 12 pétalos girados alrededor del centro.
const rayosClaude = Array.from({ length: 12 }, (_, i) => i * 30);
---

{
  /* ---- ChatGPT ---- */
  name === "chatgpt" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.911 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.98 4.182a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.998-2.9 6.056 6.056 0 0 0-.748-7.073Zm-9.022 12.608a4.476 4.476 0 0 1-2.876-1.04l.142-.08 4.778-2.759a.795.795 0 0 0 .393-.68v-6.738l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.495 4.494ZM3.6 18.304a4.471 4.471 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .781 0l5.843-3.369v2.333a.08.08 0 0 1-.034.062L9.74 19.95a4.499 4.499 0 0 1-6.14-1.646ZM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973v5.677a.766.766 0 0 0 .388.677l5.815 3.354-2.02 1.169a.076.076 0 0 1-.071 0l-4.83-2.787A4.504 4.504 0 0 1 2.34 7.872Zm16.597 3.856-5.833-3.388L15.12 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.104v-5.677a.79.79 0 0 0-.407-.667Zm2.01-3.023-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.41 9.23V6.897a.066.066 0 0 1 .028-.062l4.83-2.786a4.499 4.499 0 0 1 6.68 4.66ZM8.307 12.863l-2.02-1.164a.08.08 0 0 1-.038-.057V6.074a4.499 4.499 0 0 1 7.376-3.453l-.142.08-4.778 2.759a.795.795 0 0 0-.393.68Zm1.097-2.365 2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5Z" />
    </svg>
  )
}

{
  /* ---- Claude: destello de rayos ---- */
  name === "claude" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      {rayosClaude.map((deg) => (
        <path
          d="M12 12 C10.5 8.9 10.2 5.3 12 1.9 C13.8 5.3 13.5 8.9 12 12 Z"
          transform={`rotate(${deg} 12 12)`}
        />
      ))}
      {/* Núcleo: evita que los doce pétalos se afinen hasta desaparecer. */}
      <circle cx="12" cy="12" r="1.6" />
    </svg>
  )
}

{
  /* ---- Gemini: destello de cuatro puntas ---- */
  name === "gemini" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 0.6c.55 6.1 4.75 10.3 10.85 10.85v1.1C16.75 13.1 12.55 17.3 12 23.4c-.55-6.1-4.75-10.3-10.85-10.85v-1.1C7.25 10.9 11.45 6.7 12 .6Z" />
    </svg>
  )
}

{
  /* ---- n8n: nodos encadenados ---- */
  name === "n8n" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <line x1="5.4" y1="12" x2="9.6" y2="12" />
      <line x1="14.4" y1="12" x2="17" y2="7.2" />
      <line x1="14.4" y1="12" x2="17" y2="16.8" />
      <circle cx="3.2" cy="12" r="2.2" fill="currentColor" stroke="none" />
      <circle cx="12" cy="12" r="2.6" />
      <circle cx="19.2" cy="6.4" r="2.1" fill="currentColor" stroke="none" />
      <circle cx="19.2" cy="17.6" r="2.1" fill="currentColor" stroke="none" />
    </svg>
  )
}

{
  /* ---- Supabase: rayo ---- */
  name === "supabase" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M13.55 1.2 4.3 12.35a.9.9 0 0 0 .7 1.47h7.05v8.98l9.25-11.15a.9.9 0 0 0-.7-1.47H13.55Z" />
    </svg>
  )
}

{
  /* ---- Notion: la N dentro de la página ---- */
  name === "notion" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="2.6" y="3.4" width="18.8" height="17.2" rx="2.6" />
      <path d="M8.9 16.6V7.6l6.2 9V7.6" />
    </svg>
  )
}

{
  /* ---- Google Workspace: la G ---- */
  name === "google" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21.35 11.1h-9.17v2.98h5.27c-.5 2.5-2.6 3.94-5.27 3.94a5.98 5.98 0 1 1 3.9-10.53l2.24-2.24A9.16 9.16 0 1 0 12.18 21.3c4.6 0 8.78-3.35 8.78-9.16 0-.54-.08-1.07-.2-1.58Z" />
    </svg>
  )
}

{
  /* ---- Vercel: el triángulo ---- */
  name === "vercel" && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2.4 23 21.6H1Z" />
    </svg>
  )
}

{
  /* ---- GoHighLevel: flecha ascendente encuadrada ---- */
  name === "gohighlevel" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="4.6" />
      <path d="M7.4 15.4 11 11.2l2.6 2.2 3.2-4.4" />
      <path d="M14.1 8.6h2.9v2.9" />
    </svg>
  )
}

{
  /* ---- Sin dibujo cargado: punto neutro para no romper la fila ---- */
  ![
    "chatgpt",
    "claude",
    "gemini",
    "n8n",
    "supabase",
    "notion",
    "google",
    "vercel",
    "gohighlevel",
  ].includes(name) && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <circle cx="12" cy="12" r="8" />
    </svg>
  )
}
