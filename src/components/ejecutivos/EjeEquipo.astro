---
/* =====================================================================
   QUIÉNES SOMOS — /programa-ejecutivos
   ---------------------------------------------------------------------
   Dos perfiles. Las fotos van en blanco y negro y recuperan el color al
   pasar el mouse, igual que en el mosaico de la sección de pilares.
   "Conocer más" lleva al mini sitio de cada uno (EjePerfil.astro).
   ===================================================================== */
import { ejecutivos } from "../../data/ejecutivos";
const { equipo } = ejecutivos.home;
---

<section class="ej-sec ej-sup eq" id="equipo">
  <div class="ej-wrap">
    <header class="eq__head ej-reveal">
      <h2 class="ej-h2">{equipo.titulo}</h2>
      <p class="ej-lead">{equipo.subtitulo}</p>
    </header>

    <div class="eq__grid">
      {
        equipo.personas.map((p) => (
          <article class="eq__card ej-reveal">
            <figure class="eq__foto">
              <img src={p.img} alt={p.nombre} loading="lazy" referrerpolicy="no-referrer" />
              <span class="eq__velo" aria-hidden="true" />
            </figure>

            <h3 class="ej-h4 eq__nombre">{p.nombre}</h3>
            <p class="eq__rol">{p.rol}</p>
            <p class="ej-p eq__bio">{p.bio}</p>

            <div class="eq__acciones">
              <a class="eq__mas" href={p.masInfo}>
                Conocer más sobre {p.nombre.split(" ")[0]} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .eq__head {
    max-width: 56rem;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
    text-align: center;
    display: grid;
    gap: 1rem;
  }
  .eq__grid {
    display: grid;
    gap: 3rem;
    max-width: 64rem;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .eq__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .eq__card {
    display: grid;
    gap: 0.65rem;
    align-content: start;
  }
  .eq__foto {
    position: relative;
    aspect-ratio: 1;
    margin-bottom: 0.85rem;
    border-radius: var(--e-r-4xl);
    overflow: hidden;
    border: 1px solid var(--e-linea);
    box-shadow: var(--e-sombra-del);
  }
  .eq__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 700ms ease;
  }
  .eq__card:hover .eq__foto img {
    filter: grayscale(0);
  }
  .eq__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 27, 61, 0.2), transparent);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .eq__card:hover .eq__velo {
    opacity: 1;
  }

  .eq__rol {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--e-acento);
  }
  .eq__bio {
    margin-top: 0.65rem;
    margin-bottom: 0.85rem;
  }

  .eq__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .eq__mas {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    background: var(--e-grad);
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: var(--e-glow);
    transition: box-shadow var(--transition), transform 150ms ease;
  }
  .eq__mas:hover {
    box-shadow: var(--e-sombra-prem);
  }
  .eq__mas span {
    transition: transform var(--transition);
  }
  .eq__mas:hover span {
    transform: translateX(3px);
  }

</style>
