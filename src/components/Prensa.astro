---
import Icon from "./Icon.astro";
import Frame from "./Frame.astro";
import { sinMarcas } from "../lib/texto";
import { prensaMeta, notas } from "../data/prensa";
---

<div class="prensa">
  <header class="prensa__head">
    <span class="eyebrow">{prensaMeta.eyebrow}</span>
    <h2 class="t-h2">{sinMarcas(prensaMeta.titulo)}</h2>
    <p class="t-subhead text-muted">{prensaMeta.subtitulo}</p>
  </header>

  <div class="prensa__grid">
    {
      notas.map((n) => (
        <a href={n.url} class="card prensa__card" target="_blank" rel="noopener">
          <Frame
            src={n.img}
            label={`/images/prensa/${n.medio}.jpg`}
            alt={`${n.medio}: ${n.titulo}`}
            ratio="16/9"
            pos={n.imgPos}
            rounded={false}
          />

          <div class="prensa__body">
            <div class="prensa__logo">
              {n.logo ? (
                <img src={n.logo} alt={n.medio} loading="lazy" />
              ) : (
                <span class="prensa__medio">{n.medio}</span>
              )}
            </div>
            <blockquote class="prensa__cita">“{n.cita}”</blockquote>
            <h3 class="prensa__titulo">{n.titulo}</h3>
            <footer class="prensa__foot">
              <span class="t-caption text-muted">{n.fecha}</span>
              <span class="prensa__leer">
                Leer nota
                <Icon name="arrowUpRight" size={14} />
              </span>
            </footer>
          </div>
        </a>
      ))
    }
  </div>
</div>

<style>
  .prensa__head {
    max-width: 620px;
    margin-bottom: 2rem;
  }
  .prensa__head .t-subhead {
    margin-top: 0.75rem;
  }
  .prensa__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }

  /* La foto va al ras del borde superior; el texto, en su propio bloque. */
  .prensa__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--azul-petroleo);
  }
  .prensa__body {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem 1.5rem 1.5rem;
    flex-grow: 1;
  }
  .prensa__logo {
    display: flex;
    align-items: center;
    min-height: 24px;
  }
  .prensa__logo img {
    max-height: 26px;
    width: auto;
  }
  .prensa__medio {
    font-family: var(--font-title);
    font-size: 0.78rem;
    font-weight: var(--w-headline);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--verde-resalte);
  }
  .prensa__cita {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--azul-petroleo);
    flex-grow: 1;
  }
  .prensa__titulo {
    font-family: var(--font-title);
    font-size: 0.88rem;
    font-weight: var(--w-subheadline);
    line-height: 1.4;
    color: var(--texto-suave);
  }
  .prensa__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--borde);
  }
  .prensa__leer {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
    transition: gap var(--transition);
  }
  .prensa__card:hover .prensa__leer {
    gap: 0.55rem;
  }

  @media (min-width: 620px) {
    .prensa__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 940px) {
    .prensa__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
