---
import Breadcrumbs from "./Breadcrumbs.astro";
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  crumbs?: Crumb[];
}
const { eyebrow, title, subtitle, crumbs = [] } = Astro.props;
---

<section class="pagehero">
  <svg class="pagehero__lines" viewBox="0 0 800 260" fill="none" aria-hidden="true">
    <path d="M-20 180 C 200 180 240 70 460 70 S 760 30 840 30" />
    <path d="M-20 230 C 240 230 280 130 500 130 S 780 90 860 90" />
    <circle cx="460" cy="70" r="5" />
  </svg>
  <div class="container pagehero__inner">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} />}
    {eyebrow && <span class="eyebrow pagehero__eyebrow">{eyebrow}</span>}
    <h1 class="t-h1">{title}</h1>
    {subtitle && <p class="t-subhead text-muted pagehero__sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .pagehero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 3.5rem);
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(59, 163, 154, 0.08), transparent 55%),
      var(--gris-claro);
    border-bottom: 1px solid var(--borde);
  }
  .pagehero__lines {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(65%, 760px);
    height: 100%;
    stroke: var(--verde-azulado);
    stroke-width: 1.5;
    opacity: 0.35;
    pointer-events: none;
  }
  .pagehero__lines circle {
    fill: var(--verde-acento);
  }
  .pagehero__inner {
    position: relative;
    max-width: 780px;
  }
  .pagehero__eyebrow {
    margin-top: 1rem;
  }
  .pagehero__sub {
    margin-top: 0.85rem;
  }
</style>
