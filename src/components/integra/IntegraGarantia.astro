---
/* =====================================================================
   LA GARANTÍA — de sistema instalado
   ---------------------------------------------------------------------
   Nada de sellos tipo "garantía 100%": un bloque sobrio, con lo que
   cubre, lo que no y lo que la empresa acepta. Va justo después de
   "quién hace qué" porque recién ahí se entiende qué se está
   garantizando.

   ⚠️ La "garantía de implementación" de versiones anteriores está
   eliminada. No volver a prometer "implementamos y medimos al menos un
   caso dentro del ciclo" en ningún lugar de la landing, la FAQ, el VSL,
   los anuncios ni la página de gracias.
   ===================================================================== */
import { integra } from "../../data/integra";
const { garantia } = integra;
---

<section class="section i-claro" id="garantia" aria-label="La garantía">
  <div class="container">
    <div class="gar i-reveal">
      <div class="gar__cabecera">
        <span class="gar__escudo" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" />
            <path d="M9 12l2 2 4-4" />
          </svg>
        </span>
        <div>
          <span class="i-eyebrow">{garantia.eyebrow}</span>
          <h2 class="t-h2 gar__titulo">{garantia.titulo}</h2>
        </div>
      </div>

      <p class="gar__texto">{garantia.texto}</p>

      <div class="gar__grid">
        {
          garantia.bloques.map((b) => (
            <div class="gar__bloque">
              <h3 class="gar__bt">{b.titulo}</h3>
              <ul>
                {b.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <p class="gar__cierre">{garantia.cierre}</p>
    </div>
  </div>
</section>

<style>
  .gar {
    padding: clamp(1.6rem, 4vw, 3rem);
    border-radius: var(--radius-lg);
    border: 1.5px solid rgba(30, 92, 242, 0.28);
    background:
      radial-gradient(120% 130% at 0% 0%, rgba(76, 134, 245, 0.1), transparent 55%),
      var(--i-hielo-2);
  }
  .gar__cabecera {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    margin-bottom: 1.25rem;
  }
  .gar__escudo {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: var(--i-grad);
    color: #fff;
    box-shadow: var(--i-glow);
  }
  .gar__titulo {
    margin-top: 0.35rem;
  }
  .gar__texto {
    max-width: 62rem;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: #fff;
    border-left: 4px solid var(--i-azul-600);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--azul-petroleo);
  }
  .gar__grid {
    display: grid;
    gap: 1.15rem;
    margin-top: 1.75rem;
  }
  .gar__bloque {
    padding: 1.25rem;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--borde);
  }
  .gar__bt {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--verde-resalte);
    margin-bottom: 0.75rem;
  }
  .gar__bloque ul {
    display: grid;
    gap: 0.45rem;
  }
  .gar__bloque li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--azul-pizarra);
  }
  .gar__bloque li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--i-azul-500);
  }
  .gar__cierre {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--texto-suave);
  }

  @media (min-width: 820px) {
    .gar__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
