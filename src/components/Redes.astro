---
/* =====================================================================
   REDES SOCIALES — bloque grande, debajo de las charlas grabadas.
   Cada tarjeta lleva el glifo de la marca y toma su color al pasar el
   mouse: en reposo van todas en gris para que la fila se lea como una
   unidad y no como cuatro logos peleando entre sí.
   ===================================================================== */
import RedLogo from "./RedLogo.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
const { redesMeta, redes } = site;
---

<div class="redes">
  <header class="redes__head">
    <span class="eyebrow">{redesMeta.eyebrow}</span>
    <h2 class="t-h2">{redesMeta.titulo}</h2>
    <p class="t-subhead text-muted redes__sub">{redesMeta.subtitulo}</p>
  </header>

  <ul class="redes__grid">
    {
      redes.map((r) => (
        <li>
          <a
            class:list={["red", `red--${r.icon}`]}
            href={r.href}
            target="_blank"
            rel="noopener"
            aria-label={`${r.label}: ${r.handle}`}
          >
            <span class="red__logo">
              <RedLogo name={r.icon} size={34} />
            </span>
            <span class="red__txt">
              <strong>{r.label}</strong>
              <span>{r.handle}</span>
            </span>
            <Icon name="arrowUpRight" size={16} class="red__flecha" />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .redes__head {
    max-width: 620px;
    margin-bottom: 2rem;
  }
  .redes__sub {
    margin-top: 0.75rem;
  }
  .redes__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .red {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.35rem 1.5rem;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    color: var(--azul-petroleo);
    transition: transform var(--transition), box-shadow var(--transition),
      border-color var(--transition);
  }
  .red:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: currentColor;
  }
  .red__logo {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 15px;
    background: var(--gris-claro);
    color: var(--azul-petroleo);
    transition: background var(--transition), color var(--transition);
  }
  .red__txt {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    flex-grow: 1;
  }
  .red__txt strong {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.02rem;
  }
  .red__txt span {
    font-size: 0.85rem;
    color: var(--texto-suave);
    overflow-wrap: anywhere;
  }
  .red__flecha {
    color: var(--borde-punteado);
    flex-shrink: 0;
    transition: color var(--transition), transform var(--transition);
  }
  .red:hover .red__flecha {
    color: currentColor;
    transform: translate(2px, -2px);
  }

  /* Cada red toma su color de marca sólo al pasar el mouse. */
  .red--linkedin:hover {
    color: #0a66c2;
  }
  .red--youtube:hover {
    color: #ff0000;
  }
  .red--instagram:hover {
    color: #d62976;
  }
  .red--tiktok:hover {
    color: #010101;
  }
  .red:hover .red__logo {
    background: currentColor;
    color: var(--blanco);
  }

  @media (min-width: 560px) {
    .redes__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .redes__grid {
      grid-template-columns: repeat(4, 1fr);
    }
    /* En cuatro columnas la tarjeta se apila para no comprimir el texto. */
    .red {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.1rem;
      padding: 1.6rem 1.5rem;
    }
    .red__flecha {
      position: absolute;
    }
    .red {
      position: relative;
    }
    .red__flecha {
      top: 1.6rem;
      right: 1.5rem;
    }
  }
</style>
