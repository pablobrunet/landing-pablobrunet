---
/* =====================================================================
   /programa-integra/gracias — confirmación después de agendar
   ---------------------------------------------------------------------
   Se muestra tras reservar en el calendario de GoHighLevel. El redirect
   post-booking se configura DEL LADO DE GHL, en el calendario del Método
   INTEGRA (rx4hxRbfbinJEsJoBWWF): apuntalo a
   https://pablobrunet.com/programa-integra/gracias

   Pide una sola acción: sumar al referente interno a la invitación. Es lo
   que más mejora la reunión y no compite con nada más.
   ===================================================================== */
import "../../styles/integra.css";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import logoIntegra from "../../assets/integra/integra-lockup-blanco.png";
import { integra } from "../../data/integra";
import { site } from "../../data/site";

const { gracias, whatsapp, marca } = integra;
const wa = `https://wa.me/${site.whatsapp.numero}?text=${encodeURIComponent(
  "Hola Pablo, agendé el diagnóstico del Método INTEGRA y necesito reprogramarlo."
)}`;
---

<Base
  title={`${gracias.titulo} — ${marca.metodo}`}
  description="Tu reunión de diagnóstico quedó agendada."
  waMensaje={whatsapp.mensaje}
  waEtiqueta={whatsapp.etiqueta}
>
  <Navbar />
  <main>
    <section class="gr i-oscuro">
      <div class="gr__fondo" aria-hidden="true">
        <span class="gr__halo"></span>
        <span class="trama gr__trama"></span>
      </div>

      <div class="container gr__inner">
        <Image
          class="gr__logo"
          src={logoIntegra}
          alt="Método INTEGRA"
          widths={[220, 440]}
          sizes="220px"
          formats={["webp"]}
          loading="eager"
        />

        <span class="gr__tilde" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12l4 4 10-10" />
          </svg>
        </span>

        <h1 class="t-display gr__titulo">{gracias.titulo}</h1>
        <p class="gr__sub">{gracias.subtitulo}</p>

        <div class="gr__cards">
          <article class="gr__card">
            <h2 class="t-h3">{gracias.queEsperar.titulo}</h2>
            <ul class="gr__lista">
              {
                gracias.queEsperar.items.map((it) => (
                  <li>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12l4 4 10-10" />
                    </svg>
                    <span>{it}</span>
                  </li>
                ))
              }
            </ul>
          </article>

          <article class="gr__card gr__card--pedido">
            <h2 class="t-h3">{gracias.pedido.titulo}</h2>
            <p>{gracias.pedido.texto}</p>
          </article>
        </div>

        <div class="gr__acciones">
          <a href="/programa-integra" class="btn btn--primary">{gracias.volver}</a>
          <a href={wa} target="_blank" rel="noopener" class="gr__wa">¿Necesitás reprogramar? Escribime</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .gr {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #0a1430, #0d1b3d);
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .gr__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .gr__halo {
    position: absolute;
    top: -18rem;
    left: 50%;
    transform: translateX(-50%);
    width: 48rem;
    height: 40rem;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.45;
    background: radial-gradient(circle, rgba(76, 134, 245, 0.6), transparent 70%);
  }
  .gr__trama {
    position: absolute;
    inset: 0;
    opacity: 0.3;
  }
  .gr__inner {
    position: relative;
    max-width: 860px;
    text-align: center;
  }
  .gr__logo {
    display: block;
    width: auto;
    height: clamp(1.9rem, 4vw, 2.5rem);
    margin: 0 auto 2rem;
  }
  .gr__tilde {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    margin: 0 auto 1.5rem;
    border-radius: 50%;
    background: var(--i-grad);
    color: #fff;
    box-shadow: 0 0 0 12px rgba(169, 200, 245, 0.14), var(--i-glow);
  }
  .gr__titulo {
    font-size: clamp(1.9rem, 1.3rem + 2.6vw, 3rem);
  }
  .gr__sub {
    max-width: 42rem;
    margin: 1rem auto 0;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(220, 230, 246, 0.78);
  }
  .gr__cards {
    display: grid;
    gap: 1.15rem;
    margin-top: 2.5rem;
    text-align: left;
  }
  .gr__card {
    padding: clamp(1.35rem, 3vw, 1.85rem);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .gr__card h2 {
    color: var(--i-neblina);
    margin-bottom: 0.9rem;
  }
  .gr__card p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(220, 230, 246, 0.8);
  }
  .gr__card--pedido {
    background: rgba(169, 200, 245, 0.09);
    border-color: rgba(169, 200, 245, 0.28);
  }
  .gr__lista {
    display: grid;
    gap: 0.75rem;
  }
  .gr__lista li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(220, 230, 246, 0.82);
  }
  .gr__lista svg {
    flex-shrink: 0;
    margin-top: 4px;
    color: var(--i-celeste);
  }
  .gr__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .gr__wa {
    font-size: 0.9rem;
    color: rgba(220, 230, 246, 0.7);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .gr__wa:hover {
    color: var(--i-neblina);
  }

  @media (min-width: 820px) {
    .gr__cards {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
</style>
