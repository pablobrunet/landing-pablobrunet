# =====================================================================
# Conexión con Supabase — captura de correos
# ---------------------------------------------------------------------
# Copiá este archivo como `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.
#
# En Vercel: Settings -> Environment Variables. Cargá las mismas tres,
# para Production y Preview.
#
# El prefijo PUBLIC_ es obligatorio en Astro para que la variable llegue
# al navegador. La clave queda visible en el JS compilado: es correcto,
# la publishable key está hecha para eso. Lo que protege la tabla es la
# política RLS de solo-inserción, no el secreto de la clave.
# =====================================================================

# Supabase -> Project Settings -> Data API -> Project URL
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API Keys -> pestaña "API Keys"
# Es la que empieza con sb_publishable_  (NO la secret key: esa nunca va acá)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Nombre de la tabla. Si usás otro, cambialo acá.
PUBLIC_SUPABASE_TABLA=leads

# ---------------------------------------------------------------------
# Si tu proyecto todavía usa la clave anterior (eyJhbGci...), podés poner
# PUBLIC_SUPABASE_ANON_KEY en su lugar: el código la lee como respaldo.
# Supabase da de baja las anon/service_role a fines de 2026, así que
# conviene migrar a la publishable.
# ---------------------------------------------------------------------
