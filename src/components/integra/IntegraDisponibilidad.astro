---
/* =====================================================================
   DISPONIBILIDAD — el empujón corto, justo antes del calendario
   ---------------------------------------------------------------------
   Va entre las preguntas y el cierre: cuando ya no quedan objeciones, lo
   único que falta es la razón para reservar hoy. Es un bloque de paso —
   el CTA es un ancla a #agenda-integra, que está acá nomás abajo.

   Una tarjeta en dos columnas separadas por una línea: a la izquierda el
   argumento (título, bajada y los tres refuerzos en fichas), a la derecha
   la escasez y el botón. En una sola columna el botón quedaba al final de
   un bloque largo de texto; acá entra en el mismo golpe de vista que el
   título. Abajo de 900px se apilan y la línea pasa a ser horizontal.

   La escasez es la real (se trabaja con pocas PyMEs a la vez, ~25 h por
   PyME por ciclo): no convertirla en contador de lugares ni en cuenta
   regresiva. Si el texto deja de ser cierto, se saca la sección.
   ===================================================================== */
import Icon from "../Icon.astro";
import { integra } from "../../data/integra";
const { disponibilidad, anclas } = integra;
---

<section class="section i-hielo i-claro" id="disponibilidad" aria-label="Disponibilidad">
  <div class="container">
    <div class="disp i-reveal">
      <!-- ---------- Columna del argumento ---------- -->
      <div class="disp__arg">
        <span class="disp__raya" aria-hidden="true"></span>
        <h2 class="t-h2 disp__titulo">{disponibilidad.titulo}</h2>
        <p class="disp__texto">{disponibilidad.texto}</p>

        <ul class="disp__refuerzos">
          {
            disponibilidad.refuerzos.map((r) => (
              <li class="disp__ficha">
                <span class="disp__ficha-ico" aria-hidden="true">
                  <Icon name={r.icono} size={19} />
                </span>
                <span>{r.texto}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- ---------- Columna de la reserva ---------- -->
      <div class="disp__accion">
        <div class="disp__aviso">
          <span class="disp__aviso-ico" aria-hidden="true">
            <Icon name="calendario" size={22} />
          </span>
          <div>
            <p class="disp__nota">{disponibilidad.nota}</p>
            <p class="disp__nota-pie">{disponibilidad.notaPie}</p>
          </div>
        </div>

        {/* Los íconos van envueltos en spans propios: el CSS de este
            componente está scopeado y no alcanza al SVG que devuelve
            <Icon />, que es de otro componente. */}
        <a href={`#${anclas.agenda}`} class="btn btn--primary disp__cta">
          <span class="disp__cta-ico" aria-hidden="true"><Icon name="calendario" size={20} /></span>
          <span class="disp__cta-txt">{disponibilidad.cta}</span>
          <span class="disp__cta-flecha" aria-hidden="true"><Icon name="arrow" size={20} /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .disp {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
    max-width: 1080px;
    margin-inline: auto;
    padding: clamp(1.75rem, 4vw, 3.5rem);
    border-radius: clamp(20px, 2vw, 30px);
    background: #fff;
    border: 1px solid var(--borde);
    box-shadow: var(--shadow);
  }

  /* ---------- Argumento ---------- */
  /* La rayita azul reemplaza al eyebrow: marca el inicio del bloque sin
     sumar otra etiqueta en mayúsculas a una landing que ya tiene dos. */
  .disp__raya {
    display: block;
    width: 44px;
    height: 4px;
    border-radius: 99px;
    background: var(--i-azul-600);
    margin-bottom: 1.5rem;
  }
  .disp__titulo {
    font-size: clamp(1.7rem, 1.15rem + 2.4vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
  }
  .disp__texto {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: clamp(1rem, 0.97rem + 0.2vw, 1.15rem);
    line-height: 1.55;
    color: var(--azul-pizarra);
  }
  .disp__refuerzos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--borde);
  }
  .disp__ficha {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: 1 1 13rem;
    padding: 0.7rem 0.9rem;
    border-radius: 14px;
    border: 1px solid var(--borde);
    background: var(--i-hielo-2);
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--azul-petroleo);
  }
  .disp__ficha-ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(76, 134, 245, 0.12);
    color: var(--i-azul-600);
  }

  /* ---------- Reserva ---------- */
  .disp__accion {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 3vw, 2rem);
  }
  .disp__aviso {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .disp__aviso-ico {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(76, 134, 245, 0.12);
    color: var(--i-azul-600);
  }
  .disp__nota {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--verde-resalte);
  }
  .disp__nota-pie {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--texto-suave);
  }
  /* Botón ancho, con el ícono y la flecha en los extremos: el destino
     ("ver horarios") y el gesto de avanzar quedan claros sin leer. */
  .disp__cta {
    justify-content: flex-start;
    gap: 0.85rem;
    width: 100%;
    padding: 1.15rem 1.4rem;
    border-radius: 16px;
    font-size: 1.05rem;
    white-space: normal;
    text-align: left;
    line-height: 1.25;
  }
  .disp__cta-txt {
    flex-grow: 1;
  }
  .disp__cta-ico,
  .disp__cta-flecha {
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .disp__cta-flecha {
    transition: transform var(--transition);
  }
  .disp__cta:hover .disp__cta-flecha {
    transform: translateX(4px);
  }

  @media (min-width: 900px) {
    .disp {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(2.5rem, 5vw, 4rem);
    }
    /* La línea divisoria va acá y no como borde de la tarjeta: apilado
       molestaría, así que solo existe cuando hay dos columnas. */
    .disp__accion {
      padding-left: clamp(2.5rem, 5vw, 4rem);
      border-left: 1px solid var(--borde);
    }
  }
</style>
