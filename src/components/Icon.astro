  /* Las redes NO van acá. Sus logos son marcas con silueta maciza y
     dibujarlas con este pincel de línea daba aproximaciones caseras: una
     "in" hecha de palitos, un rectángulo con un triángulo adentro. Los
     glifos oficiales viven en RedLogo.astro, que es lo que usan la barra,
     el pie y la sección de redes. */
};

const d = paths[name] ?? "";
const segments = d.split(" M ").map((s, i) => (i === 0 ? s : "M " + s));
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {segments.map((seg) => <path d={seg} />)}
</svg>
