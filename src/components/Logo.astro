---
import { site } from "../data/site";
/* Logo aproximado en CSS/SVG: monograma "PB" + wordmark.
   El SVG definitivo del brand board va en /public/images/brand/logo.svg;
   cuando lo tengas, podés reemplazar este componente por una <img>. */
interface Props {
  light?: boolean; // true = para fondos oscuros
  showTagline?: boolean;
}
const { light = false, showTagline = true } = Astro.props;
---

<a
  href="#inicio"
  class:list={["logo", { "logo--light": light }]}
  aria-label={`${site.nombre} — ${site.tagline}`}
>
  <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 40 40" width="40" height="40">
      <rect width="40" height="40" rx="11" fill="var(--mark-bg)" />
      <text
        x="50%"
        y="53%"
        text-anchor="middle"
        dominant-baseline="central"
        font-family="var(--font-base)"
        font-weight="700"
        font-size="18"
        letter-spacing="-0.5"
        fill="var(--mark-fg)">PB</text
      >
    </svg>
  </span>
  <span class="logo__text">
    <span class="logo__name">{site.nombre}</span>
    {showTagline && <span class="logo__tag">{site.tagline}</span>}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    --mark-bg: var(--azul-petroleo);
    --mark-fg: var(--verde-acento);
  }
  .logo--light {
    --mark-bg: var(--verde-acento);
    --mark-fg: var(--azul-petroleo);
  }
  .logo__mark svg {
    display: block;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .logo__name {
    font-weight: var(--w-headline);
    font-size: 1.15rem;
    color: var(--azul-petroleo);
    letter-spacing: -0.01em;
  }
  .logo--light .logo__name {
    color: var(--blanco);
  }
  .logo__tag {
    font-size: 0.7rem;
    font-weight: var(--w-body);
    color: var(--verde-azulado);
    letter-spacing: 0.01em;
  }
</style>
