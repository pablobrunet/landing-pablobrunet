---
/* =====================================================================
   MURO DE COMENTARIOS — tres filas infinitas cruzadas
   ---------------------------------------------------------------------
   Tres tiras pegadas una encima de la otra que se mueven sin parar y en
   direcciones contrarias:

     fila 1 →  hacia la derecha
     fila 2 ←  hacia la izquierda
     fila 3 →  hacia la derecha

   Ese cruce es lo que da la sensación de movimiento. Las tarjetas son
   chicas y todas del mismo alto a propósito: el bloque se lee de un
   vistazo, no comentario por comentario.

   FOTOS INTERCALADAS
   Cada dos comentarios entra una foto de Pablo, del mismo alto que las
   tarjetas (`cadaCuantos` cambia el ritmo). Rompe la monotonía de la tira
   de texto y recuerda de quién se está hablando.

   CÓMO SE ARMA EL LOOP
   Los items de cada fila se duplican. Cada fila es un `overflow-x: auto`
   de verdad (no una animación de `transform`), y un script mueve su
   `scrollLeft` con requestAnimationFrame: cuando llega al ancho de una
   copia, se resetea a 0 y no se ve la costura. Al ser scroll nativo, el
   dedo la mueve solo (touch-action: pan-x) y el mouse la arrastra con los
   handlers de pointer del script — sin el enganche que daba el `:hover`
   de CSS, que en celular quedaba trabado al tocar. El aire entre tarjetas
   va como `margin-right` de cada celda y NO como `gap` del flex: con
   `gap`, la mitad exacta del ancho no coincide con el largo de una copia
   —queda medio hueco de diferencia— y el loop pega un salto en cada vuelta.

   La duración (script) se calcula con la cantidad de items, así las tres
   filas se mueven a la misma velocidad aunque una tenga más tarjetas que
   otra.

   La segunda copia va con `aria-hidden`: el lector de pantalla lee cada
   comentario una sola vez.
   ===================================================================== */
import type { Comentario, FotoMuro } from "../data/testimonios";
import { sinMarcas } from "../lib/texto";

interface Props {
  comentarios: Comentario[];
  fotos?: FotoMuro[];
  eyebrow?: string;
  titulo: string;
  /* Solo tema INTEGRA: el fragmento que va pintado del título. */
  tituloResalte?: string;
  subtitulo?: string;
  /* "sitio" usa el encabezado del home; "integra", el de la landing azul. */
  tema?: "sitio" | "integra";
  /* Fondo de la sección. En INTEGRA el muro va después del método, que ya
     es hielo: ahí conviene "blanco". */
  fondo?: "blanco" | "tint";
  filas?: number;
  /* Cuántos comentarios entre foto y foto. */
  cadaCuantos?: number;
  id?: string;
}

const {
  comentarios,
  fotos = [],
  eyebrow,
  titulo,
  tituloResalte,
  subtitulo,
  tema = "sitio",
  fondo = "tint",
  filas = 3,
  cadaCuantos = 2,
  id,
} = Astro.props;

type Item =
  | { tipo: "cita"; cita: Comentario }
  | { tipo: "foto"; foto: FotoMuro };

/* ---- 1. La secuencia: N comentarios, una foto, y de nuevo ---- */
const secuencia: Item[] = [];
comentarios.forEach((c, i) => {
  secuencia.push({ tipo: "cita", cita: c });
  if (fotos.length > 0 && (i + 1) % cadaCuantos === 0) {
    secuencia.push({
      tipo: "foto",
      foto: fotos[Math.floor(i / cadaCuantos) % fotos.length],
    });
  }
});

/* ---- 2. Se reparte en filas, en tramos seguidos ----
   Seguidos y no salteados: si se repartiera uno a cada fila, con el patrón
   "dos citas y una foto" una fila entera terminaría siendo solo fotos. Con
   tramos, cada fila conserva el ritmo. */
const porFila = Math.ceil(secuencia.length / filas);
const tramos = Array.from({ length: filas }, (_, i) =>
  secuencia.slice(i * porFila, (i + 1) * porFila)
);

/* ---- 3. Cada fila tiene que sobrar de ancho ----
   Si un tramo es corto, media pista mide menos que la pantalla y se ve el
   hueco entre copia y copia. Se repite el tramo hasta un mínimo. */
const MINIMO = 7;
const completar = (items: Item[]): Item[] => {
  if (items.length === 0) return items;
  /* De a uno y no de a tandas enteras: repetir el tramo completo podía
     dejar una fila con el doble de items que las otras. */
  const salida = [...items];
  while (salida.length < MINIMO) salida.push(items[salida.length % items.length]);
  return salida;
};

const carriles = tramos
  .filter((t) => t.length > 0)
  .map((items, i) => {
    const llenos = completar(items);
    return {
      items: llenos,
      /* Impares hacia la izquierda: 1ª →, 2ª ←, 3ª →. */
      derecha: i % 2 === 0,
      /* ~6 s por tarjeta: las tres filas van a la misma velocidad. */
      duracion: llenos.length * 6,
    };
  });

const pie = (c: Comentario) => [c.rol, c.origen].filter(Boolean).join(" · ");
---

<section
  class:list={[
    "muro-sec",
    "section",
    { "section--tint": fondo === "tint" },
    /* `i-claro` avisa a integra.css que el fondo es claro: sin eso, el
       resalte del título sale en degradé para fondo oscuro. */
    { "i-claro": tema === "integra" },
  ]}
  id={id}
  aria-label="Comentarios y testimonios"
>
  <div class="container">
    {
      tema === "integra" ? (
        <header class="i-head i-head--centro i-reveal">
          {eyebrow && <span class="i-eyebrow">{eyebrow}</span>}
          <h2 class="t-h2">
            {sinMarcas(titulo)} {tituloResalte && <span class="i-hl">{tituloResalte}</span>}
          </h2>
          {subtitulo && <p class="text-muted">{subtitulo}</p>}
        </header>
      ) : (
        <header class="muro-sec__head">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          <h2 class="t-h2">{sinMarcas(titulo)}</h2>
          {subtitulo && <p class="t-subhead text-muted muro-sec__sub">{subtitulo}</p>}
        </header>
      )
    }
  </div>

  <div class="muro" data-muro>
    {
      carriles.map((carril) => (
        <div
          class="muro__fila"
          data-fila
          data-dir={carril.derecha ? "der" : "izq"}
          data-duracion={carril.duracion}
        >
          <div class="muro__pista">
            {[...carril.items, ...carril.items].map((item, idx) => (
              <div
                class="muro__celda"
                aria-hidden={idx >= carril.items.length ? "true" : undefined}
              >
                {item.tipo === "foto" ? (
                  <div class="muro__foto">
                    <img
                      src={item.foto.img}
                      alt={idx >= carril.items.length ? "" : item.foto.alt}
                      style={item.foto.pos ? `object-position:${item.foto.pos}` : undefined}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                ) : (
                  <figure class="muro__cita">
                    <blockquote class="muro__texto">{item.cita.texto}</blockquote>
                    <div class="muro__pie">
                      <figcaption class="muro__autor">
                        <span class="muro__nombre">{item.cita.nombre}</span>
                        {pie(item.cita) && <span class="muro__rol">{pie(item.cita)}</span>}
                      </figcaption>
                      <div class="muro__estrellas" aria-hidden="true">
                        {Array.from({ length: 5 }).map(() => (
                          <svg class="muro__estrella" viewBox="0 0 24 24">
                            <path d="M12 4l2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.5-4.8 2.5.9-5.4L4.2 9.7l5.4-.8z" />
                          </svg>
                        ))}
                      </div>
                    </div>
                  </figure>
                )}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  /* Arrastre con mouse + scroll nativo con el dedo, en vez de la animación
     CSS de antes. Con :hover se paraba TODO el muro al tocar en celular,
     porque el navegador aplica :hover a lo que tocaste y no lo saca hasta
     que tocás otra cosa: quedaba trabado. Acá el scroll es real
     (`overflow-x: auto` en cada fila) y el auto-scroll es JS con
     `scrollLeft`, así que tocar y arrastrar simplemente mueve la fila,
     sin ese enganche. */
  function initMuros() {
    document.querySelectorAll<HTMLElement>("[data-muro]").forEach((muro) => {
      if (muro.dataset.listo) return;
      muro.dataset.listo = "1";

      const filas = Array.from(muro.querySelectorAll<HTMLElement>("[data-fila]"));
      if (!filas.length) return;

      const reducido = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const carriles = filas.map((fila) => {
        const pista = fila.querySelector<HTMLElement>(".muro__pista");
        /* dir: -1 recorre la fila de derecha a izquierda descontando
           scrollLeft; +1 la recorre sumando. `mitad` es el ancho de una
           sola copia (el contenido va duplicado): al llegar a ese punto
           se ve idéntico al arranque, así que ahí se reinicia el conteo
           sin que se note la costura. */
        const dir = fila.dataset.dir === "der" ? -1 : 1;
        const duracion = parseFloat(fila.dataset.duracion || "60");
        let mitad = pista ? pista.scrollWidth / 2 : 0;
        if (dir === -1) fila.scrollLeft = mitad;

        let arrastrando = false;
        let punteroId: number | null = null;
        let inicioX = 0;
        let inicioScroll = 0;
        /* Cuánto se frena el auto-scroll después de tocar/arrastrar: da
           tiempo a que termine el "momentum" del scroll táctil antes de
           que el JS retome el control. */
        let pausadoHasta = 0;
        const marcarInteraccion = () => {
          pausadoHasta = performance.now() + 900;
        };

        window.addEventListener("resize", () => {
          if (pista) mitad = pista.scrollWidth / 2;
        });

        /* El arrastre con mouse hay que armarlo a mano: el navegador no
           deja "clickear y arrastrar" un div con overflow, a diferencia
           del dedo en celular que sí scrollea nativo. */
        fila.addEventListener("pointerdown", (e) => {
          if (e.pointerType !== "mouse") return;
          arrastrando = true;
          punteroId = e.pointerId;
          fila.setPointerCapture(punteroId);
          inicioX = e.clientX;
          inicioScroll = fila.scrollLeft;
          fila.classList.add("muro__fila--arrastrando");
        });
        fila.addEventListener("pointermove", (e) => {
          if (!arrastrando || e.pointerId !== punteroId || !mitad) return;
          const delta = e.clientX - inicioX;
          const next = ((inicioScroll - delta) % mitad + mitad) % mitad;
          fila.scrollLeft = next;
          marcarInteraccion();
        });
        const soltar = (e: PointerEvent) => {
          if (punteroId !== null && e.pointerId !== punteroId) return;
          arrastrando = false;
          punteroId = null;
          fila.classList.remove("muro__fila--arrastrando");
          marcarInteraccion();
        };
        fila.addEventListener("pointerup", soltar);
        fila.addEventListener("pointercancel", soltar);
        /* El dedo ya scrollea solo (overflow-x + touch-action: pan-x):
           acá solo se anota que hubo interacción, para frenar el
           auto-scroll mientras dura. */
        fila.addEventListener("touchstart", marcarInteraccion, { passive: true });
        fila.addEventListener("touchmove", marcarInteraccion, { passive: true });
        /* Solo un gesto horizontal de verdad (trackpad): un scroll vertical
           de la página pasando por acá no tiene por qué frenar el muro. */
        fila.addEventListener(
          "wheel",
          (e) => {
            if (Math.abs(e.deltaX) > 0) marcarInteraccion();
          },
          { passive: true }
        );

        return {
          fila,
          dir,
          duracion,
          get mitad() {
            return mitad;
          },
          estaArrastrando: () => arrastrando,
          pausadoHasta: () => pausadoHasta,
        };
      });

      /* Con motion reducido no hay auto-scroll: la fila queda quieta y se
         recorre solo a mano (arrastre o dedo). */
      if (reducido) return;

      let sobreMouse = false;
      muro.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") sobreMouse = true;
      });
      muro.addEventListener("pointerleave", (e) => {
        if (e.pointerType === "mouse") sobreMouse = false;
      });

      let anterior: number | null = null;
      const paso = (t: number) => {
        if (anterior === null) anterior = t;
        const dt = (t - anterior) / 1000;
        anterior = t;
        const ahora = performance.now();
        for (const carril of carriles) {
          if (sobreMouse || carril.estaArrastrando() || ahora < carril.pausadoHasta()) continue;
          const mitad = carril.mitad;
          if (!mitad) continue;
          const velocidad = mitad / carril.duracion;
          const next =
            ((carril.fila.scrollLeft + carril.dir * velocidad * dt) % mitad + mitad) % mitad;
          carril.fila.scrollLeft = next;
        }
        requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    });
  }

  initMuros();
  document.addEventListener("astro:page-load", initMuros);
</script>

<style>
  /* El muro sale de la caja: las tiras van de borde a borde, si no el
     movimiento parece empezar y terminar contra un margen. */
  .muro-sec {
    overflow: hidden;
  }
  .muro-sec__head {
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
    text-align: center;
  }
  .muro-sec__sub {
    margin-top: 0.75rem;
  }
  .muro-sec :global(.i-head) {
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .muro {
    /* Alto de la tira y ancho de la tarjeta: de acá sale todo el tamaño. */
    --muro-alto: clamp(154px, 16.5vw, 172px);
    --muro-ancho: clamp(296px, 82vw, 410px);
    /* Pegadas: el mismo aire entre filas y entre tarjetas. */
    --muro-aire: 0.85rem;
    /* Aire que cada fila reserva adentro para su propia sombra: la fila
       recorta lo que se sale (`overflow: hidden`) y sin este colchón la
       sombra de las tarjetas quedaba cortada al ras. Se descuenta del
       hueco entre filas, así el aire que se ve sigue siendo el mismo. */
    --muro-sombra: 5px;

    display: grid;
    gap: max(0px, calc(var(--muro-aire) - var(--muro-sombra) * 2));
    /* Los bordes se desvanecen: las tarjetas entran y salen en vez de
       cortarse contra el filo de la pantalla. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .muro__fila {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: var(--muro-sombra);
    /* El auto-scroll lo mueve JS con `scrollLeft`; esto habilita que el
       dedo también lo mueva con scroll nativo, sin bloquear el scroll
       vertical de la página al pasar por acá. */
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
    scrollbar-width: none;
  }
  .muro__fila::-webkit-scrollbar {
    display: none;
  }
  .muro__fila--arrastrando {
    cursor: grabbing;
  }
  .muro__fila--arrastrando,
  .muro__fila--arrastrando * {
    user-select: none;
  }
  .muro__pista {
    display: flex;
    width: max-content;
  }

  /* El aire va como margen de cada celda y no como `gap` de la pista: ver
     la nota del encabezado del archivo. */
  .muro__celda {
    flex: 0 0 auto;
    height: var(--muro-alto);
    margin-right: var(--muro-aire);
  }

  .muro__cita {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: var(--muro-ancho);
    height: 100%;
    padding: 1rem 1.15rem;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  /* Cuatro líneas como máximo: sin el recorte, un comentario largo
     estiraría su tarjeta y rompería la línea de la tira. El ancho y el alto
     de arriba están calculados para que el mensaje más largo de los que hay
     hoy entre entero; si suma uno bastante más largo, se corta con puntos
     suspensivos en vez de desarmar la fila. */
  .muro__texto {
    flex: 1 1 auto;
    min-height: 0;
    font-size: 0.9rem;
    line-height: 1.42;
    color: var(--azul-petroleo);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }
  /* Las comillas las pone el diseño, no el texto del comentario. */
  .muro__texto::before {
    content: "\201C";
  }
  .muro__texto::after {
    content: "\201D";
  }
  /* Autor a la izquierda, calificación a la derecha: mismo renglón, sin
     sumarle alto a la tarjeta. */
  .muro__pie {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .muro__autor {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
    /* Filete de color: ata el pie de la tarjeta a la paleta de la página
       (verde en el sitio, azul en INTEGRA, sin tocar nada). */
    padding-left: 0.55rem;
    border-left: 2px solid var(--verde-acento);
  }
  .muro__nombre {
    font-size: 0.88rem;
    font-weight: var(--w-headline);
    color: var(--azul-petroleo);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .muro__rol {
    font-size: 0.76rem;
    color: var(--texto-suave);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* Decorativas: no son una calificación real que haya puesto la persona,
     así que van con aria-hidden y no reemplazan el texto del comentario. */
  .muro__estrellas {
    display: flex;
    flex: 0 0 auto;
    gap: 0.1rem;
  }
  .muro__estrella {
    width: 12px;
    height: 12px;
    fill: #f4b400;
  }

  /* La foto ocupa un bloque de la tira: mismo alto que las tarjetas y el
     ancho que le da su proporción. */
  .muro__foto {
    height: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--gris-claro);
    box-shadow: var(--shadow-sm);
  }
  .muro__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Sin auto-scroll (lo frena el script): el degradé de los bordes deja de
     tener sentido si la fila queda quieta, se ve como contenido cortado. */
  @media (prefers-reduced-motion: reduce) {
    .muro {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
