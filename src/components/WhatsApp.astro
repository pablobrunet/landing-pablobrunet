---
/* =====================================================================
   BOTÓN FLOTANTE DE WHATSAPP (abajo a la derecha)
   ---------------------------------------------------------------------
   Va en el layout base, así aparece en todas las páginas.
   wa.me es el enlace oficial: abre la app en el celular y WhatsApp Web en
   la computadora, sin cargar ningún script de terceros.
   ===================================================================== */
import { site } from "../data/site";
const { whatsapp } = site;

const href = `https://wa.me/${whatsapp.numero}?text=${encodeURIComponent(whatsapp.mensaje)}`;
---

<a
  class="wa"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={whatsapp.etiqueta}
  title={whatsapp.etiqueta}
>
  <span class="wa__texto">{whatsapp.etiqueta}</span>
  <span class="wa__icono">
    <svg viewBox="0 0 24 24" width="27" height="27" fill="currentColor" aria-hidden="true">
      <path
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.966 1.164-.198.199-.396.223-.693.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.446.52-.669.174-.223.232-.383.347-.643.114-.26.057-.482-.024-.68-.081-.198-.669-1.611-.916-2.207-.245-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
      ></path>
    </svg>
  </span>
</a>

<style>
  .wa {
    /* Debajo del navbar (z-index 100) para no taparlo si algo se superpone. */
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 90;

    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem;
    border-radius: var(--radius-pill);
    /* Verde propio de WhatsApp: se reconoce al instante y no compite con la
       paleta de marca porque está fuera del flujo de la página. */
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 10px 26px rgba(11, 31, 42, 0.26);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .wa:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgba(11, 31, 42, 0.32);
  }

  .wa__icono {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  /* El texto aparece al pasar el mouse: en reposo es solo el círculo. */
  .wa__texto {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.9rem;
    font-weight: var(--w-subheadline);
    opacity: 0;
    transition: max-width var(--transition), opacity var(--transition),
      padding var(--transition);
  }
  .wa:hover .wa__texto,
  .wa:focus-visible .wa__texto {
    max-width: 15rem;
    opacity: 1;
    padding-left: 0.75rem;
  }

  /* En pantallas táctiles no hay hover: queda solo el círculo. */
  @media (hover: none) {
    .wa__texto {
      display: none;
    }
  }

  @media print {
    .wa {
      display: none;
    }
  }
</style>
