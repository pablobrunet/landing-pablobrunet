---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import WhatsApp from "../components/WhatsApp.astro";
import { site } from "../data/site";
import { absoluta, canonica, grafoSitio } from "../lib/seo";

interface Props {
  title?: string;
  description?: string;
  /* Mensaje precargado del botón flotante. La landing del Método INTEGRA
     lo cambia para que el chat abra diciendo de dónde viene la consulta. */
  waMensaje?: string;
  waEtiqueta?: string;
  mostrarWhatsapp?: boolean;
  /* Páginas que se comparten por enlace directo y no son contenido del
     sitio — las cotizaciones para un cliente concreto, por ejemplo — se
     marcan con `noindex` para que no aparezcan en buscadores. */
  noindex?: boolean;
  /* Favicon propio de una vertical con otra marca (el anexo Programas AI
     First). Sin esto, va el del sitio. */
  icono?: string;
  /* Imagen al compartir el enlace (WhatsApp, LinkedIn) y en las tarjetas
     de buscadores. Ruta del sitio; sin esto va la foto general de TEDIND-X. */
  imagen?: string;
  /* "article" en los artículos del blog: suma fecha y autor. */
  tipo?: "website" | "article";
  publicado?: string; // ISO
  actualizado?: string; // ISO
  /* Bloques extra de datos estructurados para esta página (el programa,
     un artículo, sus migas de pan). Se suman al grafo base del sitio. */
  esquema?: Record<string, unknown>[];
}

const {
  title = `${site.nombre} | Consultor de IA para PyMEs en Argentina`,
  description = site.seoDescription,
  waMensaje,
  waEtiqueta,
  mostrarWhatsapp = true,
  noindex = false,
  icono = "/images/logos/logo%20v3%20-%20transparente.png?v=4",
  imagen = "/images/og/og.jpg",
  tipo = "website",
  publicado,
  actualizado,
  esquema = [],
} = Astro.props;

/* Una sola dirección por página (www, sin barra final). Las páginas con
   `noindex` no la llevan: no tiene sentido declarar la versión oficial de
   algo que no se quiere en Google. */
const urlCanonica = canonica(Astro.url.pathname);
const imagenAbsoluta = absoluta(imagen);
const datosEstructurados = noindex
  ? null
  : JSON.stringify({ "@context": "https://schema.org", "@graph": [...grafoSitio(), ...esquema] })
      // Un "</script>" dentro de un texto cerraría el bloque antes de tiempo.
      .replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={urlCanonica} />}

    <!-- Vista previa al compartir (WhatsApp, LinkedIn, X). La imagen va con
         URL absoluta: con una relativa, varias redes no la encuentran. -->
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagenAbsoluta} />
    {imagen === "/images/og/og.jpg" && <meta property="og:image:width" content="1200" />}
    {imagen === "/images/og/og.jpg" && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {publicado && <meta property="article:published_time" content={publicado} />}
    {actualizado && <meta property="article:modified_time" content={actualizado} />}
    {tipo === "article" && <meta property="article:author" content={absoluta("/sobre-mi")} />}

    <!-- Datos estructurados: quién es Pablo, qué ofrece y dónde, en el
         formato que leen Google y los asistentes de IA. Ver lib/seo.ts. -->
    {datosEstructurados && <script type="application/ld+json" set:html={datosEstructurados} />}

    <!-- Identidad del sitio en pestañas, favoritos y accesos directos.
         El nombre del archivo tiene espacios, así que va codificado (%20).
         El `?v=` es a propósito: los navegadores cachean el favicon con
         mucha insistencia y sin cambiarlo seguirían mostrando el viejo. -->
    <link rel="icon" type="image/png" href={icono} />
    <link rel="apple-touch-icon" href={icono} />

    <!-- Tipografía de marca: Google Sans Flex (variable) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..700&family=Sora:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <!-- Navegación instantánea entre páginas (sin recarga completa) -->
    <ViewTransitions />
  </head>
  <body>
    <slot />
    <!-- Botón flotante en todas las páginas -->
    {mostrarWhatsapp && <WhatsApp mensaje={waMensaje} etiqueta={waEtiqueta} />}
  </body>
</html>
