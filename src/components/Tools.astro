---
import { site } from "../data/site";
const { herramientas } = site;
---

<section class="tools section section--tint" aria-label="Herramientas">
  <div class="container">
    <p class="tools__title t-subhead center text-muted">{herramientas.titulo}</p>
    <ul class="tools__grid">
      {
        herramientas.logos.map((l) => (
          <li class="tools__item" title={l.nombre}>
            {l.img ? (
              <img src={l.img} alt={l.nombre} loading="lazy" />
            ) : (
              <span class="tools__name">{l.nombre}</span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="tools__note t-caption center text-muted">
      Editá esta lista en <code>src/data/site.ts</code> y subí los logos a
      <code>/public/images/logos/</code>.
    </p>
  </div>
</section>

<style>
  .tools__title {
    margin-bottom: 1.75rem;
  }
  .tools__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
  }
  .tools__item {
    display: grid;
    place-items: center;
    min-height: 84px;
    padding: 1rem;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-radius: var(--radius-sm);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .tools__item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }
  .tools__item img {
    max-height: 40px;
    width: auto;
    object-fit: contain;
  }
  .tools__name {
    font-weight: var(--w-subheadline);
    color: var(--azul-pizarra);
    font-size: 0.95rem;
  }
  .tools__note {
    margin-top: 1.5rem;
  }
  .tools__note code {
    font-size: 0.72rem;
    background: rgba(11, 31, 42, 0.06);
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
  }

  @media (min-width: 640px) {
    .tools__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media (min-width: 960px) {
    .tools__grid {
      grid-template-columns: repeat(8, 1fr);
    }
  }
</style>
