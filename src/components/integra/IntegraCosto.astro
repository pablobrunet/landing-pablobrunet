---
/* =====================================================================
   EL COSTO DE SEGUIR ASÍ
   ---------------------------------------------------------------------
   Es la palanca comercial central: convierte el dolor difuso en urgencia
   concreta. No habla de lo que la IA "va a costar" sino de la inversión
   que ya se está perdiendo hoy (suscripciones, capacitaciones, horas).
   ===================================================================== */
import { integra } from "../../data/integra";
const { costo, anclas } = integra;

/* Íconos de línea, dibujados acá porque son propios de esta sección. */
const iconos: Record<string, string> = {
  billete:
    "M3 7h18v10H3z M12 12m-2.5 0a2.5 2.5 0 1 0 5 0a2.5 2.5 0 1 0 -5 0 M6 10v.01 M18 14v.01",
  birrete: "M12 4L2 9l10 5 10-5-10-5z M6 11.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.5 M21 9v5",
  reloj: "M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0 M12 7v5l3.5 2",
};
---

<section class="section i-oscuro costo" aria-label="El costo de seguir así">
  <div class="costo__fondo" aria-hidden="true"><span class="trama"></span></div>

  <div class="container costo__inner">
    <header class="i-head i-reveal">
      <h2 class="t-h2">{costo.titulo}</h2>
    </header>

    <div class="costo__grid">
      {
        costo.bloques.map((b) => (
          <article class="costo__card i-reveal">
            <span class="costo__icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                {(iconos[b.icono] ?? "")
                  .split(" M ")
                  .map((seg, i) => <path d={i === 0 ? seg : "M " + seg} />)}
              </svg>
            </span>
            <h3 class="t-h3">{b.titulo}</h3>
            <p>{b.texto}</p>
          </article>
        ))
      }
    </div>

    <div class="costo__cierre i-reveal">
      <p>{costo.cierre}</p>
      <a href={`#${anclas.agenda}`} class="btn btn--primary">{costo.cta}</a>
    </div>
  </div>
</section>

<style>
  .costo {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #0a1430 0%, #0d1b3d 55%, #0a1430 100%);
  }
  .costo__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .costo__fondo span {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    -webkit-mask-image: radial-gradient(70% 70% at 80% 20%, #000, transparent 70%);
    mask-image: radial-gradient(70% 70% at 80% 20%, #000, transparent 70%);
  }
  .costo__inner {
    position: relative;
  }
  .costo__grid {
    display: grid;
    gap: 1.15rem;
  }
  .costo__card {
    padding: clamp(1.4rem, 3vw, 1.9rem);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }
  .costo__card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(169, 200, 245, 0.4);
    transform: translateY(-4px);
  }
  .costo__icono {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 1.1rem;
    border-radius: 14px;
    background: rgba(169, 200, 245, 0.13);
    border: 1px solid rgba(169, 200, 245, 0.24);
    color: var(--i-celeste);
  }
  .costo__card h3 {
    margin-bottom: 0.55rem;
  }
  .costo__card p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(220, 230, 246, 0.75);
  }

  .costo__cierre {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.6rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: rgba(169, 200, 245, 0.07);
    border: 1px solid rgba(169, 200, 245, 0.22);
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  .costo__cierre p {
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    font-size: clamp(1.1rem, 0.95rem + 0.9vw, 1.5rem);
    line-height: 1.4;
  }
  .costo__cierre .btn {
    justify-self: start;
    white-space: normal;
    text-align: center;
    line-height: 1.35;
  }

  @media (min-width: 760px) {
    .costo__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 980px) {
    .costo__cierre {
      grid-template-columns: 1.5fr auto;
      gap: 2.5rem;
    }
  }
</style>
