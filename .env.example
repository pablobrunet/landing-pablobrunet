# =====================================================================
# Conexión con Supabase — captura de correos
# ---------------------------------------------------------------------
# Copiá este archivo como `.env` y completá los valores.
# `.env` está en .gitignore: nunca se sube al repositorio.
#
# En Vercel: Settings -> Environment Variables. Cargá las mismas tres,
# para Production y Preview. Si conectaste la integración de Supabase,
# fijate si ya te creó variables equivalentes y copiá esos valores acá.
#
# El prefijo PUBLIC_ es obligatorio en Astro para que la variable llegue
# al navegador. La anon key queda visible en el JS compilado: es correcto,
# está diseñada para eso. Lo que protege la tabla es la política RLS.
# =====================================================================

# Supabase -> Project Settings -> Data API -> Project URL
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API Keys -> anon / public
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Nombre de la tabla. Si usás otro, cambialo acá.
PUBLIC_SUPABASE_TABLA=leads
