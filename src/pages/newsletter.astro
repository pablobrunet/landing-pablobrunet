---
import Page from "../layouts/Page.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
const { newsletter } = site;
---

<Page title={`Newsletter — ${site.nombre}`} cta={false}>
  <PageHero
    eyebrow={newsletter.eyebrow}
    title={newsletter.titulo}
    subtitle={newsletter.subtitulo}
    crumbs={[{ label: "Recursos", href: "/recursos" }, { label: "Newsletter" }]}
  />

  <section class="section">
    <div class="container nl">
      <p class="nl__name">{newsletter.nombreNewsletter}</p>

      <!--
        FORM SIN CONECTAR. Apuntá el `action` a tu proveedor (Mailchimp /
        Beehiiv / ConvertKit) o manejá el submit por JS.
      -->
      <form class="nl__form" data-newsletter onsubmit="return false">
        <label class="visually-hidden" for="nl-email">Email</label>
        <input
          id="nl-email"
          type="email"
          name="email"
          required
          placeholder={newsletter.placeholder}
          autocomplete="email"
        />
        <button type="submit" class="btn btn--primary">
          {newsletter.boton}
          <Icon name="mail" size={18} />
        </button>
      </form>

      <ul class="nl__perks">
        <li><Icon name="check" size={16} /> Novedades reales de IA aplicada</li>
        <li><Icon name="check" size={16} /> Casos y herramientas útiles</li>
        <li><Icon name="check" size={16} /> Sin spam. Te podés dar de baja cuando quieras.</li>
      </ul>
    </div>
  </section>
</Page>

<style>
  .nl {
    max-width: 620px;
  }
  .nl__name {
    font-weight: var(--w-headline);
    color: var(--verde-resalte);
    margin-bottom: 1.25rem;
  }
  .nl__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .nl__form input {
    flex: 1 1 240px;
    font-family: inherit;
    font-size: 1rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--borde);
    background: var(--blanco);
  }
  .nl__form input:focus {
    outline: none;
    border-color: var(--verde-acento);
  }
  .nl__perks {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .nl__perks li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--azul-pizarra);
  }
  .nl__perks :global(svg) {
    color: var(--verde-resalte);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>

<script>
  function initNl() {
    const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
    form?.addEventListener("submit", () => {
      alert("Formulario de ejemplo. Conectá tu proveedor de newsletter para activarlo.");
    });
  }
  initNl();
  document.addEventListener("astro:page-load", initNl);
</script>
