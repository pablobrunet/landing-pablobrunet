---
/* =====================================================================
   RETRATO RECORTADO (PNG con fondo transparente)
   ---------------------------------------------------------------------
   Marco fino y redondeado, del mismo radio que el resto de los marcos del
   sitio, y SIN relleno: el fondo de la sección se ve a través, así que la
   foto se integra en lugar de quedar pegada sobre una caja.

   La foto entra entera (`object-fit: contain`): nunca se recorta un brazo
   ni la cabeza. Como el PNG es cuadrado, el marco también lo es.
   ===================================================================== */
interface Props {
  src: string;
  alt: string;
  hover?: boolean; // el hero lo apaga
  /* `llenarAlto`: en escritorio la foto deja de ser cuadrada y toma el alto
     de su columna, así queda alineada con el final del texto de al lado.
     Para lograrlo pasa a `object-fit: cover`, pero lo único que se recorta
     son los márgenes transparentes del PNG: la figura no se toca. */
  llenarAlto?: boolean;
  class?: string;
}
const {
  src,
  alt,
  hover = true,
  llenarAlto = false,
  class: className = "",
} = Astro.props;
---

<figure
  class:list={[
    "retrato",
    { "retrato--hover": hover, "retrato--lleno": llenarAlto },
    className,
  ]}
>
  <span class="retrato__trama trama" aria-hidden="true"></span>

  <img src={src} alt={alt} decoding="async" />

  <span class="retrato__marco" aria-hidden="true"></span>
</figure>

<style>
  .retrato {
    position: relative;
    display: block;
    width: 100%;
    /* El PNG es cuadrado: con el marco cuadrado entra completo y al máximo. */
    aspect-ratio: 1 / 1;
    /* Sin fondo propio: se mezcla con el de la sección. */
    background: transparent;
    /* Recorte con la misma curva del marco: al ampliarse, la foto se mete
       por detrás del borde en lugar de pisarlo. */
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* Marco fino, mismo radio que las tarjetas y las fotos del resto del sitio. */
  .retrato__marco {
    position: absolute;
    inset: 0;
    border: 1px solid var(--borde);
    border-radius: var(--radius-lg);
    pointer-events: none;
  }
  /* Remate de acento sobre el borde superior, después de la curva. */
  .retrato__marco::before {
    content: "";
    position: absolute;
    /* En 0 y no en -1px: el contenedor recorta, y si sobresale se pierde. */
    top: 0;
    left: 2rem;
    width: 64px;
    height: 2px;
    border-radius: 2px;
    background: var(--verde-acento);
  }

  /* Trama de puntos: apoyo gráfico tenue arriba a la derecha. */
  .retrato__trama {
    position: absolute;
    top: 8%;
    right: 4%;
    width: 42%;
    height: 40%;
    opacity: 0.55;
    -webkit-mask-image: linear-gradient(215deg, #000, transparent 68%);
    mask-image: linear-gradient(215deg, #000, transparent 68%);
  }

  .retrato img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    /* Entera, sin recortes, en reposo. */
    object-fit: contain;
    object-position: bottom center;
    /* El origen arriba hace que al ampliarse crezca hacia abajo: la cabeza
       queda fija y lo que sobra por abajo lo tapa el marco. */
    transform-origin: top center;
    /* drop-shadow sigue el contorno recortado del PNG (box-shadow dibujaría
       la caja). Dos capas: un filo cerrado que despega la figura del fondo
       y una sombra abierta y muy suave que le da apoyo. */
    filter: drop-shadow(0 1px 1px rgba(11, 31, 42, 0.28))
      drop-shadow(0 10px 22px rgba(11, 31, 42, 0.16));
    transition: transform 600ms cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .retrato--hover:hover img {
    transform: scale(1.07);
  }

  /* ---- Variante que se estira a lo alto ----
     Sólo en escritorio: en mobile la columna es única y sin un texto al lado
     no hay nada con lo que alinearse, así que sigue cuadrada. */
  @media (min-width: 900px) {
    .retrato--lleno {
      height: 100%;
      aspect-ratio: auto;
    }
    .retrato--lleno img {
      /* `cover` en vez de `contain`: la figura crece hasta el alto disponible
         y lo que queda afuera son los márgenes transparentes del PNG. */
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .retrato--hover:hover img {
      transform: none;
    }
  }
</style>
