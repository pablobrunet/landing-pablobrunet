---
/* =====================================================================
   HERO — /programa-ejecutivos
   ---------------------------------------------------------------------
   Foto a sangre de fondo con un velo azul noche que va de opaco (donde
   está el texto) a transparente (donde se ve la sala). Encima, la promesa
   y los dos CTAs a la izquierda.
   ===================================================================== */
import EjeIcon from "./EjeIcon.astro";
import EjeFondoHero from "./EjeFondoHero.astro";
import { ejecutivos } from "../../data/ejecutivos";
const { hero } = ejecutivos.home;
const { agenda } = ejecutivos.enlaces;
---

<section class="ej-noche eh" id="inicio">
  {/* El orador y la pantalla están a la derecha de la foto: se ancla ahí
      para que en pantallas angostas no se pierdan. */}
  <EjeFondoHero src={hero.imagen} alt={hero.imagenAlt} posicion="70% 55%" />

  <div class="ej-wrap eh__grid">
    <div class="eh__copy">
      <p class="eh__chip">
        <EjeIcon name="rayo" size={14} />
        {hero.chip}
      </p>

      <h1 class="eh__titulo">
        {hero.titulo}<span class="eh__resalte">{hero.tituloResalte}</span>{hero.tituloCierre}
      </h1>

      <p class="eh__sub">{hero.subtitulo}</p>

      <div class="eh__ctas">
        <a
          class="ej-btn ej-btn--primary ej-btn--grande"
          href={agenda}
          target="_blank"
          rel="noopener noreferrer"
        >
          {hero.ctaPrimario}
        </a>
        <a class="ej-btn ej-btn--fantasma ej-btn--grande eh__ver" href="#soluciones">
          {hero.ctaSecundario}
          <EjeIcon name="flecha" size={20} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .eh {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    /* Ocupa casi toda la primera pantalla, descontando la barra */
    min-height: min(52rem, calc(100svh - var(--nav-alto)));
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .eh__grid {
    display: grid;
    gap: 3rem;
    align-items: end;
  }
  .eh__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .eh__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(169, 200, 245, 0.35);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    color: var(--e-celeste);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .eh__titulo {
    font-family: var(--font-title);
    font-weight: 800;
    font-size: clamp(2.125rem, 1.4rem + 2.6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #ffffff;
    max-width: 18ch;
  }
  .eh__resalte {
    display: block;
    color: var(--e-celeste);
    font-style: italic;
    font-weight: 500;
  }

  .eh__sub {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
  }

  .eh__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .eh__ver :global(svg) {
    transition: transform var(--transition);
  }
  .eh__ver:hover :global(svg) {
    transform: translateX(4px);
  }


  @media (max-width: 599px) {
    .eh__ctas .ej-btn {
      width: 100%;
    }
  }
</style>
