---
/* =====================================================================
   QUÉ QUEDA INSTALADO EN TU EMPRESA
   ---------------------------------------------------------------------
   Las tres capacidades, una tarjeta cada una y las tres con el mismo
   peso: es lo único que se promete al día 60.

   La columna de artefactos (workbook, repositorio, plan de 90 días) se
   sacó a propósito: enumerar documentos hacía leer el programa como una
   entrega de papeles y competía con lo que de verdad se vende, que es la
   capacidad que queda funcionando.
   ===================================================================== */
import { integra } from "../../data/integra";
const { instalado, anclas } = integra;
---

<section class="section i-claro" id="que-queda" aria-label="Qué queda instalado">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{instalado.eyebrow}</span>
      <h2 class="t-h2">{instalado.titulo}</h2>
      <p class="text-muted">{instalado.subtitulo}</p>
    </header>

    {/* <ul> y no <ol>: las tres capacidades no son pasos ordenados, y el
        reset de global.css sólo saca los marcadores de <ul> — con <ol> el
        navegador dibujaba "1. 2. 3." delante de cada tarjeta. */}
    <ul class="queda">
      {
        instalado.capacidades.items.map((it) => (
          <li class="queda__card i-reveal">
            <span class="queda__n" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12l4 4 10-10" />
              </svg>
            </span>
            <h3 class="queda__t">{it.titulo}</h3>
            <p class="text-muted">{it.texto}</p>
          </li>
        ))
      }
    </ul>

    <figure class="queda__cita i-reveal">
      <blockquote>{instalado.cita}</blockquote>
      <figcaption>{instalado.citaPie}</figcaption>
    </figure>

    <div class="queda__cta i-reveal">
      <a href={`#${anclas.agenda}`} class="btn btn--primary">{instalado.cta}</a>
    </div>
  </div>
</section>

<style>
  .queda {
    display: grid;
    gap: 1.25rem;
  }
  .queda__card {
    padding: clamp(1.35rem, 3vw, 1.85rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--borde);
    background: linear-gradient(180deg, var(--i-hielo-2), #fff 40%);
  }
  .queda__n {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 0.9rem;
    border-radius: 10px;
    background: var(--i-grad);
    color: #fff;
  }
  .queda__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .queda__card p {
    font-size: 0.925rem;
    line-height: 1.6;
  }

  .queda__cita {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.6rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--i-noche);
    color: #fff;
    text-align: center;
  }
  .queda__cita blockquote {
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    font-size: clamp(1.05rem, 0.9rem + 0.9vw, 1.45rem);
    line-height: 1.5;
    max-width: 52rem;
    margin-inline: auto;
  }
  .queda__cita blockquote::before,
  .queda__cita blockquote::after {
    content: '"';
    color: var(--i-celeste);
  }
  .queda__cita figcaption {
    margin-top: 1rem;
    font-size: var(--fs-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(220, 230, 246, 0.55);
  }
  .queda__cta {
    margin-top: 1.75rem;
    text-align: center;
  }

  @media (min-width: 860px) {
    .queda {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
