---
import { serviciosMeta, servicios, hrefServicio } from "../data/servicios";
import Icon from "./Icon.astro";
import Frame from "./Frame.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section class="services section section--tint" aria-label="Servicios">
  <div class="container">
    <SectionHeading
      eyebrow={serviciosMeta.eyebrow}
      title={serviciosMeta.titulo}
      subtitle={serviciosMeta.subtitulo}
      center
    />

    <div class="services__grid">
      {
        servicios.map((s) => (
          <a
            href={hrefServicio(s)}
            class="card service"
            target={s.externo ? "_blank" : undefined}
            rel={s.externo ? "noopener" : undefined}
          >
            {s.imgTarjeta && (
              <Frame
                  src={s.imgTarjeta}
                  alt={s.titulo}
                  ratio="16/10"
                  pos={s.imgTarjetaPos}
                  rounded={false}
                />
            )}
            <div class="service__body">
              <span class="service__icon">
                <Icon name={s.icon} size={26} />
              </span>
              <h3 class="t-h3">{s.titulo}</h3>
              <p class="text-muted service__text">{s.resumen}</p>
              <span class="service__cta">
                {s.externo ? "Ir a innerflowai.com" : "Ver servicio"}
                <Icon name="arrowUpRight" size={16} />
              </span>
            </div>
          </a>
        ))
      }
    </div>

    <div class="services__more">
      <a href="/servicios" class="btn btn--outline">Ver todos los servicios</a>
    </div>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .service {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .service__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.75rem;
    flex-grow: 1;
  }
  .service__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 13px;
    background: var(--azul-petroleo);
    color: var(--verde-acento);
    margin-bottom: 1.1rem;
  }
  .service__text {
    margin: 0.5rem 0 1.5rem;
    flex-grow: 1;
  }
  .service__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
    transition: gap var(--transition);
  }
  .service:hover .service__cta {
    gap: 0.7rem;
  }
  .services__more {
    margin-top: 2rem;
    text-align: center;
  }

  @media (min-width: 720px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 980px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
