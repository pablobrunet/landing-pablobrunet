---
/* =====================================================================
   NAVBAR DEL ANEXO /programa-ejecutivos
   ---------------------------------------------------------------------
   Es el mismo <Navbar /> de pablobrunet.com —mismo alto, tipografía,
   desplegables y menú mobile— pero con el menú propio del anexo
   (ejecutivos.nav): las secciones de la landing, el programa y "Quiénes
   somos". No trae los desplegables de Servicios/Recursos del sitio, así
   que no saca al visitante hacia el Método INTEGRA ni la automatización.

   La marca también es propia: el monograma "pAI" de Programas AI First
   con el nombre al lado (el logo completo trae la leyenda abajo, pero a
   la altura de la barra no se leería), y lleva al inicio del anexo.
   ===================================================================== */
import Navbar from "../Navbar.astro";
import { ejecutivos } from "../../data/ejecutivos";
const { inicio } = ejecutivos.rutas;
const { nav, marca } = ejecutivos;
---

<Navbar items={nav.items} cta={nav.cta} redes={false}>
  <a
    slot="marca"
    href={inicio}
    class="ejn__marca"
    aria-label={`${marca.nombre} — inicio`}
  >
    <img
      class="ejn__mark"
      src={marca.monograma}
      alt=""
      width="240"
      height="144"
      loading="eager"
    />
    <span class="ejn__nombre">{marca.nombre}</span>
  </a>
</Navbar>

<style>
  .ejn__marca {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .ejn__mark {
    display: block;
    height: 34px;
    width: auto;
  }
  .ejn__nombre {
    font-weight: var(--w-headline);
    font-size: 1.1rem;
    line-height: 1.1;
    color: var(--azul-petroleo);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
