---
/* =====================================================================
   OBJECIONES Y PREGUNTAS FRECUENTES
   ---------------------------------------------------------------------
   Desactiva los frenos reales del ICP (tiempo, "otro curso", "no somos
   técnicos", "¿lo hacen ustedes?", precio) justo antes del cierre.

   La respuesta 2 —"¿ustedes nos implementan las automatizaciones?"— es la
   respuesta estándar del brief: se usa igual en la Consultoría Estratégica Gratuita
   y en cualquier canal. No suavizarla acá.
   ===================================================================== */
import { integra } from "../../data/integra";
const { faq } = integra;
/* Otras versiones de la landing pueden pasar sus propias preguntas.
   Sin prop, las de siempre. Una respuesta puede tener varios párrafos:
   van separados por una línea en blanco ("\n\n").
   `respuestaVidrio`: la respuesta se abre en una ficha de vidrio esmerilado
   en lugar de quedar suelta sobre el azul (la usa la v2).
   `fondoClaro`: la sección va sobre el gris hielo de "Así se vive desde
   adentro" en lugar del azul noche, con tarjetas blancas (la usa la v2). */
interface Props {
  items?: { q: string; a: string }[];
  respuestaVidrio?: boolean;
  fondoClaro?: boolean;
}
const { items = faq.items, respuestaVidrio = false, fondoClaro = false } = Astro.props;
---

<section class:list={["section", fondoClaro ? "i-hielo i-claro" : "i-oscuro"]} id="preguntas" aria-label="Preguntas frecuentes">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <h2 class="t-h2">{faq.titulo}</h2>
    </header>

    <div class:list={["faq i-reveal", { "faq--vidrio": respuestaVidrio, "faq--claro": fondoClaro }]}>
      {
        items.map((f) => (
          <details class="faq__item" name="faq-integra" data-suave>
            <summary>
              <span>{f.q}</span>
              <span class="faq__signo" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="faq__resp">
              {f.a.split("\n\n").map((parrafo) => <p>{parrafo}</p>)}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    max-width: 840px;
    margin-inline: auto;
    display: grid;
    gap: 0.65rem;
  }
  /* Sección oscura: las tarjetas van en el mismo lenguaje que el resto de
     los bloques sobre azul profundo (velo blanco muy bajo + borde tenue). */
  .faq__item {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--transition), background var(--transition);
  }
  /* Abierta = celeste. Antes sólo cambiaba el borde y con varias preguntas
     en pantalla no se distinguía cuál estaba desplegada. Ahora se tiñe la
     tarjeta entera: fondo un punto más claro, borde marcado y la pregunta
     en celeste. */
  .faq__item[open]:not(.is-cerrando) {
    border-color: rgba(169, 200, 245, 0.42);
    background: rgba(255, 255, 255, 0.08);
  }
  .faq__item[open]:not(.is-cerrando) summary {
    color: var(--i-celeste);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1rem;
    color: #ffffff;
    transition: color var(--transition);
  }
  .faq__item:is(:not([open]), .is-cerrando) summary:hover {
    color: var(--i-celeste);
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__signo {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(169, 200, 245, 0.14);
    color: var(--i-celeste);
    transition: transform var(--transition), background var(--transition), color var(--transition);
  }
  .faq__item[open]:not(.is-cerrando) .faq__signo {
    transform: rotate(45deg);
    background: var(--i-grad);
    color: #fff;
  }
  .faq__resp {
    padding: 0 1.25rem 1.35rem;
  }
  .faq__resp p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgba(220, 230, 246, 0.82);
  }
  .faq__resp p + p {
    margin-top: 0.75rem;
  }

  /* Variante vidrio: la respuesta se abre en una ficha de vidrio esmerilado
     dentro de la tarjeta, del mismo azul de la sección. El fondo de la
     sección es liso, así que el desenfoque solo no se nota: el efecto lo
     hacen el velo celeste en diagonal, el borde claro y el brillo del
     canto superior. Entra con el mismo fundido del acordeón.
     (Antes era un panel blanco; Pablo prefirió esto, 2026-09-28.) */
  .faq--vidrio .faq__resp {
    margin: 0 0.7rem 0.7rem;
    padding: 1.1rem 1.25rem 1.25rem;
    border-radius: calc(var(--radius) - 4px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: linear-gradient(160deg, rgba(169, 200, 245, 0.16) 0%, rgba(76, 134, 245, 0.07) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 10px 28px rgba(5, 12, 32, 0.35);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(14px) saturate(140%);
  }
  .faq--vidrio .faq__resp p {
    color: rgba(236, 242, 252, 0.92);
  }

  /* Variante de fondo claro, como las preguntas de /servicios: tarjeta
     blanca con borde fino; al pasar el mouse aparece una sombra leve y
     abierta queda igual de blanca, sin panel de otro color adentro. La
     respuesta va directo sobre el blanco. */
  .faq--claro .faq__item {
    background: #fff;
    border-color: var(--borde);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .faq--claro .faq__item:hover,
  .faq--claro .faq__item[open]:not(.is-cerrando) {
    background: #fff;
    border-color: var(--borde);
    box-shadow: 0 10px 28px rgba(13, 27, 61, 0.08);
  }
  .faq--claro .faq__item summary,
  .faq--claro .faq__item[open]:not(.is-cerrando) summary,
  .faq--claro .faq__item:is(:not([open]), .is-cerrando) summary:hover {
    color: var(--i-navy);
  }
  .faq--claro .faq__signo {
    background: rgba(30, 92, 242, 0.08);
    color: var(--i-azul-600);
  }
  .faq--claro .faq__resp p {
    color: var(--texto-suave);
  }
</style>

<script>
  import { iniciarAcordeonSuave } from "../../scripts/acordeonSuave";
  iniciarAcordeonSuave();
  document.addEventListener("astro:page-load", iniciarAcordeonSuave);
</script>
