---
/* =====================================================================
   CIERRE + CALENDARIO EMBEBIDO
   ---------------------------------------------------------------------
   El CTA final sin fricción: el calendario está acá mismo, no hay que ir
   a otra página. Es el calendario del Método INTEGRA, distinto del
   calendario general de Pablo (ese vive en data/site.ts → agenda.id).

   El widget se monta recién cuando la sección se acerca al viewport
   (IntersectionObserver): así el script de LeadConnector no penaliza la
   carga inicial de una landing larga. `form_embed.js` es el que le ajusta
   el alto al iframe; se reinserta en cada navegación con View Transitions
   porque, si no, al volver queda con el alto por defecto.

   La escasez (4-5 empresas) es el techo real de carga operativa, no un
   recurso de venta: no inflarla ni convertirla en contador falso.
   ===================================================================== */
import { integra } from "../../data/integra";
import { site } from "../../data/site";
const { cierre, anclas, whatsapp } = integra;

const src = `https://api.leadconnectorhq.com/widget/booking/${cierre.calendarioId}`;
/* El id respeta el formato del snippet original de LeadConnector
   (`<calendarId>_<timestamp>`): su script lo usa para identificar el
   iframe al ajustarle el alto. Si regenerás el embed, pegá el id nuevo. */
const iframeId = `${cierre.calendarioId}_1786029066825`;
const wa = `https://wa.me/${site.whatsapp.numero}?text=${encodeURIComponent(whatsapp.mensaje)}`;
---

<section class="section i-oscuro cierre" id={anclas.agenda} aria-label="Agendar el diagnóstico gratuito">
  <div class="cierre__fondo" aria-hidden="true">
    <span class="cierre__halo"></span>
    <span class="trama cierre__trama"></span>
  </div>

  <div class="container cierre__inner">
    <div class="cierre__copy i-reveal">
      <span class="i-eyebrow">{cierre.eyebrow}</span>
      <h2 class="t-h2 cierre__titulo">{cierre.titulo}</h2>
      <p class="cierre__sub">{cierre.subtitulo}</p>

      <ul class="cierre__refuerzos">
        {
          cierre.refuerzos.map((r) => (
            <li>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l4 4 10-10" />
              </svg>
              {r}
            </li>
          ))
        }
      </ul>

      <p class="cierre__escasez">{cierre.escasez}</p>

      <div class="cierre__fallback">
        <span>{cierre.fallbackTitulo}</span>
        <a href={wa} target="_blank" rel="noopener" class="cierre__wa">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.966 1.164-.198.199-.396.223-.693.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.446.52-.669.174-.223.232-.383.347-.643.114-.26.057-.482-.024-.68-.081-.198-.669-1.611-.916-2.207-.245-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884" />
          </svg>
          {cierre.fallbackCta}
        </a>
      </div>
    </div>

    <div class="cierre__cal i-reveal" data-agenda-integra>
      <div class="cierre__marco">
        <div class="cierre__cargando" data-cargando>
          <span class="cierre__spinner" aria-hidden="true"></span>
          Cargando el calendario…
        </div>
        <iframe
          data-src={src}
          id={iframeId}
          title="Calendario del diagnóstico gratuito — Método INTEGRA"
          scrolling="no"
          hidden></iframe>
      </div>
      <noscript>
        <p class="cierre__noscript">
          Para reservar necesitás JavaScript activado, o escribinos a
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </noscript>
    </div>
  </div>
</section>

<style>
  .cierre {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #0a1430 0%, #0d1b3d 100%);
  }
  .cierre__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cierre__halo {
    position: absolute;
    top: -16rem;
    left: 50%;
    transform: translateX(-50%);
    width: 52rem;
    height: 40rem;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    background: radial-gradient(circle, rgba(76, 134, 245, 0.6), transparent 70%);
  }
  .cierre__trama {
    position: absolute;
    inset: 0;
    opacity: 0.3;
  }
  .cierre__inner {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .cierre__titulo {
    margin: 0.4rem 0 1rem;
  }
  .cierre__sub {
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(220, 230, 246, 0.78);
  }
  .cierre__refuerzos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .cierre__refuerzos li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(169, 200, 245, 0.1);
    border: 1px solid rgba(169, 200, 245, 0.26);
    font-size: 0.85rem;
    font-weight: var(--w-subheadline);
    color: var(--i-neblina);
  }
  .cierre__escasez {
    margin-top: 1.5rem;
    padding: 1rem 1.15rem;
    border-radius: var(--radius);
    border-left: 3px solid var(--i-celeste);
    background: rgba(255, 255, 255, 0.05);
    font-size: 0.925rem;
    line-height: 1.6;
    color: rgba(220, 230, 246, 0.88);
  }
  .cierre__fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
    font-size: 0.9rem;
    color: rgba(220, 230, 246, 0.65);
  }
  .cierre__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    background: rgba(37, 211, 102, 0.14);
    border: 1px solid rgba(37, 211, 102, 0.4);
    color: #7ff0ad;
    font-weight: var(--w-subheadline);
    transition: background var(--transition);
  }
  .cierre__wa:hover {
    background: rgba(37, 211, 102, 0.24);
  }

  /* ---- Calendario ---- */
  .cierre__marco {
    position: relative;
    min-height: 620px;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 30px 70px rgba(6, 12, 30, 0.5);
    overflow: hidden;
  }
  .cierre__marco iframe {
    display: block;
    width: 100%;
    min-height: 620px;
    border: 0;
    overflow: hidden;
  }
  .cierre__cargando {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.85rem;
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  .cierre__spinner {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 3px solid var(--borde);
    border-top-color: var(--i-azul-600);
    animation: cierre-giro 800ms linear infinite;
  }
  @keyframes cierre-giro {
    to {
      transform: rotate(360deg);
    }
  }
  .cierre__noscript {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: rgba(220, 230, 246, 0.7);
  }
  .cierre__noscript a {
    color: var(--i-neblina);
  }

  @media (min-width: 1000px) {
    .cierre__inner {
      grid-template-columns: 0.85fr 1.15fr;
      gap: 3rem;
    }
    .cierre__copy {
      position: sticky;
      top: calc(var(--nav-alto) + 1.5rem);
    }
  }
</style>

<script>
  const SRC = "https://link.msgsndr.com/js/form_embed.js";

  function montarAgendaIntegra() {
    const caja = document.querySelector<HTMLElement>("[data-agenda-integra]");
    if (!caja) return;

    const iframe = caja.querySelector<HTMLIFrameElement>("iframe");
    const cargando = caja.querySelector<HTMLElement>("[data-cargando]");
    if (!iframe) return;

    const montar = () => {
      if (!iframe.src) {
        iframe.src = iframe.dataset.src ?? "";
        iframe.hidden = false;
        iframe.addEventListener("load", () => {
          if (cargando) cargando.hidden = true;
        });
      }
      /* Al volver por View Transitions el script ya está en el DOM pero no
         se re-ejecuta: se reinserta para que vuelva a medir el iframe. */
      document.querySelector<HTMLScriptElement>(`script[src="${SRC}"]`)?.remove();
      const s = document.createElement("script");
      s.src = SRC;
      s.type = "text/javascript";
      document.body.appendChild(s);
    };

    if (!("IntersectionObserver" in window)) {
      montar();
      return;
    }

    const obs = new IntersectionObserver(
      (entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          obs.disconnect();
          montar();
        }
      },
      // Se adelanta media pantalla: cuando llega, ya está cargado.
      { rootMargin: "600px 0px" }
    );
    obs.observe(caja);
  }

  montarAgendaIntegra();
  document.addEventListener("astro:page-load", montarAgendaIntegra);
</script>
