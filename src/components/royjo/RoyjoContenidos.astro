---
/* =====================================================================
   CONTENIDOS POTENCIALES — los ocho ejes
   ---------------------------------------------------------------------
   Acordeón, no grilla: son ocho ejes con listas de seis a nueve ítems, y
   desplegados de una vez tapaban el resto de la propuesta. El primero
   abre por defecto para que se vea qué hay adentro sin tener que tocar.

   Es `<details>` nativo, sin `name`: acá conviene poder abrir varios a la
   vez —se comparan ejes entre sí— al revés de las preguntas frecuentes
   del Método INTEGRA, donde el acordeón es excluyente.
   ===================================================================== */
import Icon from "../Icon.astro";
import { royjo } from "../../data/royjo";
const { contenidos } = royjo;
---

<section class="section i-oscuro cnt" aria-label="Contenidos potenciales">
  <div class="cnt__fondo" aria-hidden="true"><span class="trama"></span></div>

  <div class="container cnt__inner">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{contenidos.eyebrow}</span>
      <h2 class="t-h2">{contenidos.titulo}</h2>
      <p class="text-muted">{contenidos.subtitulo}</p>
    </header>

    <div class="cnt__lista i-reveal">
      {
        contenidos.ejes.map((e, i) => (
          <details class="eje" open={i === 0}>
            <summary>
              <span class="eje__icono" aria-hidden="true">
                <Icon name={e.icono} size={19} />
              </span>
              <span class="eje__t">{e.titulo}</span>
              <span class="eje__signo" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="eje__cuerpo">
              {"subtitulo" in e && e.subtitulo && <p class="eje__sub">{e.subtitulo}</p>}
              <ul class="eje__items">
                {e.items.map((it) => (
                  <li>
                    <span class="eje__punto" aria-hidden="true" />
                    <span>{it}</span>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cnt {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #0a1430 0%, #0d1b3d 50%, #0a1430 100%);
  }
  .cnt__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .cnt__fondo span {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    -webkit-mask-image: radial-gradient(70% 60% at 20% 15%, #000, transparent 70%);
    mask-image: radial-gradient(70% 60% at 20% 15%, #000, transparent 70%);
  }
  .cnt__inner {
    position: relative;
  }

  .cnt__lista {
    max-width: 900px;
    margin-inline: auto;
    display: grid;
    gap: 0.65rem;
  }
  .eje {
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color var(--transition), background var(--transition);
  }
  .eje[open] {
    border-color: rgba(169, 200, 245, 0.42);
    background: rgba(255, 255, 255, 0.08);
  }
  .eje summary {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }
  .eje summary::-webkit-details-marker {
    display: none;
  }
  .eje__icono {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: rgba(169, 200, 245, 0.13);
    border: 1px solid rgba(169, 200, 245, 0.24);
    color: var(--i-celeste);
    transition: background var(--transition), color var(--transition);
  }
  .eje__t {
    flex: 1;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1rem;
    line-height: 1.3;
    color: #fff;
    transition: color var(--transition);
  }
  .eje[open] .eje__t {
    color: var(--i-celeste);
  }
  .eje:not([open]) summary:hover .eje__t {
    color: var(--i-celeste);
  }
  .eje__signo {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(169, 200, 245, 0.14);
    color: var(--i-celeste);
    transition: transform var(--transition), background var(--transition), color var(--transition);
  }
  .eje[open] .eje__signo {
    transform: rotate(45deg);
    background: var(--i-grad);
    color: #fff;
  }
  .eje[open] .eje__icono {
    background: rgba(169, 200, 245, 0.22);
  }

  .eje__cuerpo {
    /* Alineado con el texto del resumen, no con el ícono. */
    padding: 0 1.25rem 1.3rem calc(1.25rem + 36px + 0.9rem);
  }
  .eje__sub {
    margin-bottom: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(220, 230, 246, 0.62);
  }
  .eje__items {
    display: grid;
    gap: 0.5rem 1.75rem;
  }
  .eje__items li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.925rem;
    line-height: 1.5;
    color: rgba(220, 230, 246, 0.82);
  }
  .eje__punto {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    margin-top: 0.5rem;
    border-radius: 50%;
    background: var(--i-celeste);
  }

  @media (min-width: 700px) {
    .eje__items {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
