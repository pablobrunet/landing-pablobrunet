---
/* =====================================================================
   CIERRE + CALENDARIO · v2
   ---------------------------------------------------------------------
   Junta dos secciones de la v1 que pedían lo mismo una atrás de la otra:
   "Disponibilidad" y el cierre con el calendario. La escasez (pocas
   empresas a la vez) queda como una línea arriba del calendario.

   Un solo nombre para la reunión en toda la página y en todo el sitio:
   "Consultoría Estratégica Gratuita".

   El calendario se carga recién cuando la sección se acerca, para no
   penalizar la carga inicial.
   ===================================================================== */
import { integra } from "../../data/integra";
import { integra2 } from "../../data/integra2";
import { site } from "../../data/site";
const { cierre, anclas } = integra2;
const { calendarioId, fallbackTitulo, fallbackCta } = integra.cierre;

const src = `https://api.leadconnectorhq.com/widget/booking/${calendarioId}`;
const iframeId = `${calendarioId}_1786029066825`;
const wa = `https://wa.me/${site.whatsapp.numero}?text=${encodeURIComponent(integra.whatsapp.mensaje)}`;
---

<section class="section i-oscuro c2" id={anclas.agenda} aria-label="Agendar la Consultoría Estratégica Gratuita">
  <div class="c2__fondo" aria-hidden="true">
    <span class="c2__halo"></span>
    <span class="trama c2__trama"></span>
  </div>

  <div class="container c2__inner">
    <header class="c2__head i-reveal">
      <span class="i-eyebrow">{cierre.eyebrow}</span>
      <h2 class="t-h2 c2__titulo">{cierre.titulo}</h2>
      <p class="c2__sub">{cierre.subtitulo}</p>
      <ul class="c2__refuerzos">
        {
          cierre.refuerzos.map((r) => (
            <li>
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12l4 4 10-10" />
              </svg>
              {r}
            </li>
          ))
        }
      </ul>
      <p class="c2__cupos">{cierre.cupos}</p>
    </header>

    <div class="c2__cal i-reveal" data-agenda-integra2>
      <div class="c2__marco">
        <div class="c2__cargando" data-cargando>
          <span class="c2__spinner" aria-hidden="true"></span>
          Cargando el calendario…
        </div>
        <iframe
          data-src={src}
          id={iframeId}
          title="Calendario de la Consultoría Estratégica Gratuita — Programa INTEGRA"
          scrolling="no"
          hidden></iframe>
      </div>
      <noscript>
        <p class="c2__noscript">
          Para reservar necesitás JavaScript activado, o escribinos a
          <a href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
      </noscript>
    </div>

    <div class="c2__fallback i-reveal">
      <span>{fallbackTitulo}</span>
      <a href={wa} target="_blank" rel="noopener" class="c2__wa">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.966 1.164-.198.199-.396.223-.693.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.446.52-.669.174-.223.232-.383.347-.643.114-.26.057-.482-.024-.68-.081-.198-.669-1.611-.916-2.207-.245-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347M12.05 21.785h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884" />
        </svg>
        {fallbackCta}
      </a>
    </div>
  </div>
</section>

<style>
  .c2 {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #0a1430 0%, #0d1b3d 100%);
  }
  .c2__fondo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .c2__halo {
    position: absolute;
    top: -16rem;
    left: 50%;
    transform: translateX(-50%);
    width: 52rem;
    height: 40rem;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
    background: radial-gradient(circle, rgba(76, 134, 245, 0.6), transparent 70%);
  }
  .c2__trama {
    position: absolute;
    inset: 0;
    opacity: 0.3;
  }
  .c2__inner {
    position: relative;
  }
  .c2__head {
    max-width: 680px;
    margin: 0 auto clamp(1.75rem, 4vw, 2.5rem);
    text-align: center;
  }
  .c2__titulo {
    margin: 0.8rem 0 1rem;
  }
  .c2__sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgba(220, 230, 246, 0.8);
  }
  .c2__refuerzos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .c2__refuerzos li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(169, 200, 245, 0.1);
    border: 1px solid rgba(169, 200, 245, 0.26);
    font-size: 0.85rem;
    font-weight: var(--w-subheadline);
    color: var(--i-neblina);
  }
  .c2__cupos {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: rgba(220, 230, 246, 0.6);
  }

  .c2__marco {
    position: relative;
    min-height: 620px;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 30px 70px rgba(6, 12, 30, 0.5);
    overflow: hidden;
  }
  .c2__marco iframe {
    display: block;
    width: 100%;
    min-height: 620px;
    border: 0;
    overflow: hidden;
  }
  .c2__cargando {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.85rem;
    color: var(--texto-suave);
    font-size: 0.9rem;
  }
  .c2__spinner {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 3px solid var(--borde);
    border-top-color: var(--i-azul-600);
    animation: c2-giro 800ms linear infinite;
  }
  @keyframes c2-giro {
    to {
      transform: rotate(360deg);
    }
  }
  .c2__noscript {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: rgba(220, 230, 246, 0.7);
  }
  .c2__noscript a {
    color: var(--i-neblina);
  }
  .c2__fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    font-size: 0.9rem;
    color: rgba(220, 230, 246, 0.65);
  }
  .c2__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-btn);
    background: rgba(37, 211, 102, 0.14);
    border: 1px solid rgba(37, 211, 102, 0.4);
    color: #7ff0ad;
    font-weight: var(--w-subheadline);
    transition: background var(--transition);
  }
  .c2__wa:hover {
    background: rgba(37, 211, 102, 0.24);
  }
</style>

<script>
  const SRC = "https://link.msgsndr.com/js/form_embed.js";

  function montarAgendaIntegra2() {
    const caja = document.querySelector<HTMLElement>("[data-agenda-integra2]");
    if (!caja) return;
    const iframe = caja.querySelector<HTMLIFrameElement>("iframe");
    const cargando = caja.querySelector<HTMLElement>("[data-cargando]");
    if (!iframe) return;

    const montar = () => {
      if (!iframe.src) {
        iframe.src = iframe.dataset.src ?? "";
        iframe.hidden = false;
        iframe.addEventListener("load", () => {
          if (cargando) cargando.hidden = true;
        });
      }
      document.querySelector<HTMLScriptElement>(`script[src="${SRC}"]`)?.remove();
      const s = document.createElement("script");
      s.src = SRC;
      s.type = "text/javascript";
      document.body.appendChild(s);
    };

    if (!("IntersectionObserver" in window)) {
      montar();
      return;
    }
    const obs = new IntersectionObserver(
      (entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          obs.disconnect();
          montar();
        }
      },
      { rootMargin: "600px 0px" }
    );
    obs.observe(caja);
  }

  montarAgendaIntegra2();
  document.addEventListener("astro:page-load", montarAgendaIntegra2);
</script>
