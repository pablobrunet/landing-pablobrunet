---
/* =====================================================================
   QUÉ PASA ENTRE ENCUENTROS Y DESPUÉS
   ---------------------------------------------------------------------
   Los tres mecanismos que evitan que el aprendizaje quede atrapado en la
   jornada presencial, en una sola sección porque responden la misma
   objeción ("¿y después?"):

     · el ciclo entre encuentros — arriba, a todo el ancho, porque es lo
       que le toca hacer al participante
     · la plataforma asincrónica  — abajo a la izquierda
     · la biblioteca interna      — abajo a la derecha

   El ciclo se dibuja como una cadena de cinco pasos con flechas: es
   "Aprender → aplicar → compartir → mejorar → incorporar", y en lista
   vertical se perdía justamente el encadenamiento.
   ===================================================================== */
import Icon from "../Icon.astro";
import { royjo } from "../../data/royjo";
const { continuidad } = royjo;
const { ciclo, plataforma, practicas } = continuidad;
---

<section class="section i-claro cont" aria-label="Continuidad del aprendizaje">
  <div class="container">
    <header class="i-head i-head--centro i-reveal">
      <span class="i-eyebrow">{continuidad.eyebrow}</span>
      <h2 class="t-h2">
        {continuidad.titulo} <span class="i-hl">{continuidad.tituloResalte}</span>
      </h2>
      <p class="text-muted">{continuidad.subtitulo}</p>
    </header>

    {/* ---- El ciclo entre encuentros ---- */}
    <div class="ciclo i-reveal">
      <div class="ciclo__copy">
        <h3 class="ciclo__t">{ciclo.titulo}</h3>
        <p class="ciclo__p">{ciclo.texto}</p>
        <ul class="ciclo__detalle">
          {
            ciclo.detalle.map((d, i) => (
              <li>
                <span class="ciclo__n" aria-hidden="true">{i + 1}</span>
                <span>{d}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="ciclo__pasos">
        <span class="ciclo__pasos-t">{ciclo.pasosTitulo}</span>
        <ol class="ciclo__cadena">
          {
            ciclo.pasos.map((p) => (
              <li>
                <span class="ciclo__paso">{p}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    {/* ---- Plataforma + biblioteca interna ---- */}
    <div class="cont__grid">
      <article class="bloque i-reveal">
        <span class="bloque__icono" aria-hidden="true">
          <Icon name={plataforma.icono} size={22} />
        </span>
        <h3 class="bloque__t">{plataforma.titulo}</h3>
        <p class="bloque__p">{plataforma.texto}</p>
        <ul class="bloque__items">
          {plataforma.items.map((it) => <li>{it}</li>)}
        </ul>
        <p class="bloque__acceso">
          <Icon name="clock" size={16} />
          {plataforma.acceso}
        </p>
        <p class="bloque__remate">{plataforma.remate}</p>
      </article>

      <article class="bloque i-reveal">
        <span class="bloque__icono" aria-hidden="true">
          <Icon name={practicas.icono} size={22} />
        </span>
        <h3 class="bloque__t">{practicas.titulo}</h3>
        <p class="bloque__p">{practicas.texto}</p>
        <ul class="bloque__items">
          {practicas.items.map((it) => <li>{it}</li>)}
        </ul>
        <p class="bloque__remate">{practicas.remate}</p>
      </article>
    </div>
  </div>
</section>

<style>
  /* ---- El ciclo ---- */
  .ciclo {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 2.25rem);
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: linear-gradient(140deg, var(--i-hielo-2), #fff 55%);
    border: 1px solid var(--borde);
    box-shadow: var(--shadow-sm);
  }
  .ciclo__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.35rem);
    color: var(--azul-petroleo);
  }
  .ciclo__p {
    margin-top: 0.7rem;
    font-size: 0.975rem;
    line-height: 1.65;
    color: var(--azul-pizarra);
  }
  .ciclo__detalle {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.25rem;
  }
  .ciclo__detalle li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.925rem;
    line-height: 1.5;
    color: var(--azul-pizarra);
  }
  .ciclo__n {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(30, 92, 242, 0.1);
    color: var(--verde-resalte);
    font-size: 0.72rem;
    font-weight: var(--w-headline);
  }

  .ciclo__pasos {
    align-self: center;
  }
  .ciclo__pasos-t {
    display: block;
    margin-bottom: 0.9rem;
    font-size: 0.7rem;
    font-weight: var(--w-headline);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--verde-resalte);
  }
  /* Cadena con flechas entre pasos. La flecha la dibuja el ::after del
     paso anterior, así que el último queda sin flecha sin necesidad de
     una clase aparte. */
  .ciclo__cadena {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    list-style: none;
  }
  .ciclo__cadena li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .ciclo__cadena li:not(:last-child)::after {
    content: "";
    width: 14px;
    height: 8px;
    background: var(--i-azul-500);
    /* Punta de flecha: un triángulo recortado sobre el bloque de color. */
    clip-path: polygon(0 40%, 60% 40%, 60% 0, 100% 50%, 60% 100%, 60% 60%, 0 60%);
  }
  .ciclo__paso {
    display: inline-block;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    background: var(--i-grad);
    color: #fff;
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 0.9rem;
    box-shadow: 0 8px 20px rgba(23, 64, 143, 0.22);
  }

  /* ---- Plataforma y biblioteca ---- */
  .cont__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 1.75rem);
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    align-items: stretch;
  }
  .bloque {
    display: flex;
    flex-direction: column;
    padding: clamp(1.4rem, 3vw, 1.9rem);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--borde);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition), box-shadow var(--transition);
  }
  .bloque:hover {
    border-color: var(--i-azul-500);
    box-shadow: var(--shadow);
  }
  .bloque__icono {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 1rem;
    border-radius: 13px;
    background: var(--i-hielo);
    border: 1px solid var(--borde);
    color: var(--i-azul-600);
  }
  .bloque__t {
    font-family: var(--font-title);
    font-weight: var(--w-headline);
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--azul-petroleo);
  }
  .bloque__p {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--azul-pizarra);
  }
  .bloque__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }
  .bloque__items li {
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--i-hielo);
    border: 1px solid var(--borde);
    font-size: 0.85rem;
    color: var(--azul-pizarra);
  }
  .bloque__acceso {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgba(30, 92, 242, 0.08);
    border: 1px solid rgba(30, 92, 242, 0.18);
    font-size: 0.875rem;
    font-weight: var(--w-subheadline);
    color: var(--verde-resalte);
  }
  .bloque__remate {
    /* `auto` empuja el remate al pie: las dos tarjetas tienen listas de
       distinto largo y sin esto las franjas quedaban desalineadas. */
    margin-top: auto;
    padding-top: 1.25rem;
    font-family: var(--font-title);
    font-weight: var(--w-subheadline);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--verde-resalte);
  }
  .bloque__remate::before {
    content: "";
    display: block;
    width: 100%;
    height: 1px;
    margin-bottom: 1.1rem;
    background: var(--borde);
  }

  @media (min-width: 900px) {
    .ciclo {
      grid-template-columns: 1.15fr 0.85fr;
    }
    .cont__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
